        function checkAppLicenseStatus() {
            try {
                // Check if user clicked 1-click activation link from Telegram Bot (?activate=CSD-XXXX)
                const urlParams = new URLSearchParams(window.location.search);
                const autoKey = urlParams.get('activate');
                if (autoKey && autoKey.toUpperCase().startsWith('CSD-')) {
                    const keyClean = autoKey.trim().toUpperCase();
                    const keyPlan = keyClean.includes('MONTH') ? 'monthly' : 'yearly';
                    const planText = keyPlan === 'monthly' ? 'កញ្ចប់ប្រចាំខែ ($4.99)' : 'កញ្ចប់ប្រចាំឆ្នាំ VIP ($19.99)';

                    const applyActivation = () => {
                        const activeLicense = {
                            key: keyClean,
                            plan: keyPlan,
                            isTrial: false,
                            activatedAt: new Date().toISOString(),
                            lastVerified: Date.now(),
                            user: 'លោកគ្រូ អ្នកគ្រូ CSD',
                            school: ''
                        };
                        localStorage.setItem('csd-active-license', JSON.stringify(activeLicense));
                        if (typeof currentUser !== 'undefined' && currentUser) {
                            currentUser.isPremium = true;
                            currentUser.licenseKey = keyClean;
                            currentUser.licensePlan = keyPlan;
                            currentUser.license = activeLicense;
                            localStorage.setItem('csd_user_license_' + currentUser.id, JSON.stringify(activeLicense));
                            if (typeof saveAccounts === 'function') saveAccounts();
                        }
                        window.history.replaceState({}, document.title, window.location.pathname);

                        const btn = document.getElementById('payment-header-btn');
                        if (btn) {
                            btn.className = "hdr-pill-btn pro-badge";
                            btn.innerHTML = `<span aria-hidden="true">💎</span><span class="khmer-text">Premium Member</span>`;
                            btn.title = `អាជ្ញាប័ណ្ណសកម្ម៖ ${keyClean} (${keyPlan})`;
                        }
                        updateVoiceProBadges();

                        // Show visual success notification banner
                        setTimeout(() => {
                            const alertDiv = document.createElement('div');
                            alertDiv.style.cssText = 'position:fixed;top:20px;left:50%;transform:translateX(-50%);z-index:999999;background:linear-gradient(135deg, #059669, #0d9488);color:#fff;padding:14px 24px;border-radius:18px;box-shadow:0 20px 40px rgba(0,0,0,0.35);display:flex;align-items:center;gap:14px;font-family:Inter, Kantumruy Pro, sans-serif;border:1px solid rgba(255,255,255,0.25);animation:fadeInDown 0.4s ease;';
                            alertDiv.innerHTML = `
                                <span style="font-size:26px;">🎉</span>
                                <div>
                                    <div style="font-weight:700;font-size:15px;letter-spacing:-0.2px;">បើកដំណើរការ Premium Member ជោគជ័យ!</div>
                                    <div style="font-size:12px;opacity:0.92;margin-top:2px;">លេខកូដ៖ <b>${keyClean}</b> • ${planText}</div>
                                </div>
                                <button onclick="this.parentElement.remove()" style="margin-left:12px;background:none;border:none;color:#fff;font-size:20px;cursor:pointer;opacity:0.8;">&times;</button>
                            `;
                            document.body.appendChild(alertDiv);
                            setTimeout(() => { if (alertDiv.parentElement) alertDiv.remove(); }, 6000);
                        }, 400);
                    };

                    fetch(csdApiBase() + '/api/check_license?key=' + encodeURIComponent(keyClean))
                        .then(r => r.json())
                        .then(d => {
                            if (d && d.status === 'active') {
                                applyActivation();
                            } else {
                                // disabled OR unknown/fake key -> stay on Normal Account
                                window.history.replaceState({}, document.title, window.location.pathname);
                                revertToNormalAccount();
                            }
                        })
                        .catch(() => {
                            // Cannot reach the license server -> do NOT grant Pro
                            window.history.replaceState({}, document.title, window.location.pathname);
                            alert('Cannot verify the Pro license right now (server unreachable). Please try the activation link again when the CSD bot server is running.');
                        });
                }

                const licRaw = localStorage.getItem('csd-active-license');
                if (licRaw) {
                    const lic = JSON.parse(licRaw);
                    const btn = document.getElementById('payment-header-btn');
                    if (btn && lic && lic.key) {
                        btn.className = "hdr-pill-btn pro-badge";
                        btn.innerHTML = `<span aria-hidden="true">💎</span><span class="khmer-text">${lic.isTrial ? 'Trial 7 ថ្ងៃ' : 'Premium Member'}</span>`;
                        btn.title = `អាជ្ញាប័ណ្ណសកម្ម៖ ${lic.key} (${lic.plan})`;
                    }
                    // Verify with bot server if key was disabled by Admin
                    verifyActiveLicenseWithServer();
                }

                updateVoiceProBadges();

                // Periodic check every 6s to detect Admin revocation live
                if (!window._licenseCheckInterval) {
                    window._licenseCheckInterval = setInterval(verifyActiveLicenseWithServer, 6000);
                }
            } catch (e) {}
        }

