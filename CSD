let aiRecognition = null;
let aiIsListening = false;

function toggleAIVoicePrompt() {
  const micBtn = $('btn-ai-mic');
  const promptInput = $('ai-prompt-input');

  if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
    alert('កម្មវិធីរុករករបស់អ្នក (Browser) មិនទាន់គាំទ្រ Speech Recognition ទេ។ សូមប្រើ Google Chrome ឬ Microsoft Edge។');
    return;
  }

  if (aiIsListening && aiRecognition) {
    aiRecognition.stop();
    return;
  }

  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  aiRecognition = new SR();
  aiRecognition.lang = 'km-KH';
  aiRecognition.interimResults = true;
  aiRecognition.continuous = false;

  aiRecognition.onstart = function() {
    aiIsListening = true;
    if (micBtn) micBtn.classList.add('active');
  };

  aiRecognition.onresult = function(event) {
    let interim = '';
    let final = '';
    for (let i = event.resultIndex; i < event.results.length; ++i) {
      if (event.results[i].isFinal) {
        final += event.results[i][0].transcript;
      } else {
        interim += event.results[i][0].transcript;
      }
    }
    if (promptInput) {
      if (final) {
        promptInput.value = (promptInput.value ? promptInput.value + ' ' : '') + final;
      }
    }
  };

  aiRecognition.onerror = function(e) {
    console.warn('Speech recognition error:', e.error);
    aiIsListening = false;
    if (micBtn) micBtn.classList.remove('active');
  };

  aiRecognition.onend = function() {
    aiIsListening = false;
    if (micBtn) micBtn.classList.remove('active');
  };

  aiRecognition.start();
}

