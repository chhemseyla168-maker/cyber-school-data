        // ---- Voice input (Khmer speech recognition) ----
        document.addEventListener('focusin', e => {
            const id = e.target && e.target.id;
            if (id && id.indexOf('sf-') === 0 && SF_FIELDS.includes(id.slice(3))) sfActive = id.slice(3);
        });

        const SF_SEQ = SF_FIELDS.filter(k => k !== 'status');   // order used when no keyword is spoken
        let sfSeqIdx = 0, sfAuto = false, sfAutoRec = null, sfAutoFails = 0;
        const SF_SR = () => window.SpeechRecognition || window.webkitSpeechRecognition;

        function sfFlash(key) {
            const f = sfEl(key); if (!f) return;
            f.classList.remove('sf-flash'); void f.offsetWidth; f.classList.add('sf-flash');
        }
        function sfShowNext() {
            document.querySelectorAll('#screen-attendance .sf-next').forEach(x => x.classList.remove('sf-next'));
            if (!sfAuto) return;
            const f = sfEl(SF_SEQ[sfSeqIdx]);
            if (f && f.closest('.sf-field')) f.closest('.sf-field').classList.add('sf-next');
        }

        // Writes one spoken value into a field, converted for the field type. Returns true when accepted.
        function sfSet(key, heard) {
            const el = sfEl(key);
            heard = String(heard || '').replace(/^[\s:៖,។-]*(?:គឺ)?\s*/, '').replace(/[\s,។]+$/, '');
            if (!el || !heard) return false;
            let val = '';
            if (key === 'gender') {
                val = /ស្រី|female|girl/i.test(heard) ? 'ស' : /ប្រុស|male|boy/i.test(heard) ? 'ប' : '';
                if (!val) return false;
            } else if (key === 'dob') {
                val = sfNormDob(heard);
                if (!val) { el.value = sfDigits(heard); sfUpdateAge(); return false; }
            } else if (key === 'sid') {
                val = sfDigits(heard).replace(/\s+/g, '');
            } else if (SF_NO_SPACE.includes(key)) {
                val = normalizeVoiceText(heard);
            } else {
                val = heard.replace(/\s+/g, ' ');
            }
            el.value = val;
            el.dispatchEvent(new Event('input', { bubbles: true }));
            sfUpdateAge();
            sfFlash(key);
            return true;
        }

        // ---- Spoken keywords -> fields ----
        const SF_KEYS = [
            ['birthPlace', ['ទីកន្លែងកំណើត', 'ទីកន្លែងកើត', 'កន្លែងកំណើត']],
            ['dob', ['ថ្ងៃខែឆ្នាំកំណើត', 'ថ្ងៃខែកំណើត', 'ថ្ងៃកំណើត', 'ថ្ងៃកើត']],
            ['address', ['ទីលំនៅបច្ចុប្បន្ន', 'ទីលំនៅ', 'អាសយដ្ឋាន']],
            ['village', ['ភូមិបច្ចុប្បន្ន']],
            ['fatherJob', ['មុខរបរឪពុក', 'មុខរបរឳពុក']],
            ['motherJob', ['មុខរបរម្តាយ']],
            ['job', ['មុខរបរ']],
            ['father', ['ឈ្មោះឪពុក', 'ឈ្មោះឳពុក', 'ឪពុក', 'ឳពុក']],
            ['mother', ['ឈ្មោះម្តាយ', 'ម្តាយ']],
            ['lastname', ['គោត្តនាម', 'គោតនាម', 'ត្រកូល']],
            ['firstname', ['នាមខ្លួន', 'នាម']],
            ['fullname', ['ឈ្មោះសិស្ស', 'ឈ្មោះ']],
            ['sid', ['អត្តលេខ', 'លេខសិស្ស']],
            ['gender', ['ភេទ']],
            ['status', ['ជាសិស្ស', 'ស្ថានភាពសិស្ស']]
        ];
        const SF_RISKY = ['នាម', 'ឈ្មោះ', 'ឪពុក', 'ឳពុក', 'ម្តាយ', 'ត្រកូល'];   // must not sit inside another Khmer word
        const SF_KW = (() => {
            const list = [];
            SF_KEYS.forEach(([key, words]) => words.forEach(w => list.push({ key, w })));
            list.sort((a, b) => b.w.length - a.w.length);
            const src = list.map(({ w }) => {
                const body = w.replace(/្ត/g, '\u0001').split('').map(c => c === '\u0001' ? '(?:្ត|្ដ)' : c).join('\\s*');
                return (SF_RISKY.includes(w) ? '(?<![\\u1780-\\u17FF])' : '') + '(' + body + ')';
            }).join('|');
            return { re: new RegExp(src, 'g'), list };
        })();
        let sfParent = null;   // 'father' | 'mother' — who an un-labelled "មុខរបរ" belongs to

        function sfParseAuto(text) {
            const hits = [];
            const re = new RegExp(SF_KW.re.source, 'g');
            let m;
            while ((m = re.exec(text)) !== null) {
                let gi = 1; while (gi < m.length && m[gi] === undefined) gi++;
                hits.push({ idx: m.index, end: re.lastIndex, key: SF_KW.list[gi - 1].key });
                if (m[0].length === 0) re.lastIndex++;
            }
            const lead = hits.length ? text.slice(0, hits[0].idx).trim() : text.trim();
            const items = hits.map((h, i) => ({ key: h.key, val: text.slice(h.end, i + 1 < hits.length ? hits[i + 1].idx : text.length).trim() }));
            return { lead, items };
        }

        function sfHandleAuto(raw) {
            let text = String(raw || '').trim();
            if (!text) return;
            document.getElementById('sf-transcript').innerText = `"${text}"`;
            let cmd = null;
            const cm = /(រក្សាទុក|សិស្សបន្ទាប់|បន្ទាប់|បញ្ឈប់|ឈប់)\s*$/.exec(text);
            if (cm) { cmd = cm[1]; text = text.slice(0, cm.index).trim(); }

            const { lead, items } = sfParseAuto(text);
            const done = [];
            const put = (key, val) => { if (sfSet(key, val)) done.push(SF_LABELS[key]); sfSeqIdx = SF_SEQ.indexOf(key) + 1; };

            if (lead) {
                const key = SF_SEQ[sfSeqIdx];
                if (key) put(key, lead);
            }
            items.forEach(it => {
                let key = it.key;
                if (key === 'father' || key === 'mother') sfParent = key;
                if (key === 'job') key = sfParent === 'mother' ? 'motherJob' : 'fatherJob';
                if (key === 'fatherJob') sfParent = 'father';
                if (key === 'motherJob') sfParent = 'mother';
                if (key === 'fullname') {
                    const parts = it.val.replace(/^[\s:៖,។-]*(?:គឺ)?\s*/, '').split(/\s+/).filter(Boolean);
                    if (parts.length >= 2) { sfSet('lastname', parts[0]) && done.push(SF_LABELS.lastname); put('firstname', parts.slice(1).join('')); }
                    else if (parts.length === 1) put('lastname', parts[0]);
                    return;
                }
                put(key, it.val);
            });

            if (done.length) sfVoiceStatus('✅ បានបំពេញ៖ ' + done.join(' • '));
            else if (!cmd) sfVoiceStatus('⚠️ ស្តាប់មិនបានច្បាស់ ឬមិនស្គាល់ពាក្យគន្លឹះ សូមនិយាយម្តងទៀត');

            if (cmd === 'រក្សាទុក') { sfSave(); }
            else if (cmd === 'សិស្សបន្ទាប់' || cmd === 'បន្ទាប់') { if (sfSave()) { sfNew(true); sfParent = null; sfVoiceStatus('✅ បានរក្សាទុក — បន្តនិយាយព័ត៌មានសិស្សបន្ទាប់'); } }
            else if (cmd) { sfAutoStop(); return; }
            sfShowNext();
        }

        function sfUiListening(on) {
            const mb = document.getElementById('sf-main-mic');
            if (mb) mb.classList.toggle('on', on);
            if (!on) document.querySelectorAll('#screen-attendance .sf-mic.on').forEach(b => b.classList.remove('on'));
            sfShowNext();
        }
        function sfMainMic() { 
            if (!isProUser()) {
                showProVoiceModal();
                return;
            }
            if (sfAuto) sfAutoStop(); else sfAutoStart(); 
        }
        function sfAutoStart() {
            if (!isProUser()) {
                showProVoiceModal();
                return;
            }
            if (!SF_SR()) { alert('កម្មវិធីរុករករបស់អ្នក (Browser) មិនគាំទ្រប្រព័ន្ធសំឡេង Speech Recognition ទេ។'); return; }
            if (sfListening && sfRec) { try { sfRec.stop(); } catch (e) {} }
            sfAuto = true; sfAutoFails = 0; sfParent = null;
            const first = SF_SEQ.findIndex(k => k !== 'gender' && !sfEl(k).value);
            sfSeqIdx = first < 0 ? 0 : first;
            sfUiListening(true);
            sfVoiceStatus('🎤 កំពុងស្តាប់ស្វ័យប្រវត្តិ... សូមនិយាយព័ត៌មានសិស្ស (ចុចម្តងទៀតដើម្បីបញ្ឈប់)');
            sfAutoListen();
        }
        function sfAutoListen() {
            if (!sfAuto) return;
            if (!isProUser()) { sfAutoStop(); showProVoiceModal(); return; }
            const rec = new (SF_SR())();
            sfAutoRec = rec;
            rec.lang = 'km-KH'; rec.continuous = true; rec.interimResults = false; rec.maxAlternatives = 1;
            let gotAny = false;
            const t0 = Date.now();
            rec.onresult = ev => {
                if (!isProUser()) { sfAutoStop(); showProVoiceModal(); return; }
                for (let i = ev.resultIndex; i < ev.results.length; i++) {
                    if (ev.results[i].isFinal) { gotAny = true; sfAutoFails = 0; sfHandleAuto(ev.results[i][0].transcript); }
                }
            };
            rec.onerror = ev => {
                if (ev.error === 'not-allowed' || ev.error === 'service-not-allowed') {
                    sfAuto = false; sfUiListening(false);
                    sfVoiceStatus('❌ មិនអនុញ្ញាតឱ្យប្រើមីក្រូហ្វូន សូមអនុញ្ញាតក្នុង Browser');
                } else if (ev.error !== 'no-speech' && ev.error !== 'aborted') {
                    sfVoiceStatus(`❌ មានបញ្ហាសំឡេង (${ev.error})`);
                }
            };
            rec.onend = () => {
                if (!sfAuto) { sfUiListening(false); return; }
                if (!gotAny && Date.now() - t0 < 1500 && ++sfAutoFails >= 5) {   // engine keeps dying: give up
                    sfAuto = false; sfUiListening(false);
                    sfVoiceStatus('❌ ប្រព័ន្ធសំឡេងបញ្ឈប់ដោយខ្លួនឯង សូមចុចមីក្រូហ្វូនម្តងទៀត');
                    return;
                }
                setTimeout(sfAutoListen, 250);   // browsers end continuous sessions after silence: restart
            };
            try { rec.start(); } catch (e) {}
        }
        function sfAutoStop() {
            sfAuto = false;
            try { sfAutoRec && sfAutoRec.stop(); } catch (e) {}
            sfUiListening(false);
            sfVoiceStatus('បានបញ្ឈប់ការស្តាប់ — ចុចមីក្រូហ្វូនដើម្បីបន្ត');
        }

        // ---- Single field mic (🎤 beside each box) ----
        function sfMarkMic(key, on) {
            document.querySelectorAll('#screen-attendance .sf-mic.on').forEach(b => b.classList.remove('on'));
            if (!on) return;
            const field = sfEl(key);
            const btn = field && field.parentElement.querySelector('.sf-mic');
            if (btn) btn.classList.add('on');
        }
        function sfStartVoice(key) {
            if (!isProUser()) {
                showProVoiceModal();
                return;
            }
            if (!SF_SR()) { alert('កម្មវិធីរុករករបស់អ្នក (Browser) មិនគាំទ្រប្រព័ន្ធសំឡេង Speech Recognition ទេ។'); return; }
            if (sfAuto) sfAutoStop();
            if (sfListening && sfRec) { sfRec.stop(); return; }
            const rec = new (SF_SR())();
            sfRec = rec;
            rec.lang = 'km-KH'; rec.interimResults = false; rec.maxAlternatives = 1;
            let got = false;
            sfVoiceStatus(`🎤 កំពុងស្តាប់សំឡេង... សូមនិយាយ "${SF_LABELS[key]}"`);
            rec.onstart = () => { sfListening = true; sfMarkMic(key, true); };
            rec.onresult = ev => { got = true; if (!isProUser()) { showProVoiceModal(); return; } sfApplyVoice(key, ev.results[0][0].transcript); };
            rec.onerror = ev => { got = true; sfVoiceStatus(`❌ មានបញ្ហាសំឡេង (${ev.error}) សូមព្យាយាមម្តងទៀត`); };
            rec.onend = () => {
                sfListening = false; sfMarkMic(key, false);
                if (!got) sfVoiceStatus('មិនបានស្តាប់ឮអ្វីទេ សូមចុចមីក្រូហ្វូន ហើយនិយាយម្តងទៀត');
            };
            rec.start();
        }
        function sfApplyVoice(key, raw) {
            const heard = String(raw || '').trim();
            document.getElementById('sf-transcript').innerText = `"${heard}"`;
            if (sfSet(key, heard)) return sfVoiceStatus(`✅ បានបំពេញ "${SF_LABELS[key]}" ← ${sfEl(key).value}`);
            if (key === 'gender') sfVoiceStatus('⚠️ សូមនិយាយ "ស្រី" ឬ "ប្រុស"');
            else if (key === 'dob') sfVoiceStatus('⚠️ សូមនិយាយ ថ្ងៃ ខែ ឆ្នាំ (ឧ៖ "១៩ កញ្ញា ២០១៦" ឬ "១៩ ០៩ ២០១៦") ឬកែដោយដៃ');
            else sfVoiceStatus('⚠️ ស្តាប់មិនបានច្បាស់ សូមនិយាយម្តងទៀត');
        }

