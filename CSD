            const { error } = await client.from('csd_teacher_data').upsert(dataToSync);
            if (!error) {
                syncStatus = 'connected';
                hasPendingChanges = false;
                updateSyncUI();
                updateSaveBadge('', 'cloud');
            } else {
                console.error('csdSyncTeacherDataToCloud DB error:', error);
                syncStatus = 'error';
                updateSyncUI();
            }
        } catch (e) {
            console.error('csdSyncTeacherDataToCloud error:', e);
            syncStatus = 'error';
            updateSyncUI();
        }
    };

    // 4. Pull Teacher Data from Cloud when opening on a new device
    window.csdPullTeacherDataFromCloud = async function (teacherId) {
        if (!client || !teacherId) return false;
        try {
            const { data, error } = await client
                .from('csd_teacher_data')
                .select('*')
                .eq('teacher_id', teacherId)
                .maybeSingle();

            if (data && !error) {
                const cloudSavedAt = Number(data.saved_at || 0);
                const localKey = 'khmer-data-v1:' + teacherId;
                let localSaved = null;
                try { localSaved = JSON.parse(localStorage.getItem(localKey) || 'null'); } catch (e) {}
                const localSavedAt = Number((localSaved && localSaved.savedAt) || 0);

                // If cloud has newer data, restore it into local memory & localStorage
                if (cloudSavedAt > localSavedAt || !localSaved) {
                    const payload = {
                        v: 1,
                        students: data.students || [],
                        gradesData: data.grades_data || {},
                        semesterExamData: data.semester_data || { 1: {}, 2: {} },
                        savedAt: cloudSavedAt
                    };
                    localStorage.setItem(localKey, JSON.stringify(payload));

                    // If this is the currently active teacher, reload memory
                    if (typeof window.loadTeacherData === 'function') {
                        window.loadTeacherData(teacherId);
                    }
                    console.log('✅ Auto-restored newer data from Supabase Cloud!');
                    updateSaveBadge('', 'cloud');
                    return true;
                }
            }
        } catch (e) {
            console.error('csdPullTeacherDataFromCloud error:', e);
        }
        return false;
    };

    // =========================================================================
    // INTELLIGENT DEBOUNCED AUTO-SAVE SCHEDULER
    // =========================================================================
    window.scheduleAutoCloudSync = function (options) {
        hasPendingChanges = true;
        updateSaveBadge('', 'saving');

        // Clear previous timer to debounce rapid keystrokes/score entries
        if (autoSyncTimer) {
            clearTimeout(autoSyncTimer);
        }

        // Wait 1.0 second after last user edit, then automatically save to Cloud
        autoSyncTimer = setTimeout(async function () {
            await window.flushAutoSaveNow(options);
        }, 1000);
    };

    // Flush Auto-Save immediately (without debounce delay)
    window.flushAutoSaveNow = async function (options) {
        options = options || {};
        if (autoSyncTimer) {
            clearTimeout(autoSyncTimer);
            autoSyncTimer = null;
        }

        // Always save locally first (0ms latency guarantee)
        if (typeof window.rawPersistAll === 'function') {
            window.rawPersistAll();
        }

        // If Supabase is connected, auto-sync to Cloud
        if (client) {
            syncStatus = 'syncing';
            updateSyncUI();
            try {
                const curUser = (typeof currentUser !== 'undefined') ? currentUser : null;
                if (curUser) {
                    if (options.syncAccounts) {
                        await window.csdSyncAccountToCloud(curUser);
                    }
                    if (curUser.teacherId) {
                        await window.csdSyncTeacherDataToCloud(curUser.teacherId);
                    }
                }
                syncStatus = 'connected';
                updateSyncUI();
                updateSaveBadge('', 'cloud');
            } catch (err) {
                console.error('Auto-Save cloud error:', err);
                syncStatus = 'error';
                updateSyncUI();
                updateSaveBadge('', 'local');
            }
        } else {
            // Offline/Unconfigured mode: local auto-save confirmed
            updateSaveBadge('', 'local');
        }
        hasPendingChanges = false;
    };

    // Full 2-Way Manual Sync (Triggered by Cloud Sync button)
    window.triggerFullCloudSync = async function () {
        if (!client) {
            window.openSupabaseConfigModal();
            return;
        }
        if (isSyncing) return;
        isSyncing = true;
        syncStatus = 'syncing';
        updateSyncUI();
        updateSaveBadge('', 'saving');

        try {
            if (typeof currentUser !== 'undefined' && currentUser) {
                await window.csdSyncAccountToCloud(currentUser);
                if (currentUser.teacherId) {
                    await window.csdPullTeacherDataFromCloud(currentUser.teacherId);
                    await window.csdSyncTeacherDataToCloud(currentUser.teacherId);
                }
            }
            syncStatus = 'connected';
            updateSaveBadge('', 'cloud');
        } catch (e) {
            console.error('triggerFullCloudSync error:', e);
            syncStatus = 'error';
            updateSaveBadge('', 'err');
        } finally {
            isSyncing = false;
            updateSyncUI();
        }
    };

    // =========================================================================
    // SAFETY AUTOMATIONS (Auto-save on tab blur, window close, periodic check)
    // =========================================================================

    // 1. Safety Periodic Auto-Save: Every 15 seconds
    setInterval(function () {
        if (hasPendingChanges && client) {
            window.flushAutoSaveNow();
        }
    }, 15000);

    // 2. Auto-Save on Tab Close / App Switch / Window Blur
    window.addEventListener('beforeunload', function () {
        if (hasPendingChanges) {
            window.flushAutoSaveNow();
        }
    });

    document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'hidden' && hasPendingChanges) {
            window.flushAutoSaveNow();
        }
    });

    // 3. Global Input Auto-Save Listener
    // Automatically detects ANY input or change across all tables/forms
    document.addEventListener('input', function (e) {
        const target = e.target;
        if (!target) return;
        // If it's a score input, student field, or class setting:
        if (target.matches('input[type="number"], .score-input, #inp-kl, #inp-kw, [id^="sf-"], [id^="ci-"], table input')) {
            window.scheduleAutoCloudSync();
        }
    }, true);

    document.addEventListener('change', function (e) {
        const target = e.target;
        if (!target) return;
        if (target.matches('select, [id^="sf-"], [id^="ci-"], table select, table input')) {
            window.scheduleAutoCloudSync();
        }
