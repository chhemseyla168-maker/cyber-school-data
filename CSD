            { key: 'social',       input: 'inp-soc',    label: 'សិក្សាសង្គម',   words: ['សិក្សាសង្គម', 'សង្គម', 'social'] },
            { key: 'health',       input: 'inp-health', label: 'សុខភាព',       words: ['សុខភាពអនាម័យ', 'សុខភាព', 'អនាម័យ', 'health', 'hygiene'] },
            { key: 'home_art',     input: 'inp-home',   label: 'គេហវិទ្យា-សិល្បៈ', words: ['គេហវិទ្យា', 'សិល្បៈ', 'home', 'art'] },
            { key: 'pe',           input: 'inp-pe',     label: 'អប់រំកាយ',      words: ['អប់រំកាយ', 'កីឡា', 'pe'] }
        ];
        const KH_DIGIT_MAP = { '០':'0','១':'1','២':'2','៣':'3','៤':'4','៥':'5','៦':'6','៧':'7','៨':'8','៩':'9' };
        const KH_NUM_WORDS = { 'សូន្យ':0,'មួយ':1,'ពីរ':2,'បី':3,'បួន':4,'ប្រាំមួយ':6,'ប្រាំពីរ':7,'ប្រាំបី':8,'ប្រាំបួន':9,'ប្រាំ':5,'ដប់':10 };
        const NUM_TOKEN = '\\d+|ប្រាំមួយ|ប្រាំពីរ|ប្រាំបី|ប្រាំបួន|ប្រាំ|សូន្យ|មួយ|ពីរ|បី|បួន|ដប់';

        function normalizeVoiceText(t) {
            return String(t || '').toLowerCase()
                .replace(/[០-៩]/g, d => KH_DIGIT_MAP[d])
                .replace(/្ដ/g, '្ត')                       // ដ/ត subscript variants
                .replace(/([\u1780-\u17FF])\s+(?=[\u1780-\u17FF])/g, '$1') // speech engines add spaces between Khmer words
                .replace(/(\d)\s*[,។]\s*(\d)/g, '$1.$2')
                .replace(/\s+/g, ' ').trim();
        }
        function tokenValue(tok) { return /^\d+$/.test(tok) ? parseInt(tok, 10) : KH_NUM_WORDS[tok]; }

        // Reads a score such as "8", "៨", "ប្រាំបី", "ប្រាំបីកន្លះ", "8.5", "ប្រាំបីចុចពីរប្រាំ"
        function parseScoreFrom(seg) {
            const m = new RegExp('(\\d+\\.\\d+)|(' + NUM_TOKEN + ')').exec(seg);
            if (!m) return NaN;
            if (m[1]) return parseFloat(m[1]);
            let val = tokenValue(m[2]);
            let rest = seg.slice(m.index + m[2].length);
            if (/^\s*(កន្លះ|ពាក់កណ្តាល|half)/.test(rest)) {
                val += 0.5;
            } else {
                const dec = /^\s*(ចុច|point|\.)\s*((?:\d|ប្រាំមួយ|ប្រាំពីរ|ប្រាំបី|ប្រាំបួន|ប្រាំ|សូន្យ|មួយ|ពីរ|បី|បួន|\s)+)/.exec(rest);
                if (dec) {
                    let digits = '';
                    const re = new RegExp('(' + NUM_TOKEN + ')', 'g');
                    let d; while ((d = re.exec(dec[2])) !== null) digits += String(tokenValue(d[1]) % 10);
                    if (digits) val = parseFloat(val + '.' + digits);
                }
            }
            return Math.min(10, Math.max(0, val));
        }

        // Finds every subject keyword, then reads the number that follows it
        function parseVoiceScores(rawText) {
            const text = normalizeVoiceText(rawText);
            const hits = [];
            VOICE_SUBJECTS.forEach(sub => {
                sub.words.forEach(w => {
                    const word = normalizeVoiceText(w);
                    let from = 0, idx;
                    while ((idx = text.indexOf(word, from)) !== -1) {
                        hits.push({ sub, start: idx, end: idx + word.length });
                        from = idx + word.length;
                    }
                });
            });
            // longest match wins when keywords overlap (e.g. គណិតវិទ្យា vs គណិត)
            hits.sort((a, b) => a.start - b.start || (b.end - b.start) - (a.end - a.start));
            const picked = [];
            hits.forEach(h => { if (!picked.length || h.start >= picked[picked.length - 1].end) picked.push(h); });

            const results = {};
            picked.forEach((h, i) => {
                const segEnd = i + 1 < picked.length ? picked[i + 1].start : text.length;
                const val = parseScoreFrom(text.slice(h.end, segEnd));
                if (!isNaN(val)) results[h.sub.key] = val;
            });
            return results;
        }

        // Writes parsed scores into the form and saves for the selected student/month/semester
        function applyVoiceScores(rawText) {
            const norm = normalizeVoiceText(rawText);
            // Auto switch semester if spoken
            if (/ឆមាស(ទី)?\s*(១|មួយ|1)/.test(norm)) {
                const sel = document.getElementById('select-ai-month');
                if (sel && sel.value !== 'sem_1') {
                    sel.value = 'sem_1';
                    loadStudentScoresIntoForm();
                }
            } else if (/ឆមាស(ទី)?\s*(២|ពីរ|2)/.test(norm)) {
                const sel = document.getElementById('select-ai-month');
                if (sel && sel.value !== 'sem_2') {
                    sel.value = 'sem_2';
                    loadStudentScoresIntoForm();
                }
