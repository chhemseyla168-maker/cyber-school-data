        title: u.title,
        subtitle: u.subtitle,
        duration: u.duration,
        source: u.source,
        obj1: u.obj1,
        obj2: u.obj2,
        obj3: u.obj3,
        matT: u.matT,
        matS: u.matS,
        steps: u.steps
      };
    }
  }

  // 2. Search across ALL grades (1 to 6) if not found in current grade
  for (let g = 1; g <= 6; g++) {
    const gUnits = (GRADE_CURRICULUM[g] && GRADE_CURRICULUM[g][subject]) || [];
