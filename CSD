        async function saveUserChanges(e) {
            e.preventDefault();
            const btn = document.getElementById('save-user-btn');
            btn.disabled = true;
            btn.innerHTML = '⏳ កំពុងរក្សាទុក...';

            try {
                const accId = document.getElementById('edit-acc-id').value;
                const teacherId = document.getElementById('edit-teacher-id').value;
                const newUsername = (document.getElementById('edit-username').value || '').trim();
                const newRole = document.getElementById('edit-role').value;
                const rawPhone = (document.getElementById('edit-phone').value || '').trim();
                const normalizedPhone = normPhone(rawPhone);
                const newPassword = (document.getElementById('edit-password').value || '').trim();
                const teacherName = (document.getElementById('edit-teacher-name').value || '').trim();
                const teacherSex = document.getElementById('edit-teacher-sex').value;
                const schoolName = (document.getElementById('edit-school').value || '').trim();
                const className = (document.getElementById('edit-class').value || '').trim();

                if (!newUsername) throw new Error('សូមបញ្ចូលឈ្មោះគណនី (Username)');
                if (!rawPhone || !normalizedPhone) throw new Error('សូមបញ្ចូលលេខទូរស័ព្ទត្រឹមត្រូវ');

                // Duplicate Check (Username)
                const dupUser = accounts.find(a => a.id !== accId && (a.username || '').toLowerCase() === newUsername.toLowerCase());
                if (dupUser) throw new Error(`ឈ្មោះ ${newUsername} នេះត្រូវបានប្រើរួចហើយ`);

                // Duplicate Check (Phone)
                const dupPhone = accounts.find(a => a.id !== accId && normPhone(a.phone) === normalizedPhone);
                if (dupPhone) throw new Error(`លេខទូរស័ព្ទ ${rawPhone} នេះត្រូវបានប្រើរួចហើយ`);

                const acc = accounts.find(a => a.id === accId);
                if (!acc) throw new Error('រកមិនឃើញគណនី');

                acc.username = newUsername;
                acc.phone = normalizedPhone;
                acc.role = newRole;
                acc.isAdmin = (newRole === 'admin');

                // Process Membership Plan & Trial Reset
                const selectedPlan = (document.getElementById('edit-membership-plan') ? document.getElementById('edit-membership-plan').value : 'free');
                const resetTrialChecked = document.getElementById('edit-reset-trial') ? document.getElementById('edit-reset-trial').checked : false;
                const now = Date.now();
                const SEVEN_DAYS = 7 * 24 * 60 * 60 * 1000;

                if (resetTrialChecked) {
                    acc.trialUsed = false;
                    acc.trialStartedAt = null;
                    acc.trialExpiresAt = null;
                }

                if (acc.isAdmin || acc.role === 'admin' || isAccountAdmin(acc)) {
                    // Admin accounts are unconditionally full Premium VIP
                    acc.isPremium = true;
                    acc.premiumPlan = 'admin';
                    const adminLic = { key: 'CSD-ADMIN-ROOT', plan: 'admin', isTrial: false, lastVerified: now, user: acc.username, userId: acc.id };
                    acc.license = adminLic;
                    localStorage.setItem('csd_user_license_' + acc.id, JSON.stringify(adminLic));
                } else if (selectedPlan === 'yearly' || selectedPlan === 'monthly') {
                    acc.isPremium = true;
                    acc.premiumPlan = selectedPlan;
                    acc.licenseKey = acc.licenseKey || `CSD-${selectedPlan.toUpperCase()}-${Math.random().toString(36).substring(2,6).toUpperCase()}-2026`;
                    const lic = { key: acc.licenseKey, plan: selectedPlan, isTrial: false, lastVerified: now, user: acc.username, userId: acc.id };
                    acc.license = lic;
                    localStorage.setItem('csd_user_license_' + acc.id, JSON.stringify(lic));
                } else if (selectedPlan === 'trial') {
                    acc.isPremium = false;
                    acc.trialUsed = true;
                    acc.trialStartedAt = now;
                    acc.trialExpiresAt = now + SEVEN_DAYS;
                    const lic = { key: `CSD-TRIAL-${acc.username.toUpperCase()}-2026`, plan: 'trial', isTrial: true, startedAt: now, expiresAt: now + SEVEN_DAYS, lastVerified: now, user: acc.username, userId: acc.id };
                    acc.license = lic;
                    localStorage.setItem('csd_user_license_' + acc.id, JSON.stringify(lic));
                } else if (selectedPlan === 'free') {
                    acc.isPremium = false;
                    acc.trialStartedAt = null;
                    acc.trialExpiresAt = null;
                    localStorage.removeItem('csd_user_license_' + acc.id);
                }

                // If this is current user session, sync csd-active-license
                let activeAccId = null;
                try { activeAccId = sessionStorage.getItem('csd-session') || localStorage.getItem('csd-session'); } catch (e) {}
                if (activeAccId && (activeAccId === acc.id || activeAccId.includes(acc.id))) {
                    if (acc.isPremium || isAccountAdmin(acc) || (acc.trialStartedAt && (now - acc.trialStartedAt < SEVEN_DAYS))) {
                        localStorage.setItem('csd-active-license', JSON.stringify(acc.license || { key: 'CSD-ACTIVE', plan: acc.premiumPlan || 'yearly' }));
                    } else {
                        localStorage.removeItem('csd-active-license');
                    }
                }

                // Update Password if provided
                if (newPassword) {
                    if (newPassword.length < 6) throw new Error('លេខសម្ងាត់ត្រូវមានយ៉ាងតិច ៦ ខ្ទង់');
                    const cred = await makeCred(newPassword);
                    acc.salt = cred.salt;
                    acc.alg = cred.alg;
                    acc.hash = cred.hash;
                }

                // Update Teacher Profile
                let t = teachers.find(x => x.id === teacherId);
                if (!t) {
                    t = { id: teacherId, name: teacherName || newUsername, sex: teacherSex, school: schoolName, className: className };
                    teachers.push(t);
                } else {
                    t.name = teacherName || newUsername;
                    t.sex = teacherSex;
                    t.school = schoolName;
                    t.className = className;
                }

                // Add to extra classes if new
                if (className && !extraClasses.includes(className)) {
                    extraClasses.push(className);
                }

                saveData();

                // Trigger Supabase Cloud Sync
                if (typeof window.csdSyncAccountToCloud === 'function') {
                    await window.csdSyncAccountToCloud(acc);
                }

                closeEditModal();
                loadData();
                showToast('✅ បានកែប្រែព័ត៌មានអ្នកប្រើដោយជោគជ័យ!', 'success');

            } catch (err) {
                showToast(err.message || 'បរាជ័យក្នុងការរក្សាទុក', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '💾 រក្សាទុកការកែប្រែ';
            }
        }

