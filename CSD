        plan_name = "កញ្ចប់ប្រចាំខែ ($4.99/ខែ)" if "MONTH" in plan.upper() else "កញ្ចប់ប្រចាំឆ្នាំ VIP ($19.99/ឆ្នាំ)"

        cust_display_name = existing.get("customer_name") or user_name
        cust_phone = existing.get("phone", "")

        date_str = time.strftime('%d/%m/%Y %H:%M:%S')

        # Update order in persistent database
        fresh_orders[order_id] = {
            "order_id": order_id,
            "status": "pending",
            "plan": plan,
            "plan_name": plan_name,
            "customer_chat_id": chat_id,
            "customer_name": cust_display_name,
            "phone": cust_phone,
            "username": username,
            "created_at": existing.get("created_at", time.time())
        }
        save_orders_to_file(fresh_orders)

        # ----------------------------------------------------------------------
        # STEP A: FORWARD RECEIPT PICTURE TO ADMIN SEYLA (@seyla1280)
