    <script id="khmer-lunar-calendar">
/* Khmer lunar calendar (Chhankitek-style mean-motion model) */
const KhmerCalendar = (function () {
  const KH_DIGITS = '០១២៣៤៥៦៧៨៩';
  const WEEKDAYS = ['អាទិត្យ', 'ច័ន្ទ', 'អង្គារ', 'ពុធ', 'ព្រហស្បតិ៍', 'សុក្រ', 'សៅរ៍'];
  const SOLAR_MONTHS = ['មករា', 'កុម្ភៈ', 'មីនា', 'មេសា', 'ឧសភា', 'មិថុនា', 'កក្កដា', 'សីហា', 'កញ្ញា', 'តុលា', 'វិច្ឆិកា', 'ធ្នូ'];
  const ANIMALS = ['ជូត', 'ឆ្លូវ', 'ខាល', 'ថោះ', 'រោង', 'ម្សាញ់', 'មមី', 'មមែ', 'វក', 'រកា', 'ច', 'កុរ'];
  const SAKS = ['សំរឹទ្ធិស័ក', 'ឯកស័ក', 'ទោស័ក', 'ត្រីស័ក', 'ចត្វាស័ក', 'បញ្ចស័ក', 'ឆស័ក', 'សប្តស័ក', 'អដ្ឋស័ក', 'នព្វស័ក'];

  const jdn = (y, m, d) => Math.floor(Date.UTC(y, m - 1, d) / 86400000) + 2440588;
  const K = jdn(2026, 4, 14) - 506615;            // day-count anchor (Maha Songkran 2026)
  const X = h => h + Math.floor((11 * h + 650) / 692) + 8;   // cumulative lunar-day count
  function monthStart(m) {
    let h = Math.floor((30 * m - 8) * 692 / 703) - 5;
    while (X(h) < 30 * m) h++;
    while (X(h - 1) >= 30 * m) h--;
    return h;
  }
  const songkranDay = g => Math.floor(((g + 543 - 1182) * 292207 + 373) / 800) + 1;
  const chaetMonth = g => Math.floor(X(songkranDay(g)) / 30);
  const mod = (a, n) => ((a % n) + n) % n;

  function toKhmerNum(n) { return String(n).replace(/[0-9]/g, d => KH_DIGITS[+d]); }

  function lunarInfo(date) {
    const y = date.getFullYear(), mo = date.getMonth() + 1, dd = date.getDate();
    const h = jdn(y, mo, dd) - K;
    const m = Math.floor(X(h) / 30);
    let N = y - 1;
    for (const n of [y - 1, y, y + 1]) if (chaetMonth(n) <= m) N = n;
    const k = m - chaetMonth(N);
    const leap = chaetMonth(N + 1) - chaetMonth(N) === 13;
    const names = ['ចេត្រ', 'ពិសាខ', 'ជេស្ឋ'].concat(leap ? ['បឋមាសាឍ', 'ទុតិយាសាឍ'] : ['អាសាឍ'],
      ['ស្រាពណ៍', 'ភទ្របទ', 'អស្សុជ', 'កត្តិក', 'មិគសិរ', 'បុស្ស', 'មាឃ', 'ផល្គុន']);
    const day = h - monthStart(m) + 1;
    const waxing = day <= 15;
    const visakDay = monthStart(chaetMonth(y) + 1) + 14;
    const be = y + 543 + (h >= visakDay ? 1 : 0);
    const animal = ANIMALS[mod(y - 4 - (h < songkranDay(y) ? 1 : 0), 12)];
    const sak = SAKS[mod((h >= songkranDay(y) + 2 ? y : y - 1) + 2, 10)];
    return { weekday: WEEKDAYS[new Date(y, mo - 1, dd).getDay()], day: waxing ? day : day - 15, waxing,
             month: names[k], leapYear: leap, be, animal, sak };
  }

  function lunarLine(date) {
    const i = lunarInfo(date);
    return `ថ្ងៃ${i.weekday} ${toKhmerNum(i.day)}${i.waxing ? 'កើត' : 'រោច'} ខែ${i.month} ឆ្នាំ${i.animal} ${i.sak} ពុទ្ធសករាជ ${toKhmerNum(i.be)}`;
  }
  function solarLine(date, place) {
    return `${place ? place + ' ' : ''}ថ្ងៃទី${toKhmerNum(date.getDate())} ខែ${SOLAR_MONTHS[date.getMonth()]} ឆ្នាំ${toKhmerNum(date.getFullYear())}`;
  }
