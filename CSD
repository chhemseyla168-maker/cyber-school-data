    <script>

        // ========================================================
        // SESSION & USER ACCOUNT INTEGRATION
        // ========================================================
        const SEVEN_DAYS_MS = 7 * 24 * 60 * 60 * 1000;

        function getCurrentUser() {
            try {
                let accId = null;
                try { accId = sessionStorage.getItem('csd-session') || localStorage.getItem('csd-session'); } catch (e) {}
                if (!accId) return null;
                let cleanId = accId;
                if (typeof accId === 'string' && accId.startsWith('{')) {
                    try { const parsed = JSON.parse(accId); cleanId = parsed.id || cleanId; } catch(e){}
                }
                const accsRaw = localStorage.getItem('khmer-accounts-v1');
                if (!accsRaw) return null;
                const accs = JSON.parse(accsRaw);
                if (!Array.isArray(accs)) return null;
                return accs.find(a => a.id === cleanId) || null;
            } catch (e) {
                return null;
            }
        }

        function syncUserPurchase(isTrial, planKey, licenseKey, activeLicense) {
            try {
                const u = getCurrentUser();
                if (!u) return;
                const accsRaw = localStorage.getItem('khmer-accounts-v1');
                const accs = accsRaw ? JSON.parse(accsRaw) : [];
                const target = accs.find(a => a.id === u.id);
                if (target) {
                    const now = Date.now();
                    if (isTrial) {
                        target.trialUsed = true;
                        target.trialStartedAt = now;
                        target.trialExpiresAt = now + SEVEN_DAYS_MS;
                        target.isPremium = false;
                        target.license = activeLicense;
                    } else {
                        target.isPremium = true;
                        target.premiumPlan = planKey;
                        target.licenseKey = licenseKey;
                        target.license = activeLicense;
                    }
                    localStorage.setItem('khmer-accounts-v1', JSON.stringify(accs));
                    localStorage.setItem('csd_user_license_' + target.id, JSON.stringify(activeLicense));
                }
            } catch (e) {
                console.error('syncUserPurchase error:', e);
            }
        }

