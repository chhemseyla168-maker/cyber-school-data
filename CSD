        async function callGeminiForWorksheet(apiKey, prompt, subject, grade, qCount) {
            const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${encodeURIComponent(apiKey)}`;
            
            let mcCount = 3;
            let fillCount = 3;
            let probCount = 1;
            if (qCount <= 5) { mcCount = 2; fillCount = 2; probCount = 1; }
            else if (qCount >= 10) { mcCount = 4; fillCount = 4; probCount = 2; }

            const systemPrompt = `You are an expert Cambodian primary and secondary school curriculum specialist (MoEYS - ក្រសួងអប់រំ យុវជន និងកីឡា).
Create a complete, authentic A4 student worksheet in Khmer language based strictly and 100% accurately on the teacher's prompt instruction.

SPECIFICATIONS:
- Subject: ${subject}
- Grade Level: ${grade}
- Teacher Prompt Instruction: "${prompt || 'ពង្រឹងសមត្ថភាពសិស្សតាមកម្រិតថ្នាក់'}"
- Output Requirements:
  * Exactly ${mcCount} Multiple Choice questions (Section I - ផ្នែកទី ១) with 4 options labeled ក, ខ, គ, ឃ. Wrap key numbers or concepts in <strong>...</strong>.
  * Exactly ${fillCount} Fill-in-the-blank questions (Section II - ផ្នែកទី ២).
  * Exactly ${probCount} Problem-solving / Exercise questions (Section III - ផ្នែកទី ៣) with full detailed step-by-step solution.
  * A clear, concise topicTitle in Khmer.

STRICT FORMAT REQUIREMENT:
Respond ONLY with a valid JSON object matching this schema (NO code blocks, pure JSON):
{
  "topicTitle": "short Khmer topic summary",
  "mc": [
    {
      "q": "សំណួរជាភាសាខ្មែរ?",
      "opts": ["ក. ជម្រើសទី ១", "ខ. ជម្រើសទី ២", "គ. ជម្រើសទី ៣", "ឃ. ជម្រើសទី ៤"],
      "ans": "ក. ជម្រើសទី ១",
      "exp": "ការពន្យល់ខ្លីពីមូលហេតុដែលចម្លើយនេះត្រឹមត្រូវ"
    }
  ],
  "fill": [
    {
      "q": "ល្បះឬសំណួរត្រង់កន្លែងចន្លោះ...",
      "suffix": "ពាក្យបន្តនៅចុងល្បះ (បើមាន) ឬទទេ \"\"",
      "ans": "ចម្លើយបំពេញត្រឹមត្រូវ"
    }
  ],
  "problems": [
    {
      "q": "ប្រធានលំហាត់ចំណោទ ឬកិច្ចការតែងសេចក្តី/ល្បះ...",
      "solution": "ដំណោះស្រាយលម្អិតមួយជំហានៗ និងចម្លើយ"
    }
  ]
}`;

            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    contents: [{ parts: [{ text: systemPrompt }] }],
                    generationConfig: {
                        temperature: 0.25,
                        responseMimeType: "application/json"
                    }
                })
            });

            if (!res.ok) {
                const errData = await res.json().catch(() => ({}));
                throw new Error(errData?.error?.message || `HTTP ${res.status}`);
            }

            const data = await res.json();
            const candidateText = data?.candidates?.[0]?.content?.parts?.[0]?.text;
            if (!candidateText) {
                throw new Error('Gemini API did not return text content.');
            }

            let cleanJsonStr = candidateText.trim();
            if (cleanJsonStr.startsWith('```json')) {
                cleanJsonStr = cleanJsonStr.replace(/^```json\s*/i, '').replace(/```\s*$/i, '').trim();
            } else if (cleanJsonStr.startsWith('```')) {
                cleanJsonStr = cleanJsonStr.replace(/^```\s*/, '').replace(/```\s*$/i, '').trim();
            }

            return JSON.parse(cleanJsonStr);
        }

