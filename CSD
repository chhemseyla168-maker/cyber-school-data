        function renderCanvaTop5Page() {
            const choice = document.getElementById('top5-month-select').value;
            const mainTitle = document.getElementById('top5-main-title');

            let rankedList = [];
            if (choice.startsWith('year:')) {
                rankedList = students.map(s => ({ student: s, score: yearResultOf(s.id).score }));
                mainTitle.innerHTML = `តារាងកិត្តិយសប្រចាំឆ្នាំ<br>${escHtml(currentClass)}`;
            } else if (choice.startsWith('exam:')) {
                const sem = parseInt(choice.slice(5), 10);
                rankedList = students.map(s => ({ student: s, score: examTotalOf(sem, s.id) / 9 }));
                mainTitle.innerHTML = `តារាងកិត្តិយសប្រឡងឆមាសទី ${sem === 1 ? '១' : '២'}<br>${escHtml(currentClass)}`;
