# Protected file extensions and filenames (prevents code leaks and data theft)
BLOCKED_EXTENSIONS = {
    '.py', '.pyc', '.pyo', '.pyd', '.json', '.sql', '.bat', '.cmd', '.ps1',
    '.env', '.bak', '.config', '.lock', '.log', '.sh', '.git', '.gitignore',
    '.ini', '.yaml', '.yml', '.db', '.sqlite', '.sqlite3', '.exe', '.dll', '.tmp'
}
BLOCKED_FILENAMES = {
    'bot_service.py', 'orders.json', 'issued_licenses.json', 'disabled_licenses.json',
    'supabase_schema.sql', 'start_bot.bat', 'antigravity-x64.exe'
}

# In-memory IP Rate Limiting Tracker
ip_rate_limits = {}

def is_rate_limited(ip_key, max_req=30, window=60):
    now = time.time()
    history = ip_rate_limits.setdefault(ip_key, [])
    ip_rate_limits[ip_key] = [t for t in history if now - t < window]
    if len(ip_rate_limits[ip_key]) >= max_req:
        return True
    ip_rate_limits[ip_key].append(now)
    return False

class CSDServerHandler(http.server.SimpleHTTPRequestHandler):
    def log_message(self, format, *args):
        pass  # Suppress HTTP access logs in console

    def do_OPTIONS(self):
        self.send_response(200)
        self.send_header('Access-Control-Allow-Origin', '*')
        self.send_header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS')
        self.send_header('Access-Control-Allow-Headers', 'Content-Type, Authorization, X-Requested-With')
        self.end_headers()

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        client_ip = self.client_address[0] if self.client_address else '127.0.0.1'

        # Secure Telegram Proxy: Frontend can send OTPs/notifications WITHOUT leaking BOT_TOKEN
        if parsed.path == '/api/telegram_proxy':
            if is_rate_limited(f"{client_ip}:tg_proxy", max_req=60, window=60):
                self.send_response(429)
                self.send_header('Content-Type', 'application/json')
                self.send_header('Access-Control-Allow-Origin', '*')
                self.end_headers()
                self.wfile.write(b'{"ok": false, "error": "Rate limit exceeded (Too many requests)"}')
                return

            try:
                length = int(self.headers.get('Content-Length', 0))
                if length > 32768:
                    self.send_response(413)
                    self.end_headers()
                    return
                body_bytes = self.rfile.read(length)
                payload = json.loads(body_bytes.decode('utf-8'))
                method = payload.get('method', '')
                params = payload.get('params', {})
                req_token = payload.get('botToken', '')

                # Security Whitelist: Only safe notification & verification methods are permitted
                ALLOWED_METHODS = {'sendMessage', 'getMe', 'getUpdates'}
                if method not in ALLOWED_METHODS:
                    self.send_response(403)
                    self.send_header('Content-Type', 'application/json')
                    self.send_header('Access-Control-Allow-Origin', '*')
                    self.end_headers()
                    self.wfile.write(b'{"ok": false, "error": "Telegram method prohibited by Security Shield"}')
                    return

                # Route to OTP bot by default (or requested token if recognized)
                target_token = OTP_BOT_TOKEN
                if req_token and req_token in (OTP_BOT_TOKEN, PAYMENT_BOT_TOKEN):
                    target_token = req_token

                res = api_call(method, params, token=target_token)
                resp_bytes = json.dumps(res or {"ok": False, "error": "API failed"}).encode('utf-8')
                self.send_response(200)
                self.send_header('Content-Type', 'application/json')
                self.send_header('Access-Control-Allow-Origin', '*')
                self.end_headers()
                self.wfile.write(resp_bytes)
                return
            except Exception as err:
                self.send_response(400)
                self.send_header('Content-Type', 'application/json')
                self.send_header('Access-Control-Allow-Origin', '*')
                self.end_headers()
                self.wfile.write(json.dumps({"ok": False, "error": str(err)}).encode('utf-8'))
                return

        self.send_response(404)
        self.end_headers()

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        client_ip = self.client_address[0] if self.client_address else '127.0.0.1'

        # ======================================================================
        # 1. SECURITY DEFENSE: PATH TRAVERSAL & SENSITIVE FILE ACCESS SHIELD
        # ======================================================================
        clean_path = urllib.parse.unquote(parsed.path).split('?')[0].replace('\\', '/')
        if '..' in clean_path or '//' in clean_path:
            self.send_response(403)
            self.send_header('Content-Type', 'application/json')
            self.send_header('Access-Control-Allow-Origin', '*')
            self.end_headers()
            self.wfile.write(b'{"error": "Access Denied: Path traversal detected"}')
            return

        file_basename = os.path.basename(clean_path.rstrip('/')).lower()
        _, file_ext = os.path.splitext(file_basename)

        # Block any sensitive files (python code, database json, sql schemas, shell scripts)
        if file_ext in BLOCKED_EXTENSIONS or file_basename in BLOCKED_FILENAMES or '/__pycache__' in clean_path.lower():
            self.send_response(403)
            self.send_header('Content-Type', 'application/json; charset=utf-8')
            self.send_header('Access-Control-Allow-Origin', '*')
            self.end_headers()
            self.wfile.write(b'{"error": "Access Denied: File is protected by Security Shield"}')
            return

        # ======================================================================
        # 2. API ROUTE: Check if a license key is active or disabled
        # ======================================================================
        if parsed.path == '/api/check_license':
            if is_rate_limited(f"{client_ip}:check_lic", max_req=60, window=60):
                self.send_response(429)
                self.send_header('Content-Type', 'application/json')
                self.send_header('Access-Control-Allow-Origin', '*')
                self.end_headers()
                self.wfile.write(b'{"error": "Rate limit exceeded"}')
                return

            query = urllib.parse.parse_qs(parsed.query)
            key = query.get('key', [''])[0].strip().upper()

            # Input validation on license key
            if not key or not re.match(r'^[A-Z0-9\-]{4,40}$', key):
                resp_data = {"key": key, "status": "invalid", "disabled": True}
                body = json.dumps(resp_data).encode('utf-8')
                self.send_response(200)
                self.send_header('Content-Type', 'application/json')
                self.send_header('Access-Control-Allow-Origin', '*')
                self.end_headers()
                self.wfile.write(body)
                return

            # Reload to ensure fresh state
            current_disabled = load_disabled_licenses()
            current_issued = load_issued_licenses()

            is_disabled = key in current_disabled
            if is_disabled:
                status = "disabled"
            elif key in current_issued:
                status = "active"
            else:
                status = "unknown"   # never issued by this bot -> not Pro

            resp_data = {
                "key": key,
                "status": status,
                "disabled": is_disabled or status == "unknown"
            }
            body = json.dumps(resp_data).encode('utf-8')

            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.send_header('Access-Control-Allow-Origin', '*')
            self.send_header('Access-Control-Allow-Methods', 'GET, OPTIONS')
            self.send_header('Access-Control-Allow-Headers', '*')
            self.send_header('Cache-Control', 'no-cache, no-store, must-revalidate')
            self.end_headers()
            self.wfile.write(body)
            return

        # ======================================================================
        # 3. API ROUTE: Register a pending order from checkout in web app
        # ======================================================================
        if parsed.path == '/api/register_order':
            if is_rate_limited(f"{client_ip}:reg_order", max_req=10, window=60):
                self.send_response(429)
                self.send_header('Content-Type', 'application/json')
                self.send_header('Access-Control-Allow-Origin', '*')
                self.end_headers()
                self.wfile.write(b'{"ok": false, "error": "Too many orders registered. Please wait."}')
                return

            query = urllib.parse.parse_qs(parsed.query)
            order_id = query.get('order_id', [''])[0].strip().upper()
            plan = query.get('plan', ['YEAR'])[0].strip().upper()
            customer_name = query.get('name', [''])[0].strip()
            phone = query.get('phone', [''])[0].strip()

            # Strict input validation
            if not order_id or not re.match(r'^[A-Z0-9\-]{4,35}$', order_id):
                self.send_response(400)
                self.send_header('Content-Type', 'application/json')
                self.send_header('Access-Control-Allow-Origin', '*')
                self.end_headers()
                self.wfile.write(b'{"ok": false, "error": "Invalid Order ID format"}')
                return

            if plan not in ['MONTH', 'MONTHLY', 'YEAR', 'YEARLY', 'TRIAL']:
                plan = 'YEAR'

            clean_name = re.sub(r'[<>&"\']', '', customer_name)[:60]
            clean_phone = re.sub(r'[^\d+]', '', phone)[:20]

            fresh_orders = load_orders()
            # Prevent database bloat (cap at 5000 orders)
            if len(fresh_orders) > 5000:
                oldest = sorted(fresh_orders.keys(), key=lambda k: fresh_orders[k].get('created_at', 0))[:500]
                for old_k in oldest:
                    fresh_orders.pop(old_k, None)

            if order_id not in fresh_orders or fresh_orders[order_id].get("status") != "approved":
                prev = fresh_orders.get(order_id, {})
                plan_clean = "MONTH" if "MONTH" in plan else "YEAR"
                plan_name = "កញ្ចប់ប្រចាំខែ ($4.99/ខែ)" if plan_clean == "MONTH" else "កញ្ចប់ប្រចាំឆ្នាំ VIP ($19.99/ឆ្នាំ)"
                fresh_orders[order_id] = {
                    "order_id": order_id,
                    "status": "pending",
                    "plan": plan_clean,
                    "plan_name": plan_name,
                    "customer_name": clean_name or prev.get("customer_name", ""),
                    "phone": clean_phone or prev.get("phone", ""),
                    "customer_chat_id": prev.get("customer_chat_id", ""),
                    "username": prev.get("username", ""),
                    "created_at": prev.get("created_at", time.time())
                }
                save_orders_to_file(fresh_orders)

            resp_data = {
                "ok": True,
                "order_id": order_id,
                "status": fresh_orders.get(order_id, {}).get("status", "pending")
            }
            body = json.dumps(resp_data).encode('utf-8')

            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.send_header('Access-Control-Allow-Origin', '*')
            self.send_header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS')
            self.send_header('Access-Control-Allow-Headers', '*')
            self.send_header('Cache-Control', 'no-cache, no-store, must-revalidate')
            self.end_headers()
            self.wfile.write(body)
            return

        # ======================================================================
        # 4. API ROUTE: Check order status (pending, approved, rejected)
        # ======================================================================
        if parsed.path == '/api/check_order':
            if is_rate_limited(f"{client_ip}:check_ord", max_req=60, window=60):
                self.send_response(429)
                self.send_header('Content-Type', 'application/json')
                self.send_header('Access-Control-Allow-Origin', '*')
                self.end_headers()
                self.wfile.write(b'{"error": "Rate limit exceeded"}')
                return

            query = urllib.parse.parse_qs(parsed.query)
            order_id = query.get('order_id', [''])[0].strip().upper()

            if not order_id or not re.match(r'^[A-Z0-9\-]{4,35}$', order_id):
                self.send_response(400)
                self.send_header('Content-Type', 'application/json')
                self.send_header('Access-Control-Allow-Origin', '*')
                self.end_headers()
                self.wfile.write(b'{"error": "Invalid Order ID"}')
                return

            fresh_orders = load_orders()
            order_info = fresh_orders.get(order_id)
            if order_info:
                resp_data = {
                    "order_id": order_id,
                    "status": order_info.get("status", "pending"),
                    "plan": order_info.get("plan", "YEAR"),
                    "key": order_info.get("license_key", ""),
                    "message": order_info.get("message", "")
                }
            else:
                resp_data = {
                    "order_id": order_id,
                    "status": "pending",
                    "plan": "YEAR",
                    "key": "",
                    "message": ""
                }
            body = json.dumps(resp_data).encode('utf-8')

            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.send_header('Access-Control-Allow-Origin', '*')
            self.send_header('Access-Control-Allow-Methods', 'GET, OPTIONS')
            self.send_header('Access-Control-Allow-Headers', '*')
            self.send_header('Cache-Control', 'no-cache, no-store, must-revalidate')
            self.end_headers()
            self.wfile.write(body)
            return

        # Serve static web files only
        super().do_GET()

def start_local_server(port=LOCAL_PORT):
    def run_server():
        current_dir = os.path.dirname(os.path.abspath(__file__))
        os.chdir(current_dir)
        try:
            socketserver.TCPServer.allow_reuse_address = True
            with socketserver.TCPServer(("127.0.0.1", port), CSDServerHandler) as httpd:
                print(f"[{time.strftime('%X')}] Hardened Web Server running on 127.0.0.1:{port} (Security Shield Active)")
