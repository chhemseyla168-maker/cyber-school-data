            document.getElementById('modal-sub-id').innerText = `ID: ${acc.id} • Teacher: ${t.id}`;
            document.getElementById('edit-username').value = acc.username || '';
            document.getElementById('edit-role').value = isAccountAdmin(acc) ? 'admin' : 'user';

            const SEVEN_DAYS = 7 * 24 * 60 * 60 * 1000;
            let curPlan = 'free';
            if (acc.isPremium) {
                curPlan = acc.premiumPlan === 'monthly' ? 'monthly' : 'yearly';
            } else if (acc.trialStartedAt && (Date.now() - Number(acc.trialStartedAt) < SEVEN_DAYS)) {
                curPlan = 'trial';
            }
            const planSelect = document.getElementById('edit-membership-plan');
            if (planSelect) planSelect.value = curPlan;
            const resetTrialChk = document.getElementById('edit-reset-trial');
            if (resetTrialChk) resetTrialChk.checked = false;
            const badgeEl = document.getElementById('edit-plan-badge');
            if (badgeEl) badgeEl.textContent = curPlan.toUpperCase();
            document.getElementById('edit-phone').value = displayPhone(acc.phone) || '';
            document.getElementById('edit-password').value = '';
            document.getElementById('edit-teacher-name').value = t.name || '';
            document.getElementById('edit-teacher-sex').value = t.sex || 'M';
