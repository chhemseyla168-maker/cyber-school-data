<script>
/* ===== ការភ្ជាប់ជាមួយប្រព័ន្ធ Login របស់អ្នក =====
   បន្ថែមមុនកូដនេះ៖  window.LOGIN_USER = {name:"ចាន់ សុវណ្ណនីតា", school:"...", grade:"៤ ក", subject:"ភាសាខ្មែរ"};
   ឬហៅ setLoginUser({...}) ក្រោយ login ជោគជ័យ។ */
const $=id=>document.getElementById(id);
const KEY="lessonplan_v1", UKEY="lessonplan_user";
const kh=s=>String(s).replace(/\d/g,d=>"០១២៣៤៥៦៧៨៩"[d]);
const DAYS=["អាទិត្យ","ច័ន្ទ","អង្គារ","ពុធ","ព្រហស្បតិ៍","សុក្រ","សៅរ៍"];
const MONTHS=["មករា","កុម្ភៈ","មីនា","មេសា","ឧសភា","មិថុនា","កក្កដា","សីហា","កញ្ញា","តុលា","វិច្ឆិកា","ធ្នូ"];
const esc=s=>String(s??"").replace(/[&<>]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c]));
const IDS=["date","cls","subject","lessonNo","title","subtitle","duration","teacher","school","source","obj1","obj2","obj3","matT","matS"];
const DEFAULT_STEPS=[
 {t:"លំនឹងថ្នាក់",c:"-វត្តមាន និងអវត្តមាន\n-ពិនិត្យអនាម័យ\n-វិន័យនិងសណ្តាប់ធ្នាប់",a:"-ពិនិត្យអវត្តមាន(សិស្ស)\n-ពិនិត្យអនាម័យ\n-ពង្រឹងវិន័យនិងសណ្តាប់ធ្នាប់",s:"-ប្រធានថ្នាក់រាយការណ៍\n-អង្គុយដាក់ដៃលើតុ\n-អង្គុយស្ងៀមស្ងាត់"},
 {t:"កិច្ចការចាស់",c:"",a:"",s:""},
 {t:"មេរៀនថ្មី",c:"",a:"",s:""},
 {t:"ពង្រឹងពុទ្ធិ",c:"",a:"",s:""},
 {t:"កិច្ចការផ្ទះ និងបណ្តាំគ្រូ",c:"",a:"",s:""}
];
let steps=JSON.parse(JSON.stringify(DEFAULT_STEPS));

/* ---- user / login ---- */
const SEED_USER = {
  name: "",
  school: "",
  grade: "ថ្នាក់ទី៤",
  subject: "គណិតវិទ្យា"
};

function getUser(){
  if(window.LOGIN_USER && (window.LOGIN_USER.name || window.LOGIN_USER.username)) return window.LOGIN_USER;

  // 1. Priority 1: Active logged-in user account from csd-session
  try{
    const sess = sessionStorage.getItem('csd-session') || localStorage.getItem('csd-session');
    const accsRaw = localStorage.getItem('khmer-accounts-v1');
    if(sess && accsRaw){
      let cleanId = sess;
      if (typeof sess === 'string' && sess.startsWith('{')) {
        try { cleanId = JSON.parse(sess).id || cleanId; } catch(e){}
      }
      const accs = JSON.parse(accsRaw);
      if(Array.isArray(accs)){
        const acc = accs.find(a => a.id === cleanId || a.username === cleanId);
        if(acc){
          let t = null;
          try {
            const teachers = JSON.parse(localStorage.getItem('khmer-teacher-profiles') || '[]');
            if(acc.teacherId && Array.isArray(teachers)){
              t = teachers.find(x => x.id === acc.teacherId);
            }
          }catch(err){}
          return {
            name: (t && t.name && t.name !== 'ឈឹម សិលា') ? t.name : (acc.fullName || acc.name || acc.username || ''),
            school: (t && t.school) || acc.school || '',
            grade: (t && t.className) || acc.className || 'ថ្នាក់ទី៤',
            subject: 'គណិតវិទ្យា',
            place: (t && t.place) || ''
          };
        }
      }
    }
  }catch(e){}

  // 2. Priority 2: Active teacher profile from main app
  try{
    const lastTeacherId = localStorage.getItem('khmer-teacher-last');
    const teachers = JSON.parse(localStorage.getItem('khmer-teacher-profiles') || '[]');
    if(Array.isArray(teachers) && teachers.length){
      const t = teachers.find(x => x.id === lastTeacherId) || teachers[0];
      if(t && (t.name || t.school)){
        return {
          name: (t.name && t.name !== 'ឈឹម សិលា') ? t.name : '',
          school: t.school || '',
          grade: t.className || 'ថ្នាក់ទី៤',
          subject: 'គណិតវិទ្យា',
          place: t.place || ''
        };
      }
    }
  }catch(e){}

  // 3. Priority 3: lessonplan_user synced from main app
  try{
    const raw = localStorage.getItem(UKEY);
    if(raw) {
      const u = JSON.parse(raw);
      if(u && (u.name || u.school)) {
        return {
          name: (u.name && u.name !== 'ឈឹម សិលា') ? u.name : '',
          school: (u.school && u.school !== 'សាលាបឋមសិក្សាពេជ្រចិន្តា') ? u.school : '',
          grade: u.grade || 'ថ្នាក់ទី៤',
          subject: u.subject || 'គណិតវិទ្យា',
          place: u.place || ''
        };
      }
    }
  }catch(e){}

  // 4. Priority 4: Admin session
  try{
    const adminRaw = sessionStorage.getItem('csd-admin-user');
    if(adminRaw){
      const adm = JSON.parse(adminRaw);
      if(adm && (adm.name || adm.username)){
        return {
          name: adm.fullName || adm.name || adm.username || '',
          school: adm.school || '',
          grade: 'ថ្នាក់ទី៤',
          subject: 'គណិតវិទ្យា',
          place: ''
        };
      }
    }
  }catch(e){}

  return SEED_USER;
}

window.setLoginUser=function(u){
  try{localStorage.setItem(UKEY,JSON.stringify(u))}catch(e){}
  window.LOGIN_USER=u; applyUser(true); renderLogin();
};

function applyUser(force){
  const u = getUser();
  if(!u) return;
  // Dynamic sync: if empty OR contains old hardcoded name, sync with user name
  if(force || !$("teacher").value || $("teacher").value === "ឈឹម សិលា") {
    $("teacher").value = (u.name && u.name !== "ឈឹម សិលា") ? u.name : (u.name || "");
  }
