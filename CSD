            // Section III: Problems
            const probContainer = document.getElementById('sec-prob-items');
            probContainer.innerHTML = '';
            let akProbHtml = '';
            const probList = data.problems || [];
            const linesPerProb = probList.length > 1 ? Math.max(4, Math.floor(currentWorkLinesCount / 2)) : currentWorkLinesCount;

            probList.forEach((item, idx) => {
                const probLabel = probList.length > 1 ? `<strong>ចំណោទទី ${['១', '២', '៣'][idx] || (idx + 1)}៖</strong> ` : `<strong>ចំណោទ៖</strong> `;
