        // ================= Page 4: student information form =================
        const SF_FIELDS = ['sid','lastname','firstname','gender','dob','status','father','fatherJob','mother','motherJob','birthPlace','village','address'];
        const SF_LABELS = { sid:'អត្តលេខ', lastname:'គោត្តនាម', firstname:'នាម', gender:'ភេទ', dob:'ថ្ងៃ-ខែ-ឆ្នាំកំណើត', status:'ជាសិស្ស',
            father:'ឈ្មោះឪពុក', fatherJob:'មុខរបរឪពុក', mother:'ឈ្មោះម្តាយ', motherJob:'មុខរបរម្តាយ', birthPlace:'ទីកន្លែងកំណើត', village:'ភូមិបច្ចុប្បន្ន', address:'ទីលំនៅបច្ចុប្បន្ន' };
        const SF_NO_SPACE = ['lastname', 'firstname'];   // single words: join the spaces speech engines add
        let sfCurrentId = null, sfActive = null, sfRec = null, sfListening = false;
        const sfEl = k => document.getElementById('sf-' + k);

        function sfDigits(t) { return String(t || '').replace(/[០-៩]/g, d => '០១២៣៤៥៦៧៨៩'.indexOf(d)); }
        const SF_MONTHS = [['មករា',1],['កុម្ភៈ',2],['មីនា',3],['មេសា',4],['ឧសភា',5],['មិថុនា',6],['កក្កដា',7],['សីហា',8],['កញ្ញា',9],['តុលា',10],['វិច្ឆិកា',11],['ធ្នូ',12]];
        function sfNormDob(t) {
            let x = sfDigits(t);
            SF_MONTHS.forEach(([n, i]) => { x = x.replace(new RegExp(n.split('').join('\\s*'), 'g'), ' ' + i + ' '); });
            const p = x.match(/\d+/g);
            if (!p || p.length < 3) return '';
            const d = +p[0], m = +p[1], y = +p[2];
            if (String(p[2]).length !== 4) return '';
            const dt = new Date(y, m - 1, d);
            if (dt.getFullYear() !== y || dt.getMonth() !== m - 1 || dt.getDate() !== d) return '';
            return String(d).padStart(2, '0') + '.' + String(m).padStart(2, '0') + '.' + y;
        }
        function sfAge(dob) {
            const n = sfNormDob(dob);
            if (!n) return '';
            const [d, m, y] = n.split('.').map(Number), now = new Date();
            let a = now.getFullYear() - y;
            if (now.getMonth() + 1 < m || (now.getMonth() + 1 === m && now.getDate() < d)) a--;
            return a >= 0 ? a : '';
        }
        function sfUpdateAge() { const el = sfEl('age'); if (el) el.value = sfAge(sfEl('dob').value); }
        function sfBlurDob() { const el = sfEl('dob'); const n = sfNormDob(el.value); if (n) el.value = n; sfUpdateAge(); }
        function sfVoiceStatus(msg) { const el = document.getElementById('sf-voice-status'); if (el) el.innerText = msg; }

        function renderStudentForm() {
