            f"👤 <b>អតិថិជន:</b> {html.escape(cust_display_name)} ({html.escape(username)})\n"
            + (f"📱 <b>លេខទូរស័ព្ទ:</b> <code>{html.escape(cust_phone)}</code>\n" if cust_phone else "")
            + f"🆔 <b>Telegram ID:</b> <code>{chat_id}</code>\n"
