        // Writes one spoken value into a field, converted for the field type. Returns true when accepted.
        function sfSet(key, heard) {
            const el = sfEl(key);
            heard = String(heard || '').replace(/^[\s:៖,។-]*(?:គឺ)?\s*/, '').replace(/[\s,។]+$/, '');
            if (!el || !heard) return false;
            let val = '';
