function formatHeaderDocTitle(subj, c) {
  const s = (subj !== undefined ? subj : val("subject")).trim();
  let grade = (c !== undefined ? c : val("cls")).trim();
  if (grade && !grade.startsWith("ថ្នាក់")) {
    grade = "ថ្នាក់ទី" + grade;
  }
  if (!s && !grade) return "កិច្ចតែងការបង្រៀន";
  return `កិច្ចតែងការបង្រៀន${s}${grade}`;
}

function formatSchoolName(sch) {
  let s = (sch !== undefined ? sch : val("school")).trim();
  if (!s || s === "សាលាបឋមសិក្សាពេជ្រចិន្តា") {
    const u = getUser();
    if (u && u.school && u.school !== "សាលាបឋមសិក្សាពេជ្រចិន្តា") {
      s = u.school.trim();
    }
  }
  if (!s) s = "សាលាបឋមសិក្សា";
  if (!s.startsWith("សាលា") && !s.startsWith("អនុវិទ្យាល័យ") && !s.startsWith("វិទ្យាល័យ") && !s.startsWith("មត្តេយ្យ")) {
    s = "សាលា" + s;
  }
  return s;
}

function formatTeacherName() {
  let t = val("teacher").trim();
  if (!t || t === "ឈឹម សិលា") {
    const u = getUser();
    if (u && u.name && u.name !== "ឈឹម សិលា") {
      t = u.name.trim();
    }
  }
  return t || "";
}

