        // Calculate and Refresh Order Summary
        function updateOrderSummary() {
            const planKey = state.selectedPlan;
            const isUsd = state.currency === 'USD';
            const planData = PRICING[planKey];
            const rawCost = isUsd ? planData.usd : planData.khr;

            // Plan Name & Period
            document.getElementById('sum-plan-name').textContent = state.language === 'km' ? planData.name_km : planData.name_en;
            document.getElementById('sum-billing-term').textContent = state.language === 'km' ? planData.term_km : planData.term_en;

            // Raw cost
            const rawCostFormatted = isUsd ? `$${rawCost.toFixed(2)}` : `${rawCost.toLocaleString()} ៛`;
            document.getElementById('sum-plan-raw-price').textContent = rawCostFormatted;
            document.getElementById('breakdown-subtotal').textContent = rawCostFormatted;

            // Calculate Discount
            let discount = 0;
            if (state.appliedCoupon && rawCost > 0) {
                if (state.appliedCoupon.percent) {
                    discount = (rawCost * state.appliedCoupon.percent) / 100;
                } else if (state.appliedCoupon.fixedUSD && isUsd) {
                    discount = Math.min(rawCost, state.appliedCoupon.fixedUSD);
                } else if (state.appliedCoupon.fixedKHR && !isUsd) {
                    discount = Math.min(rawCost, state.appliedCoupon.fixedKHR);
                }
            }

            const finalTotal = Math.max(0, rawCost - discount);

            // Display Discount
            const discountFormatted = isUsd ? `-$${discount.toFixed(2)}` : `-${discount.toLocaleString()} ៛`;
            document.getElementById('breakdown-discount').textContent = discountFormatted;

            // Display Final Total
            const totalFormatted = isUsd ? `$${finalTotal.toFixed(2)}` : `${finalTotal.toLocaleString()} ៛`;
            document.getElementById('breakdown-total').textContent = totalFormatted;

            // Secondary currency estimate
            if (isUsd) {
                const khrVal = Math.round(finalTotal * 4100);
                document.getElementById('breakdown-khr-equiv').textContent = `≈ ${khrVal.toLocaleString()} ៛ KHR`;
                document.getElementById('khqr-amount-display').textContent = `$${finalTotal.toFixed(2)} USD`;
            } else {
                const usdVal = (finalTotal / 4100).toFixed(2);
                document.getElementById('breakdown-khr-equiv').textContent = `≈ $${usdVal} USD`;
                document.getElementById('khqr-amount-display').textContent = `${finalTotal.toLocaleString()} ៛ KHR`;
            }

            // Update KHQR dynamic QR image with final amount safely if present
            const qrImgEl = document.getElementById('khqr-qr-image');
            if (qrImgEl) {
                const qrData = encodeURIComponent(`KHQR-CHHEM-SEYLA-ACC34870479345818-${planKey.toUpperCase()}-${finalTotal}${isUsd ? 'USD' : 'KHR'}-INVOICE${Date.now()}`);
                qrImgEl.src = `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${qrData}`;
            }

            // Update Pay Button label
            const payBtnLabel = document.getElementById('pay-btn-label');
            if (payBtnLabel) {
                if (planKey === 'trial') {
                    payBtnLabel.textContent = state.language === 'km' ? 'ដំណើរការសាកល្បង ៧ ថ្ងៃឥតគិតថ្លៃ' : 'Activate 7-Day Free Trial';
                } else {
                    payBtnLabel.textContent = state.language === 'km' ? `បន្តទៅផ្ញើបង្កាន់ដៃតាម Telegram ($${finalTotal.toFixed(2)})` : `Send Slip via Telegram ($${finalTotal.toFixed(2)})`;
                }
            }
        }

