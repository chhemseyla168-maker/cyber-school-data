def handle_message(msg):
    chat = msg.get('chat', {})
    chat_id = chat.get('id')
    msg_id = msg.get('message_id')
    user = msg.get('from', {})

    first_name = user.get('first_name', '')
    last_name = user.get('last_name', '')
    user_name = (f"{first_name} {last_name}").strip() or "លោកគ្រូ/អ្នកគ្រូ"
    username = (f"@{user.get('username')}") if user.get('username') else 'គ្មាន'

    text = (msg.get('text') or msg.get('caption') or '').strip()
    has_photo = 'photo' in msg
    has_document = 'document' in msg
    media_group_id = msg.get('media_group_id')

    # Unique message identifier
    msg_unique_id = f"{chat_id}_{msg_id}"
    if msg_unique_id in processed_message_ids:
        return
    processed_message_ids.add(msg_unique_id)

    # If part of an album/media group, avoid multiple triggers for the same album
    if media_group_id:
        if media_group_id in processed_media_groups:
            print(f"[{time.strftime('%X')}] Skipping additional photo in album {media_group_id}")
            return
        processed_media_groups.add(media_group_id)

    print(f"[{time.strftime('%X')}] Message from {user_name} ({chat_id}) | Photo: {has_photo} | Doc: {has_document} | Text: {text[:45]}...")

    # 1. Handle /start or /help command
    if text.startswith('/start') or text.startswith('/help'):
        welcome_text = (
            f"👋 <b>ជំរាបសួរ លោកគ្រូ/អ្នកគ្រូ {html.escape(user_name)}!</b>\n\n"
            "🤖 ខ្ញុំជាប្រព័ន្ធស្វ័យប្រវត្ត <b>CSD Verification Bot</b> (@mywebverifybot)។\n\n"
            "✨ <b>របៀបបើកប្រើ CSD Pro VIP តាម Option 2 (1-Click Link)៖</b>\n"
            "១. ស្កេនទូទាត់ប្រាក់តាម ACLEDA KHQR (3487-04793458-18 Chhem Seyla)\n"
            "២. <b>ផ្ញើរូបភាពបង្កាន់ដៃបង់ប្រាក់ (Payment Slip / Receipt Photo 📸) មកកាន់ទីនេះ</b>\n"
            "៣. Bot នឹងផ្ញើ <b>តំណភ្ជាប់ 1-Click</b> ជូនលោកគ្រូ/អ្នកគ្រូភ្លាមៗ!\n\n"
            "👉 លោកគ្រូ/អ្នកគ្រូគ្រាន់តែចុចលើតំណភ្ជាប់នោះ កម្មវិធី CSD នឹងបើកប្រើ Pro ដោយស្វ័យប្រវត្តតែម្តង (មិនបាច់វាយកូដទេ)!"
        )
        api_call("sendMessage", {
            "chat_id": chat_id,
            "text": welcome_text,
            "parse_mode": "HTML"
        })
        return

    # ==========================================================================
    # 2. STRICT RECEIPT VALIDATION:
    # A REAL RECEIPT MUST CONTAIN AN ACTUAL PHOTO OR DOCUMENT!
    # ==========================================================================
    if has_photo or has_document:
        # Cooldown per user: 2 seconds
        now = time.time()
        last_time = last_action_per_user.get(chat_id, 0)
        if now - last_time < 0.5:
            print(f"[{time.strftime('%X')}] Cooldown hit for {chat_id}, skipping duplicate trigger")
            return
        last_action_per_user[chat_id] = now

        fresh_orders = load_orders()

        # Extract or resolve Order ID
        order_match = re.search(r'CSD-ORD-[0-9A-Z\-]+', text, re.IGNORECASE) if text else None
        order_id = order_match.group(0).upper().rstrip('-') if order_match else None

        # If no order ID in photo caption, resolve from context
        if not order_id:
            # Check 1: User's cached pending order
            if chat_id in user_pending_order:
                order_id = user_pending_order[chat_id]
            # Check 2: Any pending order already associated with this chat_id
            if not order_id:
                for oid, oinfo in fresh_orders.items():
                    if str(oinfo.get("customer_chat_id")) == str(chat_id) and oinfo.get("status") == "pending":
                        order_id = oid
                        break
            # Check 3: The most recently registered pending order without a chat_id (within last 30 minutes)
            if not order_id:
                recent_pending = []
                for oid, oinfo in fresh_orders.items():
                    if oinfo.get("status") == "pending" and not oinfo.get("customer_chat_id"):
                        age = now - float(oinfo.get("created_at", 0))
                        if age < 1800:
                            recent_pending.append((age, oid))
                if recent_pending:
                    recent_pending.sort()
                    order_id = recent_pending[0][1]
            # Fallback: Generate new Order ID only if no pending order exists anywhere
            if not order_id:
                order_id = f"CSD-ORD-{random.randint(1000, 9999)}"

        user_pending_order[chat_id] = order_id
        rejected_orders.discard(order_id)

        # Retrieve or determine Plan
        existing = fresh_orders.get(order_id, {})
        is_monthly = ("ប្រចាំខែ" in text) or ("MONTH" in text.upper()) or ("4.99" in text)
        default_plan = "MONTH" if is_monthly else "YEAR"
