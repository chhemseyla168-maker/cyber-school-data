$("steps").addEventListener("input",e=>{
  const k=e.target.dataset.k, st=e.target.closest(".step"); if(!k||!st) return;
  steps[+st.dataset.i][k]=e.target.value; render();
});
$("steps").addEventListener("click",e=>{
  const d=e.target.dataset.del; if(d===undefined) return;
  if(steps.length>1&&confirm("លុបជំហាននេះ?")){steps.splice(+d,1);renderSteps();render()}
});
