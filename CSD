        function toggleVoiceAIEntry() {
            if (!isProUser()) {
                showProVoiceModal();
                return;
            }
            const statusText = document.getElementById('ai-status-text');
            const micBtn = document.getElementById('ai-mic-btn');
            if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
                alert('កម្មវិធីរុករករបស់អ្នក (Browser) មិនគាំទ្រប្រព័ន្ធសំឡេង Speech Recognition ទេ។');
                return;
            }
            if (isListening && recognition) { recognition.stop(); return; }
            const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
            recognition = new SR();
            recognition.lang = 'km-KH';
            recognition.interimResults = false;
            recognition.maxAlternatives = 3;
            statusText.innerText = "🎤 កំពុងស្តាប់សំឡេង... សូមនិយាយពិន្ទុ";
            let gotResult = false;
            recognition.onstart = function() { isListening = true; micBtn.classList.add('animate-pulse'); };
            recognition.onresult = function(event) {
                if (!isProUser()) { showProVoiceModal(); return; }
                gotResult = true;
                // try every alternative, keep the first one that yields scores
                const alts = Array.from(event.results[0]).map(a => a.transcript);
                let spoken = alts[0], applied = null;
                for (const t of alts) {
                    const r = applyVoiceScores(t);
                    if (r.length) { spoken = t; applied = r; break; }
                }
                if (applied) {
                    statusText.innerText = `✅ ស្តាប់ឮ៖ "${spoken}" → ${applied.map(a => a.label + ' ' + a.value).join(' • ')}`;
                } else {
                    statusText.innerText = `⚠️ ស្តាប់ឮ៖ "${spoken}" ប៉ុន្តែរកមិនឃើញមុខវិជ្ជា ឬពិន្ទុទេ។ សូមនិយាយម្តងទៀត (ឧ៖ "គណិត ប្រាំបី សរសេរ ប្រាំបួន")`;
                }
            };
            recognition.onerror = function(e) {
                statusText.innerText = `❌ មានបញ្ហាសំឡេង (${e.error}) សូមព្យាយាមម្តងទៀត`;
            };
            recognition.onend = function() {
                isListening = false;
                micBtn.classList.remove('animate-pulse');
                if (!gotResult && !/❌/.test(statusText.innerText)) statusText.innerText = "មិនបានស្តាប់ឮអ្វីទេ សូមចុចមីក្រូហ្វូន ហើយនិយាយម្តងទៀត";
            };
            recognition.start();
        }

