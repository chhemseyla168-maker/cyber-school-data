  else if (p.includes('វិទ្យាសាស្ត្រ') || p.includes('សត្វ') || p.includes('រុក្ខជាតិ') || p.includes('បរិស្ថាន') || p.includes('ថាមពល') || p.includes('ដី')) subject = 'វិទ្យាសាស្ត្រ';
  else if (p.includes('សង្គម') || p.includes('ភូមិ') || p.includes('ប្រវត្តិ') || p.includes('ច្បាប់') || p.includes('អង្គរ') || p.includes('អាស៊ាន')) subject = 'សិក្សាសង្គម';
  else if (p.includes('english') || p.includes('routine') || p.includes('greetings') || p.includes('weather') || p.includes('animal') || p.includes('food')) subject = 'ភាសាអង់គ្លេស';

  const units = gradeData[subject] || [];

  // 1. Try exact keyword matching in current grade
  for (let u of units) {
    const titleClean = u.title.toLowerCase();
    const subClean = u.subtitle.toLowerCase();
    const lesNoClean = u.lessonNo.toLowerCase();
    if (p.includes(titleClean) || p.includes(subClean) || (p.includes('មេរៀនទី' + lesNoClean) && p.includes(subject.toLowerCase()))) {
