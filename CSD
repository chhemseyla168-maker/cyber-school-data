class CSDServerHandler(http.server.SimpleHTTPRequestHandler):
    def log_message(self, format, *args):
        pass  # Suppress HTTP access logs in console

    def do_OPTIONS(self):
        self.send_response(200)
        self.send_header('Access-Control-Allow-Origin', '*')
        self.send_header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS')
        self.send_header('Access-Control-Allow-Headers', '*')
        self.end_headers()

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)

        # API Route: Check if a license key is active or disabled
        if parsed.path == '/api/check_license':
            query = urllib.parse.parse_qs(parsed.query)
            key = query.get('key', [''])[0].strip().upper()

            # Reload to ensure fresh state
            current_disabled = load_disabled_licenses()
            current_issued = load_issued_licenses()

            is_disabled = key in current_disabled
            if is_disabled:
                status = "disabled"
            elif key in current_issued:
                status = "active"
            else:
                status = "unknown"   # never issued by this bot -> not Pro

            resp_data = {
                "key": key,
                "status": status,
                "disabled": is_disabled or status == "unknown"
            }
            body = json.dumps(resp_data).encode('utf-8')

            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.send_header('Access-Control-Allow-Origin', '*')
            self.send_header('Access-Control-Allow-Methods', 'GET, OPTIONS')
            self.send_header('Access-Control-Allow-Headers', '*')
            self.send_header('Cache-Control', 'no-cache, no-store, must-revalidate')
            self.end_headers()
            self.wfile.write(body)
            return

        # API Route: Register a pending order from checkout in web app
        if parsed.path == '/api/register_order':
            query = urllib.parse.parse_qs(parsed.query)
            order_id = query.get('order_id', [''])[0].strip().upper()
            plan = query.get('plan', ['YEAR'])[0].strip().upper()
            customer_name = query.get('name', [''])[0].strip()
            phone = query.get('phone', [''])[0].strip()

            if order_id:
                fresh_orders = load_orders()
                if order_id not in fresh_orders or fresh_orders[order_id].get("status") != "approved":
                    fresh_orders[order_id] = {
                        "order_id": order_id,
                        "status": "pending",
                        "plan": plan,
                        "customer_name": customer_name,
                        "phone": phone,
                        "created_at": time.time()
                    }
                    save_orders_to_file(fresh_orders)

            resp_data = {
                "ok": True,
                "order_id": order_id,
                "status": orders_db.get(order_id, {}).get("status", "pending")
            }
            body = json.dumps(resp_data).encode('utf-8')

            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.send_header('Access-Control-Allow-Origin', '*')
            self.send_header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS')
            self.send_header('Access-Control-Allow-Headers', '*')
            self.send_header('Cache-Control', 'no-cache, no-store, must-revalidate')
            self.end_headers()
            self.wfile.write(body)
            return

        # API Route: Check order status (pending, approved, rejected)
        if parsed.path == '/api/check_order':
            query = urllib.parse.parse_qs(parsed.query)
            order_id = query.get('order_id', [''])[0].strip().upper()

            fresh_orders = load_orders()
            order_info = fresh_orders.get(order_id)
            if order_info:
                resp_data = {
                    "order_id": order_id,
                    "status": order_info.get("status", "pending"),
                    "plan": order_info.get("plan", "YEAR"),
                    "key": order_info.get("license_key", "")
                }
            else:
                resp_data = {
                    "order_id": order_id,
                    "status": "pending",
                    "plan": "YEAR",
                    "key": ""
                }
            body = json.dumps(resp_data).encode('utf-8')

            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.send_header('Access-Control-Allow-Origin', '*')
            self.send_header('Access-Control-Allow-Methods', 'GET, OPTIONS')
            self.send_header('Access-Control-Allow-Headers', '*')
            self.send_header('Cache-Control', 'no-cache, no-store, must-revalidate')
            self.end_headers()
            self.wfile.write(body)
            return

        super().do_GET()

def start_local_server(port=LOCAL_PORT):
    def run_server():
        current_dir = os.path.dirname(os.path.abspath(__file__))
        os.chdir(current_dir)
        try:
            with socketserver.TCPServer(("", port), CSDServerHandler) as httpd:
                print(f"[{time.strftime('%X')}] Built-in Web Server running on port {port}")
                httpd.serve_forever()
        except OSError as e:
            if "address already in use" in str(e).lower() or getattr(e, 'errno', 0) == 10048:
                print(f"[{time.strftime('%X')}] Web Server already active on port {port}")
            else:
                print(f"[{time.strftime('%X')}] Web Server error: {e}")

    server_thread = threading.Thread(target=run_server, daemon=True)
    server_thread.start()

