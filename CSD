                bankData = fallbackSubj;
                const randomTopic = fallbackSubj.topics[Math.floor(Math.random() * fallbackSubj.topics.length)];
                topicDisplay = prompt ? `ប្រធានបទ៖ ${prompt.slice(0, 85)}` : `មេរៀនពង្រឹងសមត្ថភាព៖ ${randomTopic}`;
            }

            document.getElementById('ws-lesson-topic').textContent = topicDisplay;

            const qCount = analysis.qCount;
            let mcCount = 3;
            let fillCount = 3;
            let probCount = 1;

            if (qCount === 5) {
                mcCount = 2;
                fillCount = 2;
                probCount = 1;
            } else if (qCount === 10) {
                mcCount = 4;
                fillCount = 4;
                probCount = Math.min(2, (bankData.problems || []).length || 1);
            }

            // Section I Items (Multiple Choice)
            const mcContainer = document.getElementById('sec-mc-items');
            mcContainer.innerHTML = '';
            const mcPool = [...bankData.mc].sort(() => 0.5 - Math.random()).slice(0, mcCount);
            let akMcHtml = '';

            mcPool.forEach((item, idx) => {
                const khmerNum = ['១', '២', '៣', '៤', '៥'][idx] || (idx + 1);
                mcContainer.innerHTML += `
                    <div class="space-y-0.5">
                        <p contenteditable="true"><strong>${khmerNum}.</strong> ${item.q}</p>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pl-4 text-slate-900 text-[11px]">
                            ${item.opts.map(o => `
                                <label class="flex items-center gap-1.5 cursor-pointer">
                                    <span class="w-3.5 h-3.5 rounded-sm border border-slate-500 inline-block"></span>
                                    <span contenteditable="true">${o}</span>
                                </label>
                            `).join('')}
                        </div>
                    </div>
                `;
                akMcHtml += `<p><strong>សំណួរ ${khmerNum}៖</strong> ចម្លើយត្រូវគឺ <strong>${item.ans}</strong> (${item.exp})</p>`;
            });

            // Section II Items (Fill in Blanks)
            const fillContainer = document.getElementById('sec-fill-items');
            fillContainer.innerHTML = '';
            let fillPool = [...bankData.fill].sort(() => 0.5 - Math.random()).slice(0, fillCount);
            let akFillHtml = '';

            fillPool.forEach((item, idx) => {
                const khmerNum = ['១', '២', '៣', '៤', '៥'][idx] || (idx + 1);
                fillContainer.innerHTML += `
                    <div class="flex items-baseline gap-2">
                        <span><strong>${khmerNum}.</strong> ${item.q}</span>
                        <span class="border-b border-dotted border-slate-600 flex-grow min-w-[70px] h-4 inline-block"></span>
                        ${item.suffix ? `<span>${item.suffix}</span>` : ''}
                    </div>
                `;
                akFillHtml += `<p><strong>សំណួរ ${khmerNum}៖</strong> ${item.ans}</p>`;
            });

            // Section III Items (Problems / Work Out)
            const probContainer = document.getElementById('sec-prob-items');
            probContainer.innerHTML = '';
            let probPool = [...bankData.problems].sort(() => 0.5 - Math.random()).slice(0, probCount);

            // If teacher prompt contains quoted custom words, inject custom sentence construction task!
            if (analysis.quotedMatches && analysis.quotedMatches.length > 0) {
                const wordsList = analysis.quotedMatches.map(w => `«${w}»`).join(' ');
                const customProb = {
                    q: `ចូរប្អូនសរសេរបង្កើតល្បះចំនួន <strong>${analysis.quotedMatches.length} ល្បះ</strong> ដោយប្រើពាក្យខាងក្រោមឱ្យមានន័យពេញលេញត្រឹមត្រូវ៖ <strong>${wordsList}</strong>`,
                    solution: analysis.quotedMatches.map((w, i) => `${i + 1}. ពាក្យ «${w}»៖ តែងជាល្បះឱ្យស្របតាមគំនិត និងអត្ថន័យនៃពាក្យ។`).join('\n')
                };
                probPool = [customProb];
            }

            let akProbHtml = '';
            const linesPerProb = probPool.length > 1 ? Math.max(4, Math.floor(currentWorkLinesCount / 2)) : currentWorkLinesCount;

            probPool.forEach((item, idx) => {
                const probLabel = probPool.length > 1 ? `<strong>ចំណោទ/កិច្ចការទី ${['១', '២', '៣'][idx]}៖</strong> ` : `<strong>ចំណោទ៖</strong> `;
                probContainer.innerHTML += `
                    <div class="space-y-1.5 flex-grow flex flex-col">
                        <p contenteditable="true" class="font-medium text-slate-900">${probLabel}${item.q}</p>
                        <div class="p-3 border border-slate-300 rounded-lg flex-grow flex flex-col bg-slate-50/30">
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-[10px] font-bold text-slate-600">ដំណោះស្រាយ (Show your work)៖</span>
                                <span class="text-[9px] text-slate-400 italic">បង្ហាញប្រមាណវិធី ឬសរសេរចម្លើយលម្អិត</span>
                            </div>
                            <div class="flex-grow flex flex-col justify-between py-1 ${probPool.length > 1 ? 'min-h-[110px]' : 'min-h-[180px]'} student-work-lines">
                                ${generateDottedLines(linesPerProb)}
                            </div>
                        </div>
                    </div>
                `;
                akProbHtml += `<p><strong>ដំណោះស្រាយ ${probPool.length > 1 ? (idx + 1) : ''}៖</strong></p><pre class="khmer-font whitespace-pre-line pl-4 text-slate-800">${item.solution}</pre>`;
            });

            // Update Answer Key Page
            const akBody = document.getElementById('ak-body');
            akBody.innerHTML = `
                <div class="p-3 bg-indigo-50/60 rounded-xl border border-indigo-100 space-y-1">
                    <h4 class="font-bold text-indigo-950">ផ្នែកទី ១៖ ចម្លើយពហុជ្រើសរើស (${mcPool.length} ពិន្ទុ)</h4>
                    ${akMcHtml}
                </div>
                <div class="p-3 bg-emerald-50/60 rounded-xl border border-emerald-100 space-y-1">
                    <h4 class="font-bold text-emerald-950">ផ្នែកទី ២៖ ចម្លើយបំពេញចន្លោះ (${fillPool.length} ពិន្ទុ)</h4>
                    ${akFillHtml}
                </div>
                <div class="p-3 bg-amber-50/60 rounded-xl border border-amber-100 space-y-1">
                    <h4 class="font-bold text-amber-950">ផ្នែកទី ៣៖ ដំណោះស្រាយចំណោទ (${probPool.length > 1 ? '៤' : '៣'} ពិន្ទុ)</h4>
                    ${akProbHtml}
                </div>
            `;
        }


        // Reset Worksheet to Default state
        function resetWorksheetToDefault() {
            document.getElementById('ai-prompt-input').value = '';
            document.getElementById('cfg-subject').value = 'គណិតវិទ្យា';
            document.getElementById('cfg-grade').value = 'ថ្នាក់ទី ៤';
            buildGeneratedContent('', 'គណិតវិទ្យា', 'ថ្នាក់ទី ៤');
            syncWorksheetHeader();
        }

        // On Page Load
        window.onload = function() {
            try {
                const s = localStorage.getItem('csd-ws-school');
                const t = localStorage.getItem('csd-ws-teacher');
                if (s) document.getElementById('cfg-school').value = s;
                if (t) document.getElementById('cfg-teacher').value = t;
            } catch (e) {}

            syncWorksheetHeader();
            updateProUI();
            updateAIEngineUI();
            renderAllWorkLines();

            // Periodic license check with server
            const apiBase = (window.location.protocol.startsWith('http') && window.location.port === '8000') ? window.location.origin : 'http://127.0.0.1:8000';
            const licRaw = localStorage.getItem('csd-active-license');
            if (licRaw) {
                try {
                    const lic = JSON.parse(licRaw);
                    if (lic && lic.key) {
                        fetch(apiBase + '/api/check_license?key=' + encodeURIComponent(lic.key))
                            .then(r => r.json())
                            .then(d => {
                                if (d && (d.status === 'disabled' || d.disabled === true || d.status === 'unknown')) {
                                    localStorage.removeItem('csd-active-license');
                                    try {
                                        const u = typeof getActiveWorksheetUser === 'function' ? getActiveWorksheetUser() : null;
                                        if (u && !(typeof isWorksheetAdmin === 'function' && isWorksheetAdmin(u))) {
                                            u.isPremium = false;
                                            u.licenseKey = null;
                                            u.premiumPlan = null;
                                            localStorage.removeItem('csd_user_license_' + u.id);
                                            const accsRaw = localStorage.getItem('khmer-accounts-v1');
                                            if (accsRaw) {
                                                const accs = JSON.parse(accsRaw);
                                                const target = accs.find(a => a.id === u.id);
                                                if (target) {
                                                    target.isPremium = false;
                                                    target.licenseKey = null;
                                                    target.premiumPlan = null;
                                                    localStorage.setItem('khmer-accounts-v1', JSON.stringify(accs));
                                                }
                                            }
                                        }
                                    } catch (e) {}
                                    updateProUI();
                                } else if (d && d.status === 'active') {
                                    updateProUI();
                                }
                            })
                            .catch(() => {});
                    }
                } catch (e) {}
            }
        };
