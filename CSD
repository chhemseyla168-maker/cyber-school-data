        window.getCurrentUser = function() {
            try {
                if (typeof window.currentUser !== 'undefined' && window.currentUser) {
                    return window.currentUser;
                }
                let id = null;
                try { id = sessionStorage.getItem('csd-session') || localStorage.getItem('csd-session'); } catch (e) {}
                if (!id) return null;
                let cleanId = id;
                if (typeof id === 'string' && id.startsWith('{')) {
                    try { const p = JSON.parse(id); cleanId = p.id || cleanId; } catch(e){}
                }
                const accsRaw = localStorage.getItem('khmer-accounts-v1');
                if (!accsRaw) return null;
                const accs = JSON.parse(accsRaw);
                if (!Array.isArray(accs)) return null;
                const found = accs.find(a => a.id === cleanId) || null;
                if (found) {
                    window.currentUser = found;
                }
                return found;
            } catch (e) {
                return null;
            }
        };

        window.isUserTheAdmin = function(user) {
            user = user || window.getCurrentUser();
            if (!user) return false;
            if (user.role === 'admin' || user.isAdmin === true || user.id === 'admin') return true;
            const uname = (user.username || '').trim().toLowerCase();
            if (!uname) return false;
            if (uname === 'admin') return true;
            try {
                const a = JSON.parse(localStorage.getItem('csd-admin-auth') || 'null');
                if (a && a.username && a.username.trim().toLowerCase() === uname) return true;
            } catch(e) {}
            return false;
