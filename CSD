    has_photo = 'photo' in msg
    has_document = 'document' in msg
    media_group_id = msg.get('media_group_id')

    # Unique message identifier
    msg_unique_id = f"{chat_id}_{msg_id}"
    if msg_unique_id in processed_message_ids:
        return
    processed_message_ids.add(msg_unique_id)

    # If part of an album/media group, avoid multiple triggers for the same album
    if media_group_id:
        if media_group_id in processed_media_groups:
            print(f"[{time.strftime('%X')}] Skipping additional photo in album {media_group_id}")
            return
        processed_media_groups.add(media_group_id)

    print(f"[{time.strftime('%X')}] Message from {user_name} ({chat_id}) | Photo: {has_photo} | Doc: {has_document} | Text: {text[:45]}...")

