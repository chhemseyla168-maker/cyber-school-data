        function applyFilterAndRender() {
            const query = (document.getElementById('search-input').value || '').trim().toLowerCase();
            const schoolFilter = document.getElementById('filter-school').value;
            const roleFilter = document.getElementById('filter-role').value;

            filteredAccounts = accounts.filter(acc => {
                const t = teachers.find(x => x.id === acc.teacherId) || {};
                const usernameMatch = (acc.username || '').toLowerCase().includes(query);
                const phoneMatch = normPhone(acc.phone || '').includes(normPhone(query)) || (acc.phone || '').includes(query);
                const teacherNameMatch = (t.name || '').toLowerCase().includes(query);
                const schoolMatch = (t.school || '').toLowerCase().includes(query);
                const classMatch = (t.className || '').toLowerCase().includes(query);

                const matchesSearch = !query || usernameMatch || phoneMatch || teacherNameMatch || schoolMatch || classMatch;
                const matchesSchool = !schoolFilter || t.school === schoolFilter;

                let matchesRole = true;
                if (roleFilter === 'admin') matchesRole = isAccountAdmin(acc);
                else if (roleFilter === 'user') matchesRole = !isAccountAdmin(acc);

                return matchesSearch && matchesSchool && matchesRole;
            });

            document.getElementById('filtered-count-badge').innerText = `${filteredAccounts.length} នាក់`;
            renderTable(filteredAccounts);
            renderMobileCards(filteredAccounts);

            const emptyEl = document.getElementById('empty-state');
            if (emptyEl) {
                emptyEl.classList.toggle('hidden', filteredAccounts.length > 0);
            }
        }

        
