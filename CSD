        // Live Order Polling: Polls /api/check_order until Admin clicks Approve or Reject
        function startOrderApprovalPolling(orderId, planKey, name, school) {
            stopOrderApprovalPolling();

            orderPollSeconds = 0;
            const timerEl = document.getElementById('waiting-poll-timer');
            const pollStatusEl = document.getElementById('waiting-poll-status');

            orderPollTimerInterval = setInterval(() => {
                orderPollSeconds++;
                const mins = String(Math.floor(orderPollSeconds / 60)).padStart(2, '0');
                const secs = String(orderPollSeconds % 60).padStart(2, '0');
                if (timerEl) timerEl.textContent = `${mins}:${secs}`;
            }, 1000);

            const apiBase = getCsdApiBase();

            const pollFn = () => {
                fetch(`${apiBase}/api/check_order?order_id=${encodeURIComponent(orderId)}`)
                    .then(r => r.json())
                    .then(data => {
                        if (!data) return;

                        if (pollStatusEl) pollStatusEl.textContent = 'កំពុងភ្ជាប់ផ្ទៀងផ្ទាត់ជាមួយ Server (OK)';

                        if (data.status === 'approved' && data.key) {
                            // Admin clicked Approve in Telegram!
                            stopOrderApprovalPolling();
                            closeWaitingApprovalModal();

                            const validatedKey = data.key.trim().toUpperCase();
                            const approvedPlan = (data.plan && data.plan.toLowerCase().includes('month')) ? 'monthly' : ((data.plan && data.plan.toLowerCase().includes('year')) ? 'yearly' : planKey);
                            const activeLicense = {
                                key: validatedKey,
                                plan: approvedPlan,
                                isTrial: false,
                                activatedAt: new Date().toISOString(),
                                user: name || 'លោកគ្រូ អ្នកគ្រូ CSD',
                                school: school || ''
                            };
                            try {
                                localStorage.setItem('csd-active-license', JSON.stringify(activeLicense));
                                syncUserPurchase(false, approvedPlan, validatedKey, activeLicense);
                            } catch (e) {}

                            playChime('success');
                            showToast('🎉 Admin បានផ្ទៀងផ្ទាត់ទឹកប្រាក់ និងអនុម័ត Pro VIP ជោគជ័យ!', 'success');
                            openReceiptModal(false, validatedKey, approvedPlan);
                        } else if (data.status === 'rejected') {
                            setWaitingModalState('rejected', data.message);
                        } else {
                            // Still pending verification
                            setWaitingModalState('pending');
                        }
                    })
                    .catch(() => {
                        if (pollStatusEl) pollStatusEl.textContent = 'កំពុងព្យាយាមភ្ជាប់ទៅកាន់ Server...';
                        // STRICT RULE: NEVER unlock Pro on network error! Keep waiting!
                    });
            };

            // First check after 1s, then every 2.5s
            setTimeout(pollFn, 1000);
            orderPollInterval = setInterval(pollFn, 2500);
        }

        function stopOrderApprovalPolling() {
            if (orderPollInterval) {
                clearInterval(orderPollInterval);
                orderPollInterval = null;
            }
            if (orderPollTimerInterval) {
                clearInterval(orderPollTimerInterval);
                orderPollTimerInterval = null;
            }
        }

