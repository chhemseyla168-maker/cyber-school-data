        function gradeFromAvg(avg) {
            avg = parseFloat(avg);
            return avg >= 8 ? "A" : (avg >= 7 ? "B" : (avg >= 6 ? "C" : (avg >= 5 ? "D" : "E")));
        }
        const GRADE_REMARK = { A: "ល្អណាស់", B: "ល្អ", C: "ល្អបង្គួរ", D: "មធ្យម", E: "ខ្សោយ" };

        // Same formula as the 10-month gradebook (screen 06)
        function computeMonthResults(monthId) {
            return students.map(s => {
                const g = (gradesData[monthId] && gradesData[monthId][s.id]) || {};
                const v = k => parseFloat(g[k]) || 0;
                const total = v('khmer_listen') + v('khmer_write') + v('khmer_read') + v('khmer_speak') + v('math') + v('science') + v('social') + v('hygiene') + v('health');
                return { student: s, total, avg: total / 9 };
            });
        }
        // Same formula as the semester sheet (screen 07)
        function computeSemesterResults(sem) {
            return students.map(s => {
                const r = semResultOf(sem, s.id);
                return { student: s, total: r.score * 9, avg: r.score };
            });
        }
        function computeExamResults(sem) {
            return students.map(s => {
                const t = examTotalOf(sem, s.id);
                return { student: s, total: t, avg: t / 9 };
            });
        }
        function computeYearResults() {
            return students.map(s => {
                const r = yearResultOf(s.id);
                return { student: s, total: r.score * 9, avg: r.score };
            });
        }

