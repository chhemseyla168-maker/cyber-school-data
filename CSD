            document.querySelectorAll('.step-btn').forEach(btn => {
                btn.classList.remove('bg-indigo-800', 'text-white', 'border', 'border-indigo-600');
                btn.classList.add('bg-indigo-950', 'text-indigo-300');
            });
            const activeBtn = document.getElementById(`btn-${screenId}`);
            if(activeBtn) {
                activeBtn.classList.remove('bg-indigo-950', 'text-indigo-300');
                activeBtn.classList.add('bg-indigo-800', 'text-white', 'border', 'border-indigo-600');
