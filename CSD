const SEVEN_DAYS_MS = 7 * 24 * 60 * 60 * 1000;

function getActiveLessonPlanUser() {
  try {
    let accId = null;
    try { accId = sessionStorage.getItem('csd-session') || localStorage.getItem('csd-session'); } catch (e) {}
    if (!accId) return null;
    let cleanId = accId;
    if (typeof accId === 'string' && accId.startsWith('{')) {
      try { const parsed = JSON.parse(accId); cleanId = parsed.id || cleanId; } catch(e){}
    }
    const accsRaw = localStorage.getItem('khmer-accounts-v1');
    if (!accsRaw) return null;
    const accs = JSON.parse(accsRaw);
    if (!Array.isArray(accs)) return null;
    return accs.find(a => a.id === cleanId || a.username === cleanId) || null;
  } catch (e) {
    return null;
  }
}

function isLessonPlanAdmin(user) {
  if (!user) return false;
  if (user.role === 'admin' || user.isAdmin === true) return true;
  const uname = (user.username || '').trim().toLowerCase();
  if (uname === 'admin' || user.phone === '012345678' || user.phone === '0969999999') return true;
  try {
    const a = JSON.parse(localStorage.getItem('csd-admin-auth') || 'null');
    if (a && a.username && a.username.trim().toLowerCase() === uname && a.hash) return true;
  } catch(e) {}
  return false;
}

function resetLessonPlanTrialUser(user) {
  try {
    if (!user) return;
    if (isLessonPlanAdmin(user) || user.isPremium) return;

    user.trialUsed = true;
    user.isPremium = false;
    user.license = null;

    try {
      localStorage.removeItem('csd_user_license_' + user.id);
      localStorage.removeItem('csd-active-license');
    } catch (e) {}

    const accsRaw = localStorage.getItem('khmer-accounts-v1');
    if (accsRaw) {
      const accs = JSON.parse(accsRaw);
      const target = accs.find(a => a.id === user.id);
      if (target) {
        target.trialUsed = true;
        target.isPremium = false;
        target.license = null;
        localStorage.setItem('khmer-accounts-v1', JSON.stringify(accs));
      }
    }
  } catch (e) {}
}

function isProUser() {
  try {
    const user = getActiveLessonPlanUser();
    if (user) {
      // 1. Admin unconditional bypass
      if (isLessonPlanAdmin(user)) {
        return true;
      }
      // 2. Paid Premium Member
      if (user.isPremium) {
        return true;
      }
      // 3. 7-Day Trial Member
      if (user.trialStartedAt) {
        const elapsed = Date.now() - Number(user.trialStartedAt);
        if (elapsed >= 0 && elapsed < SEVEN_DAYS_MS) {
          return true;
        } else {
          resetLessonPlanTrialUser(user);
          return false;
        }
      }
      // Normal user without trial or subscription
      return false;
    }

    // Fallback: Browser active license
    const licRaw = localStorage.getItem('csd-active-license');
    if (!licRaw) return false;
    const lic = JSON.parse(licRaw);
    if (!lic || !lic.key || lic.disabled) return false;
    if (lic.isTrial && lic.expiresAt && Date.now() > Number(lic.expiresAt)) return false;
    return true;
  } catch (e) {
    return false;
  }
}

