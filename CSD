    <!-- LOGIC & SCRIPTS                                                           -->
    <!-- ========================================================================= -->
    <script>
        // Storage keys
        const ACC_KEY = 'khmer-accounts-v1';
        const TEACHER_KEY = 'khmer-teacher-profiles';
        const CLASS_KEY = 'khmer-teacher-classes';
        const THEME_KEY = 'khmer-teacher-theme';
        const ADMIN_AUTH_KEY = 'csd-admin-auth';
        const ADMIN_SESSION_KEY = 'csd-admin-session';
        const APP_SESSION_KEY = 'csd-session';
        const PBKDF2_ITER = 100000;

        // In-memory data
        let accounts = [];
        let teachers = [];
        let extraClasses = [];
        let filteredAccounts = [];

        // Cryptography Helpers (Exact match to ai_teach_ios27_darkmode.html)
        const toHex = b => Array.from(b, x => x.toString(16).padStart(2, '0')).join('');
        const fromHex = h => new Uint8Array((h.match(/.{2}/g) || []).map(x => parseInt(x, 16)));
        const rnd = n => crypto.getRandomValues(new Uint8Array(n));
        const hasSubtle = () => !!(window.crypto && crypto.subtle);

        async function hashWith(pw, saltHex, alg) {
            if (alg === 'pbkdf2' && hasSubtle()) {
                const k = await crypto.subtle.importKey('raw', new TextEncoder().encode(pw), 'PBKDF2', false, ['deriveBits']);
                const bits = await crypto.subtle.deriveBits({ name: 'PBKDF2', salt: fromHex(saltHex), iterations: PBKDF2_ITER, hash: 'SHA-256' }, k, 256);
                return toHex(new Uint8Array(bits));
            }
            let h = 0x811c9dc5; const s = saltHex + ':' + pw;
            for (let r = 0; r < 5000; r++) for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); }
            return 'fb' + (h >>> 0).toString(16);
        }

        async function makeCred(pw) {
            const salt = toHex(rnd(16)), alg = hasSubtle() ? 'pbkdf2' : 'fb';
            return { salt, alg, hash: await hashWith(pw, salt, alg) };
        }

        async function verifyPw(pw, cred) {
            if (!cred || !cred.hash) return false;
            return (await hashWith(pw, cred.salt, cred.alg)) === cred.hash;
        }

        // Phone normalization
        function normPhone(raw) {
            let d = String(raw || '').replace(/[០-៩]/g, c => String(c.charCodeAt(0) - 0x17E0)).replace(/[^\d]/g, '');
            if (d.startsWith('00')) d = d.slice(2); else if (d.startsWith('0')) d = '855' + d.slice(1);
            return d;
        }
        function displayPhone(p) {
            if (!p) return '-';
            const s = String(p).trim();
            if (s.startsWith('855')) return '0' + s.slice(3);
            return s;
        }

        // Check if an account has admin rights
        function isAccountAdmin(acc) {
            if (!acc) return false;
            let adminName = 'admin';
            try {
                const a = JSON.parse(localStorage.getItem(ADMIN_AUTH_KEY) || 'null');
                if (a && a.username) adminName = a.username.trim().toLowerCase();
            } catch (e) {}
            const uname = (acc.username || '').trim().toLowerCase();
            return acc.isAdmin === true || acc.role === 'admin' || uname === 'admin' || uname === adminName;
        }

        // -------------------------------------------------------------------------
        // ADMIN AUTHENTICATION GATE (UNIFIED SYSTEM)
        // -------------------------------------------------------------------------
        async function getOrInitAdminAuth() {
            let auth = null;
            try {
                auth = JSON.parse(localStorage.getItem(ADMIN_AUTH_KEY) || 'null');
            } catch (e) {}

            if (!auth || !auth.hash) {
                const cred = await makeCred('admin123');
                auth = {
                    username: 'admin',
                    salt: cred.salt,
                    alg: cred.alg,
                    hash: cred.hash,
                    updatedAt: new Date().toISOString()
                };
                localStorage.setItem(ADMIN_AUTH_KEY, JSON.stringify(auth));
            }
            return auth;
        }

        function getActiveAppUser() {
            let accId = null;
            try {
                accId = sessionStorage.getItem(APP_SESSION_KEY) || localStorage.getItem(APP_SESSION_KEY);
            } catch (e) {}
            if (!accId) return null;
            return accounts.find(a => a.id === accId);
        }

        async function handleAdminLogin(e) {
            e.preventDefault();
            const btn = document.getElementById('admin-login-btn');
            const errEl = document.getElementById('admin-login-err');
            errEl.classList.add('hidden');
            errEl.innerText = '';
            btn.disabled = true;
            btn.innerHTML = '⏳ កំពុងផ្ទៀងផ្ទាត់...';

            try {
                const userInp = (document.getElementById('admin-login-user').value || '').trim();
                const passInp = (document.getElementById('admin-login-pass').value || '').trim();

                if (!userInp || !passInp) throw new Error('សូមបញ្ចូល Username និង Password');

                // 1. Check Master Admin Credentials
                const masterAuth = await getOrInitAdminAuth();
                if ((masterAuth.username || '').toLowerCase() === userInp.toLowerCase()) {
                    const isPassOk = await verifyPw(passInp, masterAuth);
                    if (isPassOk) {
                        sessionStorage.setItem(ADMIN_SESSION_KEY, 'active');
                        sessionStorage.setItem('csd-admin-user', masterAuth.username);
                        document.getElementById('admin-login-pass').value = '';
                        checkAdminSession();
                        return showToast('🎉 បានចូលប្រើប្រាស់ជា Master Admin ជោគជ័យ!', 'success');
                    }
                }

                // 2. Check Real User Accounts (e.g. Bora, or any user account in system)
                const matchedAcc = accounts.find(a => (a.username || '').toLowerCase() === userInp.toLowerCase());
                if (matchedAcc) {
                    const isPassOk = await verifyPw(passInp, matchedAcc);
                    if (!isPassOk) {
                        throw new Error('លេខសម្ងាត់មិនត្រឹមត្រូវទេ!');
                    }

                    // Check if this account is granted Admin role
                    if (isAccountAdmin(matchedAcc)) {
                        sessionStorage.setItem(ADMIN_SESSION_KEY, 'active');
                        sessionStorage.setItem('csd-admin-user', matchedAcc.username);
                        document.getElementById('admin-login-pass').value = '';
                        checkAdminSession();
                        return showToast(`🎉 ស្វាគមន៍ Admin @${matchedAcc.username}!`, 'success');
                    } else {
                        throw new Error(`⚠️ គណនី "@${matchedAcc.username}" គឺជា User ធម្មតា មិនទាន់មានសិទ្ធិជា Admin ទេ!`);
                    }
                }

                throw new Error('រកមិនឃើញគណនី ឬលេខសម្ងាត់មិនត្រឹមត្រូវ!');

            } catch (err) {
                errEl.innerText = err.message || 'ការផ្ទៀងផ្ទាត់មិនជោគជ័យ';
                errEl.classList.remove('hidden');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span>🔓</span><span>ចូលប្រើប្រាស់ជា Admin</span>';
            }
        }

        function adminLogout() {
            sessionStorage.removeItem(ADMIN_SESSION_KEY);
            sessionStorage.removeItem('csd-admin-user');
            checkAdminSession();
            showToast('🚪 បានចាកចេញពី Admin រួចរាល់', 'info');
        }

        function checkAdminSession() {
            let isAuth = sessionStorage.getItem(ADMIN_SESSION_KEY) === 'active';
            const adminUser = sessionStorage.getItem('csd-admin-user') || 'Admin';

            // Automatic Single Sign-On from Main App if active user is an Admin
            if (!isAuth) {
                const activeUser = getActiveAppUser();
                if (activeUser && isAccountAdmin(activeUser)) {
                    isAuth = true;
                    sessionStorage.setItem(ADMIN_SESSION_KEY, 'active');
                    sessionStorage.setItem('csd-admin-user', activeUser.username);
                }
            }

            const loginCard = document.getElementById('admin-login-card');
            const dashboardView = document.getElementById('admin-dashboard-view');
            const headerActions = document.getElementById('admin-header-actions');
            const activeAdminTag = document.getElementById('active-admin-tag');

            if (isAuth) {
                loginCard.classList.add('hidden');
                dashboardView.classList.remove('hidden');
                headerActions.classList.remove('hidden');
                headerActions.classList.add('flex');
                if (activeAdminTag) {
                    activeAdminTag.innerText = `🛡️ Admin: @${adminUser}`;
                }
                loadData();
            } else {
                loginCard.classList.remove('hidden');
                dashboardView.classList.add('hidden');
                headerActions.classList.add('hidden');
                headerActions.classList.remove('flex');
                setTimeout(() => {
                    const u = document.getElementById('admin-login-user');
                    if (u) u.focus();
                }, 100);
            }
        }

        // Toggle Admin Role for any user with 1 click
        function toggleUserAdminRole(accId, makeAdmin) {
            const acc = accounts.find(a => a.id === accId);
            if (!acc) return;

            acc.role = makeAdmin ? 'admin' : 'user';
            acc.isAdmin = !!makeAdmin;

            if (makeAdmin) {
                // Admin accounts have full Premium VIP unlocked!
                acc.isPremium = true;
                acc.premiumPlan = 'admin';
                const adminLic = { key: 'CSD-ADMIN-ROOT', plan: 'admin', isTrial: false, lastVerified: Date.now(), user: acc.username, userId: acc.id };
                acc.license = adminLic;
                localStorage.setItem('csd_user_license_' + acc.id, JSON.stringify(adminLic));
            }

            saveData();
            applyFilterAndRender();
            updateKPIs();

            // Cloud sync
            if (typeof window.csdSyncAccountToCloud === 'function') {
                window.csdSyncAccountToCloud(acc);
            }

            if (makeAdmin) {
                showToast(`🛡️ បានតែងតាំង @${acc.username} ជា Admin រួចរាល់! គាត់អាច Login Admin ដោយផ្ទាល់បាន`, 'success');
            } else {
                showToast(`👤 បានដកសិទ្ធិ Admin ពី @${acc.username}`, 'info');
            }
        }

        // Admin Settings Modal (Change Master Admin Password & Username)
        async function openAdminSettingsModal() {
            const auth = await getOrInitAdminAuth();
            document.getElementById('set-admin-username').value = auth.username || 'admin';
            document.getElementById('set-admin-cur-pass').value = '';
            document.getElementById('set-admin-new-pass').value = '';
            document.getElementById('set-admin-conf-pass').value = '';
            document.getElementById('admin-settings-modal').classList.remove('hidden');
        }

        function closeAdminSettingsModal() {
            document.getElementById('admin-settings-modal').classList.add('hidden');
        }

        async function saveAdminSettings(e) {
            e.preventDefault();
            const btn = document.getElementById('save-admin-set-btn');
            btn.disabled = true;
            btn.innerText = '⏳ កំពុងរក្សាទុក...';

            try {
                const newUsername = (document.getElementById('set-admin-username').value || '').trim();
                const curPass = (document.getElementById('set-admin-cur-pass').value || '').trim();
                const newPass = (document.getElementById('set-admin-new-pass').value || '').trim();
                const confPass = (document.getElementById('set-admin-conf-pass').value || '').trim();

                if (!newUsername) throw new Error('សូមបញ្ចូលឈ្មោះ Admin Username');
                if (!curPass) throw new Error('សូមបញ្ចូលលេខសម្ងាត់ចាស់ដើម្បីបញ្ជាក់');
                if (newPass.length < 6) throw new Error('លេខសម្ងាត់ថ្មីត្រូវមានយ៉ាងហោច ៦ ខ្ទង់');
                if (newPass !== confPass) throw new Error('លេខសម្ងាត់ថ្មីទាំងពីរមិនដូចគ្នាទេ');

                const auth = await getOrInitAdminAuth();
                const isPassValid = await verifyPw(curPass, auth);
                if (!isPassValid) throw new Error('លេខសម្ងាត់បច្ចុប្បន្នមិនត្រឹមត្រូវទេ!');

                const cred = await makeCred(newPass);
                auth.username = newUsername;
                auth.salt = cred.salt;
                auth.alg = cred.alg;
                auth.hash = cred.hash;
                auth.updatedAt = new Date().toISOString();

                localStorage.setItem(ADMIN_AUTH_KEY, JSON.stringify(auth));

                closeAdminSettingsModal();
                showToast('✅ បានប្តូរព័ត៌មានគណនី Master Admin ដោយជោគជ័យ!', 'success');
            } catch (err) {
                showToast(err.message, 'error');
            } finally {
                btn.disabled = false;
                btn.innerText = '💾 រក្សាទុក';
            }
        }

