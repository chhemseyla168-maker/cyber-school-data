function save(){
  try{const o={steps};IDS.forEach(id=>o[id]=$(id).value);localStorage.setItem(KEY,JSON.stringify(o))}catch(e){}
}
function load(){
  try{
    const o=JSON.parse(localStorage.getItem(KEY)||"null"); if(!o) return;
    IDS.forEach(id=>{if(o[id]!==undefined)$(id).value=o[id]});
    if(Array.isArray(o.steps)&&o.steps.length) steps=o.steps;
  }catch(e){}
}
