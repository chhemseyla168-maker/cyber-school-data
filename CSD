            // 1. Admin always has full Pro rights UNLOCKED
            if (window.isUserTheAdmin(user)) {
                const adminLic = { key: 'CSD-ADMIN-ROOT', plan: 'admin', isTrial: false, lastVerified: Date.now(), user: user.username, userId: user.id };
                localStorage.setItem('csd-active-license', JSON.stringify(adminLic));
                localStorage.setItem('csd_user_license_' + user.id, JSON.stringify(adminLic));
                return;
            }

            // 2. Paid Premium User
            if (user.isPremium) {
                const lic = user.license || { key: user.licenseKey || 'CSD-PREMIUM', plan: user.licensePlan || 'yearly', isTrial: false, lastVerified: Date.now(), user: user.username, userId: user.id };
                localStorage.setItem('csd-active-license', JSON.stringify(lic));
                localStorage.setItem('csd_user_license_' + user.id, JSON.stringify(lic));
                return;
            }

            // 3. User on Active 7-Day Trial
            if (user.trialStartedAt) {
                const elapsed = Date.now() - Number(user.trialStartedAt);
                if (elapsed >= 0 && elapsed < SEVEN_DAYS_MS) {
                    const trialLic = user.license || {
                        key: `CSD-TRIAL-${(user.username || 'USER').toUpperCase()}`,
                        plan: 'trial',
                        isTrial: true,
                        startedAt: user.trialStartedAt,
                        expiresAt: user.trialExpiresAt || (user.trialStartedAt + SEVEN_DAYS_MS),
                        lastVerified: Date.now(),
