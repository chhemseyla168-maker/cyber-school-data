            renderSemesterTable();
        }

        // ===== Scores: monthly average, exam average, semester & yearly results =====
        const SEM_MONTHS = {
            1: ["Nov 2026", "Dec 2026", "Jan 2027", "Feb 2027", "Mar 2027"],
            2: ["Apr 2027", "May 2027", "Jun 2027", "Jul 2027", "Aug 2027"]
        };
        // the 9 subjects counted in the total (same as the monthly gradebook)
        const COUNT_KEYS = ['khmer_listen', 'khmer_write', 'khmer_read', 'khmer_speak', 'math', 'science', 'social', 'hygiene', 'health'];
        // all 12 input columns of the exam tables (same layout as the monthly gradebook)
        const EXAM_COLS = [
            ['khmer_listen', 'bg-yellow-50'], ['khmer_write', 'bg-yellow-50'], ['khmer_read', 'bg-yellow-50'], ['khmer_speak', 'bg-yellow-50'],
            ['math', 'bg-yellow-100 font-semibold'], ['science', 'bg-emerald-50'], ['social', 'bg-sky-50'],
            ['health', 'bg-pink-50'], ['hygiene', 'bg-pink-50'], ['fitness', 'bg-pink-50'],
            ['home_art', 'bg-purple-50'], ['pe', 'bg-orange-50']
        ];
        const numOr = (v, d) => { const n = parseFloat(v); return isFinite(n) ? n : d; };

        function monthAvgOf(mId, sid) {
            const g = (gradesData[mId] && gradesData[mId][sid]) || {};
            let t = 0;
            COUNT_KEYS.forEach(k => { t += numOr(g[k], 8); });
            return t / 9;
        }
        function getExam(sem, sid) {
            if (!semesterExamData[sem]) semesterExamData[sem] = {};
            const e = semesterExamData[sem][sid] || {};
            const o = {};
            EXAM_COLS.forEach(([k]) => { o[k] = numOr(e[k], 8); });
            return o;
        }
        function examTotalOf(sem, sid) {
            const e = getExam(sem, sid);
            let t = 0;
            COUNT_KEYS.forEach(k => { t += e[k]; });
            return t;
        }
        // (average of the 5 monthly averages + exam average) / 2
        function semResultOf(sem, sid) {
            const monthly = SEM_MONTHS[sem].reduce((a, m) => a + monthAvgOf(m, sid), 0) / 5;
            const exam = examTotalOf(sem, sid) / 9;
            return { monthly, exam, score: (monthly + exam) / 2 };
        }
        // (semester 1 + semester 2) / 2
        function yearResultOf(sid) {
            const s1 = semResultOf(1, sid).score, s2 = semResultOf(2, sid).score;
            return { s1, s2, score: (s1 + s2) / 2 };
        }
        function rankList(list, key) {
            list.sort((a, b) => b[key] - a[key]);
            let lastV = null, lastR = 0;
            list.forEach((it, i) => {
                const v = Math.round(it[key] * 100);
                it.rank = v === lastV ? lastR : i + 1;
                lastV = v; lastR = it.rank;
            });
            return list;
        }

