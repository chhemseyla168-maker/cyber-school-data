                        userId: user.id
                    };
                    localStorage.setItem('csd-active-license', JSON.stringify(trialLic));
                    localStorage.setItem('csd_user_license_' + user.id, JSON.stringify(trialLic));
                    return;
                } else {
                    window.resetTrialUserToNormal(user);
                    return;
                }
