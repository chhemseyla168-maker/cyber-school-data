                    const elapsed = Date.now() - Number(user.trialStartedAt);
                    if (elapsed >= 0 && elapsed < SEVEN_DAYS_MS) {
                        return true;
                    } else {
                        // Reached 7th day: Auto reset to normal
                        window.resetTrialUserToNormal(user);
                        return false;
                    }
                }

                // 4. Fallback to browser active license if present and valid
                const licRaw = localStorage.getItem('csd-active-license');
                if (licRaw) {
                    try {
                        const lic = JSON.parse(licRaw);
                        if (lic && lic.key && !lic.disabled) {
