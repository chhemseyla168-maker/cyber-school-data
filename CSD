        async function saveUserChanges(e) {
            e.preventDefault();
            const btn = document.getElementById('save-user-btn');
            btn.disabled = true;
            btn.innerHTML = '⏳ កំពុងរក្សាទុក...';

            try {
                const accId = document.getElementById('edit-acc-id').value;
                const teacherId = document.getElementById('edit-teacher-id').value;
                const newUsername = (document.getElementById('edit-username').value || '').trim();
                const newRole = document.getElementById('edit-role').value;
                const rawPhone = (document.getElementById('edit-phone').value || '').trim();
                const normalizedPhone = normPhone(rawPhone);
                const newPassword = (document.getElementById('edit-password').value || '').trim();
                const teacherName = (document.getElementById('edit-teacher-name').value || '').trim();
                const teacherSex = document.getElementById('edit-teacher-sex').value;
                const schoolName = (document.getElementById('edit-school').value || '').trim();
                const className = (document.getElementById('edit-class').value || '').trim();

                if (!newUsername) throw new Error('សូមបញ្ចូលឈ្មោះគណនី (Username)');
                if (!rawPhone || !normalizedPhone) throw new Error('សូមបញ្ចូលលេខទូរស័ព្ទត្រឹមត្រូវ');

                // Duplicate Check (Username)
                const dupUser = accounts.find(a => a.id !== accId && (a.username || '').toLowerCase() === newUsername.toLowerCase());
                if (dupUser) throw new Error(`ឈ្មោះ ${newUsername} នេះត្រូវបានប្រើរួចហើយ`);

                // Duplicate Check (Phone)
                const dupPhone = accounts.find(a => a.id !== accId && normPhone(a.phone) === normalizedPhone);
                if (dupPhone) throw new Error(`លេខទូរស័ព្ទ ${rawPhone} នេះត្រូវបានប្រើរួចហើយ`);

                const acc = accounts.find(a => a.id === accId);
                if (!acc) throw new Error('រកមិនឃើញគណនី');

                acc.username = newUsername;
                acc.phone = normalizedPhone;
                acc.role = newRole;
                acc.isAdmin = (newRole === 'admin');

                // Process Membership Plan & Trial Reset
                const selectedPlan = (document.getElementById('edit-membership-plan') ? document.getElementById('edit-membership-plan').value : 'free');
                const resetTrialChecked = document.getElementById('edit-reset-trial') ? document.getElementById('edit-reset-trial').checked : false;
                const now = Date.now();
                const SEVEN_DAYS = 7 * 24 * 60 * 60 * 1000;

                if (resetTrialChecked) {
                    acc.trialUsed = false;
                    acc.trialStartedAt = null;
                    acc.trialExpiresAt = null;
                }

                if (acc.isAdmin || acc.role === 'admin' || isAccountAdmin(acc)) {
                    // Admin accounts are unconditionally full Premium VIP
                    acc.isPremium = true;
                    acc.premiumPlan = 'admin';
                    const adminLic = { key: 'CSD-ADMIN-ROOT', plan: 'admin', isTrial: false, lastVerified: now, user: acc.username, userId: acc.id };
                    acc.license = adminLic;
                    localStorage.setItem('csd_user_license_' + acc.id, JSON.stringify(adminLic));
                } else if (selectedPlan === 'yearly' || selectedPlan === 'monthly') {
                    acc.isPremium = true;
                    acc.premiumPlan = selectedPlan;
                    acc.licenseKey = acc.licenseKey || `CSD-${selectedPlan.toUpperCase()}-${Math.random().toString(36).substring(2,6).toUpperCase()}-2026`;
                    const lic = { key: acc.licenseKey, plan: selectedPlan, isTrial: false, lastVerified: now, user: acc.username, userId: acc.id };
                    acc.license = lic;
                    localStorage.setItem('csd_user_license_' + acc.id, JSON.stringify(lic));
                } else if (selectedPlan === 'trial') {
                    acc.isPremium = false;
                    acc.trialUsed = true;
                    acc.trialStartedAt = now;
                    acc.trialExpiresAt = now + SEVEN_DAYS;
                    const lic = { key: `CSD-TRIAL-${acc.username.toUpperCase()}-2026`, plan: 'trial', isTrial: true, startedAt: now, expiresAt: now + SEVEN_DAYS, lastVerified: now, user: acc.username, userId: acc.id };
                    acc.license = lic;
                    localStorage.setItem('csd_user_license_' + acc.id, JSON.stringify(lic));
                } else if (selectedPlan === 'free') {
                    acc.isPremium = false;
                    acc.trialStartedAt = null;
                    acc.trialExpiresAt = null;
                    localStorage.removeItem('csd_user_license_' + acc.id);
                }

                // If this is current user session, sync csd-active-license
                let activeAccId = null;
                try { activeAccId = sessionStorage.getItem('csd-session') || localStorage.getItem('csd-session'); } catch (e) {}
                if (activeAccId && (activeAccId === acc.id || activeAccId.includes(acc.id))) {
                    if (acc.isPremium || isAccountAdmin(acc) || (acc.trialStartedAt && (now - acc.trialStartedAt < SEVEN_DAYS))) {
                        localStorage.setItem('csd-active-license', JSON.stringify(acc.license || { key: 'CSD-ACTIVE', plan: acc.premiumPlan || 'yearly' }));
                    } else {
                        localStorage.removeItem('csd-active-license');
                    }
                }

                // Update Password if provided
                if (newPassword) {
                    if (newPassword.length < 6) throw new Error('លេខសម្ងាត់ត្រូវមានយ៉ាងតិច ៦ ខ្ទង់');
                    const cred = await makeCred(newPassword);
                    acc.salt = cred.salt;
                    acc.alg = cred.alg;
                    acc.hash = cred.hash;
                }

                // Update Teacher Profile
                let t = teachers.find(x => x.id === teacherId);
                if (!t) {
                    t = { id: teacherId, name: teacherName || newUsername, sex: teacherSex, school: schoolName, className: className };
                    teachers.push(t);
                } else {
                    t.name = teacherName || newUsername;
                    t.sex = teacherSex;
                    t.school = schoolName;
                    t.className = className;
                }

                // Add to extra classes if new
                if (className && !extraClasses.includes(className)) {
                    extraClasses.push(className);
                }

                saveData();

                // Trigger Supabase Cloud Sync
                if (typeof window.csdSyncAccountToCloud === 'function') {
                    await window.csdSyncAccountToCloud(acc);
                }

                closeEditModal();
                loadData();
                showToast('✅ បានកែប្រែព័ត៌មានអ្នកប្រើដោយជោគជ័យ!', 'success');

            } catch (err) {
                showToast(err.message || 'បរាជ័យក្នុងការរក្សាទុក', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '💾 រក្សាទុកការកែប្រែ';
            }
        }

        // -------------------------------------------------------------------------
        // QUICK CHANGE PASSWORD MODAL LOGIC
        // -------------------------------------------------------------------------
        function openPasswordModal(accId) {
            const acc = accounts.find(a => a.id === accId);
            if (!acc) return showToast('រកមិនឃើញគណនី', 'error');

            document.getElementById('pw-acc-id').value = acc.id;
            document.getElementById('pw-modal-user').innerText = `User: @${acc.username} (${displayPhone(acc.phone)})`;
            document.getElementById('quick-new-password').value = '';
            document.getElementById('quick-confirm-password').value = '';
            document.getElementById('password-modal').classList.remove('hidden');
        }

        function closePasswordModal() {
            document.getElementById('password-modal').classList.add('hidden');
        }

        async function saveQuickPassword(e) {
            e.preventDefault();
            try {
                const accId = document.getElementById('pw-acc-id').value;
                const p1 = document.getElementById('quick-new-password').value.trim();
                const p2 = document.getElementById('quick-confirm-password').value.trim();

                if (!p1 || p1.length < 6) throw new Error('លេខសម្ងាត់ត្រូវមានយ៉ាងហោចណាស់ ៦ ខ្ទង់');
                if (p1 !== p2) throw new Error('លេខសម្ងាត់ទាំងពីរមិនដូចគ្នាទេ');

                const acc = accounts.find(a => a.id === accId);
                if (!acc) throw new Error('រកមិនឃើញគណនី');

                const cred = await makeCred(p1);
                acc.salt = cred.salt;
                acc.alg = cred.alg;
                acc.hash = cred.hash;

                saveData();

                if (typeof window.csdSyncAccountToCloud === 'function') {
                    await window.csdSyncAccountToCloud(acc);
                }

                closePasswordModal();
                loadData();
                showToast(`🔒 បានប្តូរលេខសម្ងាត់សម្រាប់ @${acc.username} ដោយជោគជ័យ!`, 'success');
            } catch (err) {
                showToast(err.message, 'error');
            }
        }

        // -------------------------------------------------------------------------
        // ADD NEW USER MODAL LOGIC
        // -------------------------------------------------------------------------
        function openAddModal() {
            document.getElementById('add-user-form').reset();
            document.getElementById('add-modal').classList.remove('hidden');
        }

        function closeAddModal() {
            document.getElementById('add-modal').classList.add('hidden');
        }

        async function createUserAccount(e) {
            e.preventDefault();
            try {
                const username = (document.getElementById('add-username').value || '').trim();
                const role = document.getElementById('add-role').value;
                const rawPhone = (document.getElementById('add-phone').value || '').trim();
                const normalizedPhone = normPhone(rawPhone);
                const password = (document.getElementById('add-password').value || '').trim();
                const teacherName = (document.getElementById('add-teacher-name').value || '').trim();
                const teacherSex = document.getElementById('add-teacher-sex').value;
                const schoolName = (document.getElementById('add-school').value || '').trim();
                const className = (document.getElementById('add-class').value || '').trim() || 'ថ្នាក់ទី ៤ "ក"';

                if (!username) throw new Error('សូមបញ្ចូល Username');
                if (!normalizedPhone) throw new Error('សូមបញ្ចូលលេខទូរស័ព្ទ');
                if (!password || password.length < 6) throw new Error('លេខសម្ងាត់ត្រូវមានយ៉ាងតិច ៦ ខ្ទង់');

                // Duplicate Check
                if (accounts.some(a => (a.username || '').toLowerCase() === username.toLowerCase())) {
                    throw new Error(`ឈ្មោះ @${username} ត្រូវបានប្រើរួចហើយ`);
                }
                if (accounts.some(a => normPhone(a.phone) === normalizedPhone)) {
                    throw new Error(`លេខទូរស័ព្ទ ${rawPhone} ត្រូវបានប្រើរួចហើយ`);
                }

                const cred = await makeCred(password);
                const newTeacherId = 't' + Date.now();
                const newAccId = 'a' + Date.now();

                // Create teacher profile
                const newTeacher = {
                    id: newTeacherId,
                    name: teacherName || username,
                    sex: teacherSex,
                    school: schoolName,
                    className: className
                };
                teachers.push(newTeacher);

                // Create account
                const newAcc = {
                    id: newAccId,
                    username: username,
                    phone: normalizedPhone,
                    salt: cred.salt,
                    alg: cred.alg,
                    hash: cred.hash,
                    teacherId: newTeacherId,
                    role: role,
                    isAdmin: (role === 'admin'),
                    isNewAccount: true,
                    hasSeenWelcomeAd: false
                };
                accounts.push(newAcc);

                if (className && !extraClasses.includes(className)) {
                    extraClasses.push(className);
                }

                saveData();

                // Sync to Cloud
                if (typeof window.csdSyncAccountToCloud === 'function') {
                    await window.csdSyncAccountToCloud(newAcc);
                }

                closeAddModal();
                loadData();
                showToast(`🎉 បានបង្កើតគណនី @${username} (${role === 'admin' ? '🛡️ Admin' : '👤 User'}) ជោគជ័យ!`, 'success');

            } catch (err) {
                showToast(err.message, 'error');
            }
        }

        // -------------------------------------------------------------------------
        // DELETE USER ACCOUNT
        // -------------------------------------------------------------------------
        async function deleteUserAccount(accId) {
            const acc = accounts.find(a => a.id === accId);
            if (!acc) return;

            const conf = confirm(`តើអ្នកពិតជាចង់លុបគណនី @${acc.username} (${displayPhone(acc.phone)}) មែនឬទេ?\n\nការលុបនេះនឹងមិនអាចយកវិញបានឡើយ!`);
            if (!conf) return;

            accounts = accounts.filter(a => a.id !== accId);

            if (typeof window.getSupabaseClient === 'function') {
                const client = window.getSupabaseClient();
                if (client) {
                    try {
                        await client.from('csd_accounts').delete().eq('id', accId);
                    } catch (e) {
                        console.error('Supabase delete error:', e);
                    }
                }
            }

            saveData();
            loadData();
            showToast(`🗑️ បានលុបគណនី @${acc.username} រួចរាល់`, 'info');
        }

        // -------------------------------------------------------------------------
        // CLOUD SYNC & EXPORT
        // -------------------------------------------------------------------------
        async function syncWithCloud() {
            showToast('⏳ កំពុង Sync ទិន្នន័យជាមួយ Supabase Cloud...', 'info');
            try {
                if (typeof window.getSupabaseClient === 'function') {
                    const client = window.getSupabaseClient();
                    if (!client) {
                        throw new Error('Supabase មិនទាន់បានកំណត់ (Config)');
                    }

                    const { data: cloudAccounts, error: accErr } = await client.from('csd_accounts').select('*');
                    if (accErr) throw accErr;

                    const { data: cloudTeachers, error: tErr } = await client.from('csd_teachers').select('*');
                    if (tErr) throw tErr;

                    if (cloudAccounts && Array.isArray(cloudAccounts)) {
                        cloudAccounts.forEach(ca => {
                            const idx = accounts.findIndex(a => a.id === ca.id);
                            const formatted = {
                                id: ca.id,
                                username: ca.username,
                                phone: ca.phone,
                                salt: ca.salt,
                                alg: ca.alg || 'pbkdf2',
                                hash: ca.hash,
                                teacherId: ca.teacher_id,
                                role: ca.role || 'user',
                                isAdmin: (ca.role === 'admin' || !!ca.is_admin),
                                isNewAccount: !!ca.is_new_account,
                                hasSeenWelcomeAd: !!ca.has_seen_welcome_ad
                            };
                            if (idx >= 0) accounts[idx] = { ...accounts[idx], ...formatted };
                            else accounts.push(formatted);
                        });
                    }

                    if (cloudTeachers && Array.isArray(cloudTeachers)) {
                        cloudTeachers.forEach(ct => {
                            const idx = teachers.findIndex(t => t.id === ct.id);
                            const formatted = {
                                id: ct.id,
                                name: ct.name,
                                sex: ct.sex || 'M',
                                school: ct.school || '',
                                className: ct.class_name || '',
                                place: ct.place || ''
                            };
                            if (idx >= 0) teachers[idx] = formatted;
                            else teachers.push(formatted);
                        });
                    }

                    saveData();
                    loadData();
                    showToast('✅ Sync ជាមួយ Supabase Cloud ជោគជ័យ!', 'success');
                    return;
                }
                throw new Error('Supabase client មិនទាន់ស្រេចបាច់');
            } catch (e) {
                showToast(e.message || 'Sync មិនបានជោគជ័យ', 'error');
            }
        }

        function exportDataBackup() {
            const data = {
                exportedAt: new Date().toISOString(),
                accounts: accounts,
                teachers: teachers,
                classes: extraClasses
            };
            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `user_accounts_backup_${Date.now()}.json`;
            a.click();
            URL.revokeObjectURL(url);
            showToast('💾 បានទាញយកឯកសារ Backup ដោយជោគជ័យ', 'success');
        }

        // -------------------------------------------------------------------------
        // THEME & UTILITIES
        // -------------------------------------------------------------------------
        function toggleTheme() {
            const isDark = document.body.classList.contains('dark-mode');
            if (isDark) {
                document.body.classList.remove('dark-mode');
                document.documentElement.classList.remove('dark');
                localStorage.setItem(THEME_KEY, 'light');
                document.getElementById('theme-icon').innerText = '☀️';
            } else {
                document.body.classList.add('dark-mode');
                document.documentElement.classList.add('dark');
                localStorage.setItem(THEME_KEY, 'dark');
                document.getElementById('theme-icon').innerText = '🌙';
            }
        }

        function initTheme() {
            const saved = localStorage.getItem(THEME_KEY);
            if (saved === 'light') {
                document.body.classList.remove('dark-mode');
                document.documentElement.classList.remove('dark');
                document.getElementById('theme-icon').innerText = '☀️';
            } else {
                document.body.classList.add('dark-mode');
                document.documentElement.classList.add('dark');
                document.getElementById('theme-icon').innerText = '🌙';
            }
        }

        function togglePasswordVisibility(inputId, btn) {
            const inp = document.getElementById(inputId);
            if (!inp) return;
            if (inp.type === 'password') {
                inp.type = 'text';
                btn.innerText = '🙈';
            } else {
                inp.type = 'password';
                btn.innerText = '👁️';
            }
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            let bg = 'bg-slate-900/90 text-white border-slate-700';
            let icon = 'ℹ️';
            if (type === 'success') {
                bg = 'bg-emerald-950/90 text-emerald-200 border-emerald-500/40';
                icon = '✅';
            } else if (type === 'error') {
                bg = 'bg-rose-950/90 text-rose-200 border-rose-500/40';
                icon = '⚠️';
            }

            toast.className = `toast pointer-events-auto p-3.5 rounded-2xl border backdrop-blur-xl shadow-xl flex items-center gap-2.5 text-xs sm:text-sm font-medium ${bg} khmer-font`;
            toast.innerHTML = `<span>${icon}</span><span class="flex-grow">${message}</span>`;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(1rem)';
                toast.style.transition = 'all 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        // Initialize on load
        window.addEventListener('DOMContentLoaded', async () => {
            initTheme();
            loadData();
            await getOrInitAdminAuth();
            checkAdminSession();
        });
    </script>
</body>
</html>

