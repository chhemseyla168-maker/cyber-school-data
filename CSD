          cls: ($('cls') && $('cls').value.trim()) || `ថ្នាក់ទី${kh(g)}`,
          lessonNo: u.lessonNo,
          title: u.title,
          subtitle: u.subtitle,
          duration: u.duration,
          source: u.source,
          obj1: u.obj1,
          obj2: u.obj2,
          obj3: u.obj3,
          matT: u.matT,
          matS: u.matS,
          steps: u.steps
        };
      }
    }
  }

  // 3. Fallback: Smart tailored generation using the first unit of that subject or clean title
  const fallbackUnit = units[0] || {};
  const cleanTitle = prompt
    .replace(/(បង្រៀន|ថ្នាក់ទី\s*[០-៩0-9\w]+|មេរៀនទី\s*[០-៩0-9]+|រយៈពេល\s*[០-៩0-9]+\s*នាទី|គណិតវិទ្យា|ភាសាខ្មែរ|វិទ្យាសាស្ត្រ|សិក្សាសង្គម|ភាសាអង់គ្លេស)/gi, '')
    .trim() || (fallbackUnit.title || 'ខ្លឹមសារមេរៀនគន្លឹះ');

  return {
    subject: subject,
    cls: ($('cls') && $('cls').value.trim()) || `ថ្នាក់ទី${kh(gradeNum)}`,
    lessonNo: fallbackUnit.lessonNo || '១',
