        ];

        let activeMonth = "Nov 2025";
        let activeSemester = 1;

        let students = [
            { id: 1, lastname: "ប៊ុន", firstname: "អមតីប", gender: "ស", dob: "19.09.2016" },
            { id: 2, lastname: "ហេង", firstname: "សុភាវី", gender: "ស", dob: "02.02.2016" },
            { id: 3, lastname: "សៀន", firstname: "រ៉ាមី", gender: "ស", dob: "30.06.2015" },
            { id: 4, lastname: "អ៊ុន", firstname: "លក្ស្មីណា", gender: "ស", dob: "12.05.2015" },
            { id: 5, lastname: "សុវណ្ណ", firstname: "ចាន់ថុនាទ", gender: "ស", dob: "24.12.2016" },
            { id: 6, lastname: "លាត", firstname: "យូស៊ីល", gender: "ស", dob: "17.02.2017" },
            { id: 7, lastname: "រឹម", firstname: "ម៉េងគឹម", gender: "ស", dob: "18.01.2017" },
            { id: 8, lastname: "ញ្ញា", firstname: "ភិនឆាត", gender: "ប" },
            { id: 9, lastname: "ឈន", firstname: "រចនា", gender: "ស", dob: "06.10.2016" },
            { id: 10, lastname: "សុផល", firstname: "ជាំរី", gender: "ស", dob: "17.08.2015" },
            { id: 11, lastname: "យុគ", firstname: "ខាព្យុសីរីស៊ុ", gender: "ប", dob: "28.10.2016" },
            { id: 12, lastname: "ខឿន", firstname: "សុទ្ធីម", gender: "ស", dob: "24.11.2016" },
            { id: 13, lastname: "តាក", firstname: "ណីកា", gender: "ស", dob: "21.03.2016" },
            { id: 14, lastname: "ចេង", firstname: "ណិប្ដា", gender: "ស", dob: "19.05.2015" },
            { id: 15, lastname: "ទិព្វ", firstname: "ចៃតី", gender: "ប" },
            { id: 16, lastname: "មាត", firstname: "ចន្ធី", gender: "ស" },
            { id: 17, lastname: "ទីណ្ឌូ", firstname: "សុយេ", gender: "ប" },
            { id: 18, lastname: "ជាម", firstname: "ប៊ុនថៃ", gender: "ប" },
            { id: 19, lastname: "ទឹម", firstname: "ប្ដីន", gender: "ស" }
        ];

        let gradesData = {};
        let semesterExamData = { 1: {}, 2: {} };

        function initGradesData() {
            monthsList.forEach(m => {
                gradesData[m.id] = {};
                students.forEach(s => {
                    gradesData[m.id][s.id] = {
                        khmer_listen: 8.0, khmer_write: 8.0, khmer_read: 8.0, khmer_speak: 8.0,
                        math: 8.0, science: 8.0, social: 8.0, health: 8.0, hygiene: 8.0, home_art: 8.0, pe: 8.0
                    };
                });
            });

            students.forEach(s => {
                semesterExamData[1][s.id] = { khmer_listen: 8, khmer_write: 8, khmer_read: 8, khmer_speak: 8, math: 8.5, science: 8, social: 8 };
                semesterExamData[2][s.id] = { khmer_listen: 8.5, khmer_write: 8.5, khmer_read: 8.5, khmer_speak: 8.5, math: 9, science: 8.5, social: 8.5 };
            });
        }

        function switchScreen(screenId) {
            document.querySelectorAll('.screen-view').forEach(el => el.classList.add('hidden'));
            document.getElementById(`screen-${screenId}`).classList.remove('hidden');

            document.querySelectorAll('.step-btn').forEach(btn => {
                btn.classList.remove('bg-indigo-800', 'text-white', 'border', 'border-indigo-600');
                btn.classList.add('bg-indigo-950', 'text-indigo-300');
            });
            const activeBtn = document.getElementById(`btn-${screenId}`);
            if(activeBtn) {
                activeBtn.classList.remove('bg-indigo-950', 'text-indigo-300');
                activeBtn.classList.add('bg-indigo-800', 'text-white', 'border', 'border-indigo-600');
            }

            if(screenId === 'ai_entry') populateStudentSelectDropdown();
            if(screenId === 'gradebook') renderGradebookTable();
            if(screenId === 'semester') renderSemesterTable();
            if(screenId === 'canva_top5') renderCanvaTop5Page();
            if(screenId === 'reports') renderReportCard();
            if(screenId === 'classes') renderRosterTable();
            if(screenId === 'attendance') renderStudentForm();
            else if(typeof sfAuto !== 'undefined' && sfAuto) sfAutoStop();
        }

        // Khmer lunar date text (see KhmerCalendar in the khmer-lunar-calendar script)
        function getKhmerLunarDate(date) { return KhmerCalendar.lunarLine(date); }

        const escHtml = v => String(v == null ? '' : v).replace(/[&<>"'`]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;','`':'&#96;'}[c]));

        function renderCanvaTop5Page() {
            const choice = document.getElementById('top5-month-select').value;
            const mainTitle = document.getElementById('top5-main-title');

            let rankedList = [];
            if (choice.startsWith('year:')) {
                rankedList = students.map(s => ({ student: s, score: yearResultOf(s.id).score }));
                mainTitle.innerHTML = `តារាងកិត្តិយសប្រចាំឆ្នាំ<br>${escHtml(currentClass)}`;
            } else if (choice.startsWith('exam:')) {
                const sem = parseInt(choice.slice(5), 10);
                rankedList = students.map(s => ({ student: s, score: examTotalOf(sem, s.id) / 9 }));
                mainTitle.innerHTML = `តារាងកិត្តិយសប្រឡងឆមាសទី ${sem === 1 ? '១' : '២'}<br>${escHtml(currentClass)}`;
            } else if (choice.startsWith('sem:')) {
                const sem = parseInt(choice.slice(4), 10);
                rankedList = students.map(s => ({ student: s, score: semResultOf(sem, s.id).score }));
                mainTitle.innerHTML = `តារាងកិត្តិយសប្រចាំឆមាសទី ${sem === 1 ? '១' : '២'}<br>${escHtml(currentClass)}`;
            } else {
                const mId = choice;
                const mName = (monthsList.find(m => m.id === mId) || {}).name || mId;
                rankedList = students.map(s => {
                    const g = gradesData[mId] && gradesData[mId][s.id] ? gradesData[mId][s.id] : { math:8, science:8 };
                    const total = parseFloat(g.math || 0) + parseFloat(g.science || 0) + parseFloat(g.khmer_listen || 8);
                    return { student: s, score: total };
                });
                mainTitle.innerHTML = `តារាងកិត្តិយសប្រចាំខែ ${escHtml(mName)}<br>${escHtml(currentClass)}`;
            }

            rankedList.sort((a, b) => b.score - a.score);
            const top5 = rankedList.slice(0, 5);

            // Populate Rank 1 to 5 into exact slots
            for(let i=0; i<5; i++) {
                const item = top5[i] || { student: { lastname: "គ្មាន", firstname: "ទិន្នន័យ", gender: "-" }, score: 0 };
                const rankNum = i + 1;
                const nameEl = document.getElementById(`top5-rank-${rankNum}-name`);
                const scoreEl = document.getElementById(`top5-rank-${rankNum}-score`);
                
                if(nameEl) nameEl.innerText = `${item.student.lastname} ${item.student.firstname} (${item.student.gender})`;
                if(scoreEl) scoreEl.innerText = `ពិន្ទុ៖ ${item.score.toFixed(2)}`;
            }

            // Footer dates follow the Khmer lunar calendar and the day of printing
            refreshFooterDates();
        }

        function renderRosterTable() {
            const tbody = document.getElementById('roster-table-body');
            if (!tbody) return;
            if (!students.length) {
                tbody.innerHTML = '<tr><td colspan="16" class="c" style="padding:24px;cursor:default">មិនទាន់មានសិស្សទេ។ ចុច "+ បន្ថែមសិស្សថ្មី"</td></tr>';
            } else {
                tbody.innerHTML = students.map((s, idx) => {
                    const age = sfAge(s.dob);
                    const sidNum = parseInt(s.id, 10);
                    return `
                    <tr onclick="editStudent(${sidNum})" title="ចុចដើម្បីបំពេញ/កែព័ត៌មាន">
                        <td class="c">${idx + 1}</td>
                        <td class="c">${escHtml(s.sid)}</td>
                        <td>${escHtml(s.lastname)}</td>
                        <td>${escHtml(s.firstname)}</td>
                        <td class="c">${escHtml(s.gender)}</td>
                        <td class="c">${escHtml(s.dob)}</td>
                        <td class="c">${age === '' ? '' : age}</td>
                        <td class="c">${escHtml(s.status || 'ថ្មី')}</td>
                        <td>${escHtml(s.father)}</td>
                        <td>${escHtml(s.fatherJob)}</td>
                        <td>${escHtml(s.mother)}</td>
                        <td>${escHtml(s.motherJob)}</td>
                        <td>${escHtml(s.birthPlace)}</td>
                        <td>${escHtml(s.village)}</td>
                        <td>${escHtml(s.address)}</td>
                        <td class="c sis-act no-print">
                            <button onclick="event.stopPropagation();editStudent(${sidNum})" class="text-indigo-600">កែ</button>
                            <button onclick="event.stopPropagation();deleteStudent(${sidNum})" class="text-rose-500">លុប</button>
                        </td>
                    </tr>`;
                }).join('');
            }
            const set = (id, v) => { const el = document.getElementById(id); if (el) el.innerText = v; };
            set('stat-total-students', students.length);
            set('sis-total', students.length);
            set('sis-female', students.filter(s => s.gender === 'ស').length);
            fillClassInfo();
        }

