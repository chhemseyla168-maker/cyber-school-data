        function processExcelFile(file) {
          const validExts = ['.xlsx', '.xls', '.csv'];
          const ext = file.name.substring(file.name.lastIndexOf('.')).toLowerCase();
          if (!validExts.includes(ext)) {
            showExcelMsg('⚠️ សូមជ្រើសរើសឯកសារ Excel (.xlsx, .xls) ឬ .csv ប៉ុណ្ណោះ', false);
            return;
          }

          const badge = document.getElementById('excel-file-badge');
          const nameEl = document.getElementById('excel-file-name');
          const sizeEl = document.getElementById('excel-file-size');
          if (badge && nameEl) {
            nameEl.textContent = file.name;
            if (sizeEl) sizeEl.textContent = '(' + (file.size / 1024).toFixed(1) + ' KB)';
            badge.classList.remove('hidden');
          }

          const reader = new FileReader();
          reader.onload = function (evt) {
            try {
              const buffer = evt.target.result;
              let rows = [];

              if (typeof XLSX !== 'undefined') {
                const data = new Uint8Array(buffer);
                const workbook = XLSX.read(data, { type: 'array', cellDates: true });
                const sheetName = workbook.SheetNames[0];
                const worksheet = workbook.Sheets[sheetName];
                rows = XLSX.utils.sheet_to_json(worksheet, { header: 1, defval: '' });
              } else {
                const decoder = new TextDecoder('utf-8');
                const text = decoder.decode(buffer);
                rows = text.split(/\r?\n/).map(line => line.split(',').map(s => s.replace(/^"|"$/g, '').trim()));
              }

              if (!rows || !rows.length) {
                showExcelMsg('⚠️ ឯកសារនេះគ្មានទិន្នន័យទេ សូមពិនិត្យឯកសារម្តងទៀត', false);
                return;
              }

              parseStudentRows(rows);
            } catch (err) {
              console.error('Error parsing Excel file:', err);
              showExcelMsg('⚠️ មិនអាចអានឯកសារ Excel នេះបានទេ៖ ' + (err && err.message ? err.message : ''), false);
            }
          };
          reader.readAsArrayBuffer(file);
        }

        function findHeaderRowIndex(rows) {
          let bestIdx = 0;
          let maxMatches = 0;
          const keywords = [
            'គោត្តនាម', 'នាម', 'ឈ្មោះ', 'ភេទ', 'អត្តលេខ', 'ថ្ងៃខែឆ្នាំកំណើត', 'ថ្ងៃកំណើត',
            'lastname', 'firstname', 'name', 'gender', 'sex', 'dob', 'sid', 'id', 'ល.រ', 'no'
          ];

          for (let r = 0; r < Math.min(rows.length, 15); r++) {
            const row = rows[r];
            if (!Array.isArray(row)) continue;
            let matches = 0;
            for (let c = 0; c < row.length; c++) {
              const val = String(row[c] || '').trim().toLowerCase();
              if (!val) continue;
              if (keywords.some(k => val.includes(k))) matches++;
            }
            if (matches > maxMatches) {
              maxMatches = matches;
              bestIdx = r;
            }
          }
          return bestIdx;
        }

        function normalizeGender(val) {
          const s = String(val || '').trim().toLowerCase();
          if (['ស', 'ស្រី', 'f', 'female', 'girl', 'w', 'woman'].includes(s) || s.startsWith('ស្រី')) {
            return 'ស';
          }
          if (['ប', 'ប្រុស', 'm', 'male', 'boy', 'man'].includes(s) || s.startsWith('ប្រុស')) {
            return 'ប';
          }
          return 'ប';
        }

        function normalizeDob(val) {
          if (!val) return '';
          if (val instanceof Date && !isNaN(val)) {
            const dd = String(val.getDate()).padStart(2, '0');
            const mm = String(val.getMonth() + 1).padStart(2, '0');
            const yyyy = val.getFullYear();
            return `${dd}.${mm}.${yyyy}`;
          }
          if (typeof val === 'number') {
            const d = new Date(Math.round((val - 25569) * 86400 * 1000));
            if (!isNaN(d)) {
              const dd = String(d.getUTCDate()).padStart(2, '0');
              const mm = String(d.getUTCMonth() + 1).padStart(2, '0');
              const yyyy = d.getUTCFullYear();
              return `${dd}.${mm}.${yyyy}`;
            }
          }
          const str = String(val).trim();
          if (typeof sfNormDob === 'function') {
            const norm = sfNormDob(str);
            if (norm) return norm;
          }
          return str;
        }

        function parseStudentRows(rows) {
          const headerIdx = findHeaderRowIndex(rows);
          const headerRow = rows[headerIdx] || [];
          const colMap = {};

          headerRow.forEach((col, idx) => {
            const h = String(col || '').trim().toLowerCase();
            if (!h) return;
            if ((h.includes('អត្តលេខ') || h.includes('លេខកូដ') || h === 'sid' || h === 'student id' || h === 'id') && !colMap.sid) colMap.sid = idx;
            else if ((h.includes('គោត្តនាម') || h.includes('ត្រកូល') || h === 'lastname' || h === 'last name') && !colMap.lastname) colMap.lastname = idx;
            else if ((h.includes('នាមខ្លួន') || h === 'នាម' || h === 'firstname' || h === 'first name') && !colMap.firstname) colMap.firstname = idx;
            else if ((h.includes('ឈ្មោះ') || h.includes('fullname') || h.includes('name')) && !colMap.fullname && !colMap.lastname && !colMap.firstname) colMap.fullname = idx;
            else if ((h.includes('ភេទ') || h === 'gender' || h === 'sex') && !colMap.gender) colMap.gender = idx;
            else if ((h.includes('ថ្ងៃ') || h.includes('កំណើត') || h === 'dob' || h === 'birthdate' || h === 'birthday') && !colMap.dob) colMap.dob = idx;
            else if ((h.includes('ស្ថានភាព') || h.includes('ជាសិស្ស') || h === 'status') && !colMap.status) colMap.status = idx;
            else if ((h.includes('ឪពុក') || h === 'father') && !h.includes('មុខរបរ') && !colMap.father) colMap.father = idx;
            else if ((h.includes('មុខរបរ') && h.includes('ឪពុក')) || (h.includes('father') && h.includes('job'))) colMap.fatherJob = idx;
            else if ((h.includes('ម្តាយ') || h.includes('ម្ដាយ') || h === 'mother') && !h.includes('មុខរបរ') && !colMap.mother) colMap.mother = idx;
            else if (((h.includes('ម្តាយ') || h.includes('ម្ដាយ')) && h.includes('មុខរបរ')) || (h.includes('mother') && h.includes('job'))) colMap.motherJob = idx;
            else if (h.includes('កន្លែងកំណើត') || h === 'birthplace') colMap.birthPlace = idx;
            else if (h === 'ភូមិ' || h === 'village') colMap.village = idx;
            else if (h.includes('ទីលំនៅ') || h.includes('អាសយដ្ឋាន') || h === 'address') colMap.address = idx;
          });

          if (colMap.lastname === undefined && colMap.firstname === undefined && colMap.fullname === undefined) {
            headerRow.forEach((col, idx) => {
              const h = String(col || '').trim().toLowerCase();
              if (h.includes('ឈ្មោះ') || h.includes('name')) colMap.fullname = idx;
            });
          }

          const parsedList = [];
          for (let r = headerIdx + 1; r < rows.length; r++) {
            const row = rows[r];
            if (!Array.isArray(row) || !row.length) continue;

            let lastname = colMap.lastname !== undefined ? String(row[colMap.lastname] || '').trim() : '';
            let firstname = colMap.firstname !== undefined ? String(row[colMap.firstname] || '').trim() : '';
            const fullname = colMap.fullname !== undefined ? String(row[colMap.fullname] || '').trim() : '';

            if (!lastname && !firstname && fullname) {
              const parts = fullname.split(/\s+/);
              lastname = parts[0] || '';
              firstname = parts.slice(1).join(' ') || parts[0];
            }

            if (!lastname && !firstname) continue;
            if (lastname.includes('សរុប') || firstname.includes('សរុប') || lastname.toLowerCase().includes('total') || firstname.toLowerCase().includes('total')) continue;
            if (lastname.includes('គ្រូបន្ទុក') || firstname.includes('គ្រូបន្ទុក')) continue;

            const sid = colMap.sid !== undefined ? String(row[colMap.sid] || '').trim() : '';
            const rawGender = colMap.gender !== undefined ? row[colMap.gender] : '';
            const gender = normalizeGender(rawGender);
            const rawDob = colMap.dob !== undefined ? row[colMap.dob] : '';
            const dob = normalizeDob(rawDob);
            const status = colMap.status !== undefined ? String(row[colMap.status] || '').trim() || 'ថ្មី' : 'ថ្មី';
            const father = colMap.father !== undefined ? String(row[colMap.father] || '').trim() : '';
            const fatherJob = colMap.fatherJob !== undefined ? String(row[colMap.fatherJob] || '').trim() : '';
            const mother = colMap.mother !== undefined ? String(row[colMap.mother] || '').trim() : '';
            const motherJob = colMap.motherJob !== undefined ? String(row[colMap.motherJob] || '').trim() : '';
            const birthPlace = colMap.birthPlace !== undefined ? String(row[colMap.birthPlace] || '').trim() : '';
            const village = colMap.village !== undefined ? String(row[colMap.village] || '').trim() : '';
            const address = colMap.address !== undefined ? String(row[colMap.address] || '').trim() : '';

            parsedList.push({
              sid, lastname, firstname, gender, dob, status,
              father, fatherJob, mother, motherJob, birthPlace, village, address
            });
          }

          if (!parsedList.length) {
            showExcelMsg('⚠️ មិនអាចរកឃើញជួរសិស្សណាមួយក្នុងតារាងទេ សូមពិនិត្យក្បាលតារាង (Header) ក្នុងឯកសារ Excel', false);
            return;
          }

          parsedExcelStudents = parsedList;
          renderExcelPreview(parsedList);
        }

