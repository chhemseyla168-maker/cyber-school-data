        if text:
            clean_text = html.escape(text[:300])
            admin_caption += f"\n\n📝 <b>សារភ្ជាប់:</b>\n{clean_text}"

        # Safe length: clean_text is capped to 200 chars, template stays well under Telegram 1024 char limit

