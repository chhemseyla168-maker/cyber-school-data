            if(screenId === 'semester') renderSemesterTable();
            if(screenId === 'canva_top5') renderCanvaTop5Page();
            if(screenId === 'reports') renderReportCard();
            if(screenId === 'classes') renderRosterTable();
            if(screenId === 'attendance') renderStudentForm();
            else if(typeof sfAuto !== 'undefined' && sfAuto) sfAutoStop();
