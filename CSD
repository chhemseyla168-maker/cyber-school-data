            user = user || window.getCurrentUser();
            if (!user || !user.trialStartedAt) return 0;
            const elapsed = Date.now() - Number(user.trialStartedAt);
            if (elapsed >= SEVEN_DAYS_MS) return 0;
            return Math.max(1, Math.ceil((SEVEN_DAYS_MS - elapsed) / (24 * 60 * 60 * 1000)));
        };
