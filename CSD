let currentCurriculumSubject = 'គណិតវិទ្យា';
let currentCurriculumSemester = 0; // 0 = all, 1 = sem 1, 2 = sem 2
let currentSearchKeyword = '';

function detectUserGradeNumber() {
  const clsVal = ($('cls') && $('cls').value.trim()) || (getUser() && getUser().grade) || 'ថ្នាក់ទី៤ ឃ';
  const khToAr = {'០':'0','១':'1','២':'2','៣':'3','៤':'4','៥':'5','៦':'6','៧':'7','៨':'8','៩':'9'};
  const normalized = clsVal.replace(/[០-៩]/g, d => khToAr[d]);
  const match = normalized.match(/([1-6])/);
  return match ? parseInt(match[1], 10) : 4;
}

function switchCurriculumSubject(sub) {
  currentCurriculumSubject = sub;
  document.querySelectorAll('.ai-sub-tab').forEach(tab => {
    tab.classList.toggle('active', tab.getAttribute('data-subject') === sub);
  });
  renderCurriculumUnits();
}

function switchCurriculumSemester(sem) {
  currentCurriculumSemester = sem;
  ['sem-tab-all', 'sem-tab-1', 'sem-tab-2'].forEach((id, idx) => {
    const el = $(id);
    if (el) el.classList.toggle('active', idx === sem);
  });
  renderCurriculumUnits();
}

function filterCurriculumUnits() {
  const input = $('ai-units-search');
  currentSearchKeyword = input ? input.value.trim().toLowerCase() : '';
  renderCurriculumUnits();
}

function renderCurriculumUnits() {
  const gradeNum = detectUserGradeNumber();
  const clsVal = ($('cls') && $('cls').value.trim()) || (getUser() && getUser().grade) || 'ថ្នាក់ទី៤ ឃ';
  
  // Update header badge
  const labelEl = $('ai-active-grade-label');
  if (labelEl) {
    labelEl.textContent = `📚 កម្មវិធីសិក្សាផ្លូវការ៖ ${clsVal}`;
  }

  const container = $('ai-units-list');
  if (!container) return;

  const gradeData = GRADE_CURRICULUM[gradeNum] || GRADE_CURRICULUM[4];
  const allUnits = gradeData[currentCurriculumSubject] || gradeData['គណិតវិទ្យា'] || [];

  // Filter by semester and search keyword
  const filtered = allUnits.filter((u, idx) => {
    if (currentCurriculumSemester !== 0 && u.semester !== currentCurriculumSemester) return false;
    if (currentSearchKeyword) {
      const matchText = (u.title + ' ' + u.subtitle + ' ' + u.lessonNo).toLowerCase();
      if (!matchText.includes(currentSearchKeyword)) return false;
    }
    return true;
  });

  // Update counter
  const countEl = $('ai-units-count');
  if (countEl) {
    countEl.textContent = `បង្ហាញ ${filtered.length} / ${allUnits.length} មេរៀន`;
  }

  if (filtered.length === 0) {
    container.innerHTML = `<div style="padding:14px;text-align:center;color:var(--muted);font-size:12px">
      🔍 មិនមានមេរៀនដែលត្រូវនឹងលក្ខខណ្ឌស្វែងរក «${esc(currentSearchKeyword)}» ឡើយ។
    </div>`;
    return;
  }

  container.innerHTML = filtered.map((u) => {
    const realIndex = allUnits.indexOf(u);
    const semBadge = u.semester === 1 ? 'ឆមាសទី១' : 'ឆមាសទី២';
    return `
      <div class="ai-unit-item" id="unit-card-${realIndex}" onclick="selectCurriculumUnit(${realIndex})" title="ចុចដើម្បីបំពេញ និងឱ្យ AI តែងកិច្ចតែងការភ្លាមៗ">
        <span class="ai-unit-no">មេរៀន ${kh(u.lessonNo)}</span>
        <div class="ai-unit-details">
          <div class="ai-unit-title">
            ${esc(u.title)}
            <span class="ai-unit-sem-badge">${semBadge}</span>
          </div>
          <div class="ai-unit-sub">${esc(u.subtitle)}</div>
        </div>
        <span class="ai-unit-action">⚡ តែងមេរៀននេះ</span>
      </div>
    `;
  }).join('');
}

function selectCurriculumUnit(idx) {
  const gradeNum = detectUserGradeNumber();
  const gradeData = GRADE_CURRICULUM[gradeNum] || GRADE_CURRICULUM[4];
  const units = gradeData[currentCurriculumSubject] || [];
  const u = units[idx];
  if (!u) return;

  // 1. Populate all lesson metadata immediately with official MoEYS data
  if (typeof populateLessonData === 'function') {
    const clsVal = ($('cls') && $('cls').value.trim()) || (getUser() && getUser().grade) || `ថ្នាក់ទី${kh(gradeNum)}`;
    populateLessonData({
      subject: currentCurriculumSubject,
      cls: clsVal,
      lessonNo: u.lessonNo,
      title: u.title,
      subtitle: u.subtitle,
      duration: u.duration || '40',
      source: u.source,
      obj1: u.obj1,
      obj2: u.obj2,
      obj3: u.obj3,
      matT: u.matT,
      matS: u.matS,
      steps: u.steps
    });
  }

  // 2. Set Prompt input for AI
  const clsVal = ($('cls') && $('cls').value.trim()) || `ថ្នាក់ទី${kh(gradeNum)}`;
  const prompt = `បង្កើតកិច្ចតែងការបង្រៀនមុខវិជ្ជា ${currentCurriculumSubject} ${clsVal} មេរៀនទី${u.lessonNo}៖ «${u.title}» (${u.subtitle}) ឱ្យបានលម្អិតពេញលេញទាំង ៥ ជំហានបង្រៀន ស្របតាមកម្មវិធីក្រសួងអប់រំ។`;
  if ($('ai-prompt-input')) $('ai-prompt-input').value = prompt;

  // 3. Highlight selected card
  document.querySelectorAll('.ai-unit-item').forEach(el => el.classList.remove('active'));
  const card = $(`unit-card-${idx}`);
  if (card) card.classList.add('active');

  // 4. Update preview sheet
  render();
  launchConfetti();
}

// Listen to class input change to update curriculum units dynamically
if ($('cls')) {
  $('cls').addEventListener('input', function() {
    renderCurriculumUnits();
  });
}

// Initialize page state & preview
try {
  load();
  if ($('date') && !$('date').value) $('date').value = new Date().toISOString().slice(0, 10);
  if (typeof renderLogin === 'function') renderLogin();
  if (typeof renderSteps === 'function') renderSteps();
  if (typeof applyUser === 'function') applyUser(false);
  if (typeof render === 'function') render();
  if (typeof renderCurriculumUnits === 'function') renderCurriculumUnits();
} catch (e) {
  console.error("Initialization error:", e);
}
