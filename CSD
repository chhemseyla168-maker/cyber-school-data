function renderSteps(){
  $("steps").innerHTML=steps.map((s,i)=>`<div class="step" data-i="${i}">
   <header><b>ជំហានទី ${kh(i+1)}</b><input data-k="t" value="${esc(s.t)}" aria-label="ឈ្មោះជំហាន">
