                gradeSelect.value = "ថ្នាក់ទី ៣";
            } else if (type === 'science_plants') {
                promptBox.value = "បង្កើតសន្លឹកកិច្ចការវិទ្យាសាស្ត្រ ថ្នាក់ទី៤ អំពីផ្នែកផ្សេងៗនៃរុក្ខជាតិ ការធ្វើរស្មីសំយោគ និងការថែរក្សាបរិស្ថាន";
                subjSelect.value = "វិទ្យាសាស្ត្រ";
                gradeSelect.value = "ថ្នាក់ទី ៤";
            } else if (type === 'social_civics') {
                promptBox.value = "បង្កើតកិច្ចការសិក្សាសង្គម ថ្នាក់ទី៥ អំពីប្រវត្តិសាស្ត្រខ្មែរ សីលធម៌ពលរដ្ឋ និងការគោរពច្បាប់ចរាចរណ៍";
                subjSelect.value = "សិក្សាសង្គម";
                gradeSelect.value = "ថ្នាក់ទី ៥";
            } else if (type === 'english_tenses') {
                promptBox.value = "Create Grade 5 English worksheet about Present Simple Tense, School Objects, prepositions, and sentence writing";
                subjSelect.value = "ភាសាអង់គ្លេស";
                gradeSelect.value = "ថ្នាក់ទី ៥";
            }
            syncWorksheetHeader();
        }

        function toggleAnswerKey() {
            isAnswerKeyVisible = !isAnswerKeyVisible;
            const akPage = document.getElementById('answer-key-page');
            const eyeIcon = document.getElementById('ak-eye-icon');
            const label = document.getElementById('ak-btn-label');

            if (isAnswerKeyVisible) {
                akPage.classList.remove('hidden');
                eyeIcon.textContent = '🙈';
                label.textContent = 'លាក់សន្លឹកចម្លើយ';
                akPage.scrollIntoView({ behavior: 'smooth' });
            } else {
                akPage.classList.add('hidden');
                eyeIcon.textContent = '👁️';
                label.textContent = 'បង្ហាញសន្លឹកចម្លើយ';
            }
        }

        // Voice Input for Prompt Textarea
        let promptRecognition = null;
        let isPromptListening = false;
        function togglePromptSpeech() {
            if (!isProUser()) {
                showProWorksheetModal();
                return;
            }

            const btn = document.getElementById('btn-prompt-voice');
            const promptBox = document.getElementById('ai-prompt-input');

            if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
                alert('កម្មវិធីរុករករបស់អ្នកមិនគាំទ្រប្រព័ន្ធសំឡេង Speech Recognition ទេ។');
                return;
            }

            if (isPromptListening && promptRecognition) {
                promptRecognition.stop();
                return;
            }

            const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
            promptRecognition = new SR();
            promptRecognition.lang = 'km-KH';
            promptRecognition.interimResults = false;

            promptRecognition.onstart = () => {
                isPromptListening = true;
                btn.className = "absolute bottom-3 right-3 p-2 rounded-xl bg-rose-600 text-white animate-pulse shadow-lg";
                btn.title = "កំពុងស្តាប់សំឡេង... (ចុចដើម្បីបញ្ឈប់)";
            };

            promptRecognition.onresult = (ev) => {
                const heard = ev.results[0][0].transcript;
                promptBox.value = (promptBox.value ? promptBox.value + ' ' : '') + heard;
            };

            promptRecognition.onerror = () => {
                isPromptListening = false;
                btn.className = "absolute bottom-3 right-3 p-2 rounded-xl bg-slate-800 hover:bg-indigo-600 text-slate-300 hover:text-white transition shadow";
            };

            promptRecognition.onend = () => {
                isPromptListening = false;
                btn.className = "absolute bottom-3 right-3 p-2 rounded-xl bg-slate-800 hover:bg-indigo-600 text-slate-300 hover:text-white transition shadow";
                btn.title = "និយាយបញ្ចូល Prompt";
            };

            promptRecognition.start();
        }

        // Intelligent AI Generator Core
        function generateAIWorksheet() {
            if (!isProUser()) {
                showProWorksheetModal();
                return;
            }

            const btn = document.getElementById('btn-generate-ai');
            const originalText = btn.innerHTML;
            btn.innerHTML = `
                <svg class="w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>AI កំពុងវិភាគ និងបង្កើតកិច្ចការ...</span>
            `;
            btn.disabled = true;

            const prompt = document.getElementById('ai-prompt-input').value.trim();
            const subject = document.getElementById('cfg-subject').value;
            const grade = document.getElementById('cfg-grade').value;

            syncWorksheetHeader();

            setTimeout(() => {
                buildGeneratedContent(prompt, subject, grade);
                btn.innerHTML = originalText;
                btn.disabled = false;

                const page = document.getElementById('worksheet-a4-page');
                page.classList.add('ring-4', 'ring-indigo-500/50');
                setTimeout(() => page.classList.remove('ring-4', 'ring-indigo-500/50'), 600);
            }, 600);
        }

        // Construct HTML content based on curriculum & user prompt
        function buildGeneratedContent(prompt, subject, grade) {
            const pLower = prompt.toLowerCase();
            let matchedSubj = subject;
            if (pLower.includes('គណិត') || pLower.includes('បូក') || pLower.includes('ប្រភាគ')) matchedSubj = 'គណិតវិទ្យា';
            else if (pLower.includes('ខ្មែរ') || pLower.includes('វេយ្យាករណ៍') || pLower.includes('តែងល្បះ')) matchedSubj = 'ភាសាខ្មែរ';
            else if (pLower.includes('វិទ្យាសាស្ត្រ') || pLower.includes('រុក្ខជាតិ') || pLower.includes('បរិស្ថាន')) matchedSubj = 'វិទ្យាសាស្ត្រ';
            else if (pLower.includes('english') || pLower.includes('tense') || pLower.includes('verb')) matchedSubj = 'ភាសាអង់គ្លេស';

            const data = KHMER_CURRICULUM_DATA[matchedSubj] || KHMER_CURRICULUM_DATA['គណិតវិទ្យា'];
            
            const randomTopic = data.topics[Math.floor(Math.random() * data.topics.length)];
            const topicText = prompt ? `ប្រធានបទ៖ ${prompt.slice(0, 80)}...` : `មេរៀនពង្រឹងសមត្ថភាព៖ ${randomTopic}`;
            document.getElementById('ws-lesson-topic').textContent = topicText;

            // Section I Items (Multiple Choice)
            const mcContainer = document.getElementById('sec-mc-items');
            mcContainer.innerHTML = '';
            const mcPool = [...data.mc].sort(() => 0.5 - Math.random()).slice(0, 2);
            let akMcHtml = '';

            mcPool.forEach((item, idx) => {
                const khmerNum = ['១', '២', '៣', '៤'][idx] || (idx + 1);
                mcContainer.innerHTML += `
                    <div class="space-y-0.5">
                        <p contenteditable="true"><strong>${khmerNum}.</strong> ${item.q}</p>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pl-4 text-slate-900 text-[11px]">
                            ${item.opts.map(o => `
                                <label class="flex items-center gap-1.5 cursor-pointer">
                                    <span class="w-3.5 h-3.5 rounded-sm border border-slate-500 inline-block"></span>
                                    <span contenteditable="true">${o}</span>
                                </label>
                            `).join('')}
                        </div>
                    </div>
                `;
                akMcHtml += `<p><strong>សំណួរ ${khmerNum}៖</strong> ចម្លើយត្រូវគឺ <strong>${item.ans}</strong> (${item.exp})</p>`;
            });

            // Section II Items (Fill in Blanks)
            const fillContainer = document.getElementById('sec-fill-items');
            fillContainer.innerHTML = '';
            const fillPool = [...data.fill].sort(() => 0.5 - Math.random()).slice(0, 3);
            let akFillHtml = '';

            fillPool.forEach((item, idx) => {
                const khmerNum = ['១', '២', '៣', '៤'][idx] || (idx + 1);
                fillContainer.innerHTML += `
                    <div class="flex items-baseline gap-2">
                        <span><strong>${khmerNum}.</strong> ${item.q}</span>
                        <span class="border-b border-dotted border-slate-600 flex-grow min-w-[70px] h-4 inline-block"></span>
                        ${item.suffix ? `<span>${item.suffix}</span>` : ''}
                    </div>
                `;
                akFillHtml += `<p><strong>សំណួរ ${khmerNum}៖</strong> ${item.ans}</p>`;
            });

            // Section III Items (Problems / Work Out)
            const probContainer = document.getElementById('sec-prob-items');
            probContainer.innerHTML = '';
            const probPool = [...data.problems].sort(() => 0.5 - Math.random()).slice(0, 1);
            let akProbHtml = '';

            probPool.forEach((item) => {
                probContainer.innerHTML += `
                    <div class="space-y-1">
                        <p contenteditable="true">${item.q}</p>
                        <div class="p-2.5 border border-slate-300 rounded-lg min-h-[105px] bg-slate-50/30">
                            <span class="text-[10px] font-bold text-slate-500 block mb-1">ដំណោះស្រាយ (Show your work)៖</span>
                            <div class="space-y-5 pt-1">
                                <div class="border-b border-dotted border-slate-400 h-4"></div>
                                <div class="border-b border-dotted border-slate-400 h-4"></div>
                                <div class="border-b border-dotted border-slate-400 h-4"></div>
                            </div>
                        </div>
                    </div>
                `;
                akProbHtml += `<p><strong>ដំណោះស្រាយ៖</strong></p><pre class="khmer-font whitespace-pre-line pl-4 text-slate-800">${item.solution}</pre>`;
            });

            // Update Answer Key Page
            const akBody = document.getElementById('ak-body');
            akBody.innerHTML = `
                <div class="p-3 bg-indigo-50/60 rounded-xl border border-indigo-100 space-y-1">
                    <h4 class="font-bold text-indigo-950">ផ្នែកទី ១៖ ចម្លើយពហុជ្រើសរើស (៤ ពិន្ទុ)</h4>
                    ${akMcHtml}
                </div>
                <div class="p-3 bg-emerald-50/60 rounded-xl border border-emerald-100 space-y-1">
                    <h4 class="font-bold text-emerald-950">ផ្នែកទី ២៖ ចម្លើយបំពេញចន្លោះ (៣ ពិន្ទុ)</h4>
                    ${akFillHtml}
                </div>
                <div class="p-3 bg-amber-50/60 rounded-xl border border-amber-100 space-y-1">
                    <h4 class="font-bold text-amber-950">ផ្នែកទី ៣៖ ដំណោះស្រាយចំណោទ (៣ ពិន្ទុ)</h4>
                    ${akProbHtml}
                </div>
            `;
        }

        // Reset Worksheet to Default state
        function resetWorksheetToDefault() {
            document.getElementById('ai-prompt-input').value = '';
            document.getElementById('cfg-subject').value = 'គណិតវិទ្យា';
            document.getElementById('cfg-grade').value = 'ថ្នាក់ទី ៤';
            buildGeneratedContent('', 'គណិតវិទ្យា', 'ថ្នាក់ទី ៤');
            syncWorksheetHeader();
        }

        // On Page Load
        window.onload = function() {
            try {
                const s = localStorage.getItem('csd-ws-school');
                const t = localStorage.getItem('csd-ws-teacher');
                if (s) document.getElementById('cfg-school').value = s;
                if (t) document.getElementById('cfg-teacher').value = t;
            } catch (e) {}

            syncWorksheetHeader();
            updateProUI();

            // Periodic license check with server
            const apiBase = window.location.origin.startsWith('http') ? window.location.origin : 'http://127.0.0.1:8000';
            const licRaw = localStorage.getItem('csd-active-license');
            if (licRaw) {
                try {
                    const lic = JSON.parse(licRaw);
                    if (lic && lic.key) {
                        fetch(apiBase + '/api/check_license?key=' + encodeURIComponent(lic.key))
                            .then(r => r.json())
                            .then(d => {
                                if (d && (d.status === 'disabled' || d.disabled === true)) {
                                    localStorage.removeItem('csd-active-license');
                                    updateProUI();
                                } else if (d && d.status === 'active') {
                                    updateProUI();
                                }
                            })
                            .catch(() => {});
                    }
                } catch (e) {}
            }
        };
    </script>

</body>
