            chat_id: acc.tgChatId, parse_mode: 'HTML',
            text: '🔐 កូដ OTP របស់អ្នកគឺ៖ <code>' + code + '</code>\nមានសុពលភាព ១០ នាទី។ សូមកុំចែករំលែកកូដនេះជាមួយអ្នកដទៃ។'
          });
          if (!r.ok) throw new Error(r.description || 'tg');
          return { demo: false };
        }

        /* ---------- link Telegram (registration + logged-in account) ---------- */
        function tgStatus(ctx, text, ok) { setMsg($('tg-status-' + ctx), text, ok); }
        function tgReset(ctx) {
          const st = tgState[ctx]; if (st && st.timer) clearInterval(st.timer);
          tgState[ctx] = null; tgStatus(ctx, '');
          const lnk = $('tg-open-' + ctx); if (lnk) lnk.classList.remove('show');
          const b = $('tg-btn-' + ctx); if (b) { b.textContent = TG_LABEL; b.disabled = false; }
        }
        window.tgPhoneChanged = function (ctx) { if (tgState[ctx]) tgReset(ctx); if (ctx === 'forgot') { const bx = $('tg-box-forgot'); if (bx) bx.classList.add('hidden'); } };
        window.tgStartLink = async function (ctx) {
          const input = $(PHONE_IDS[ctx]);
          const phone = normPhone(input ? input.value : '');
          tgReset(ctx);
          if (!validPhone(phone)) return tgStatus(ctx, 'សូមបញ្ចូលលេខទូរស័ព្ទដែលមាន Telegram ជាមុនសិន', false);
          if (ctx === 'link' && accounts.some(a => a !== currentUser && samePhone(a.phone, phone))) return tgStatus(ctx, 'លេខទូរស័ព្ទនេះត្រូវបានប្រើដោយគណនីផ្សេងរួចហើយ', false);
          if (!tgOn()) {
            if (ctx === 'reg') tgStatus(ctx, '⚠️ មិនទាន់កំណត់ Telegram bot — ដំណើរការសាកល្បង (កូដ OTP នឹងបង្ហាញលើអេក្រង់)។ អ្នកអាចបន្តបង្កើតគណនីបាន។', true);
            else tgStatus(ctx, '⚠️ មិនទាន់កំណត់ Telegram bot (TELEGRAM_CONFIG ទទេ)', false);
            return;
          }
          const code = 'L' + toHex(rnd(8));
          const st = tgState[ctx] = { code: code, phone: phone, stage: 'start', chatId: null, fromId: null, afterId: 0, until: Date.now() + 3 * 60 * 1000, busy: false };
          if (!tgBot.username) {
            tgStatus(ctx, 'កំពុងភ្ជាប់ទៅ Telegram bot...', true);
            try { await tgLoadBot(); }
            catch (e) { if (tgState[ctx] === st) tgState[ctx] = null; return tgStatus(ctx, 'មិនអាចទាក់ទង Telegram bot បានទេ (ពិនិត្យ Token)៖ ' + (e && e.message ? e.message : ''), false); }
            if (tgState[ctx] !== st) return;
          }
          const url = 'https://t.me/' + tgBot.username + '?start=' + code;
          const lnk = $('tg-open-' + ctx); if (lnk) { lnk.href = url; lnk.classList.add('show'); }
          window.open(url, '_blank');
          const b = $('tg-btn-' + ctx); if (b) b.textContent = '⏳ កំពុងរង់ចាំការបញ្ជាក់...';
          tgStatus(ctx, 'ជំហាន ១៖ ចុច START ក្នុង Telegram (រង់ចាំរហូតដល់ ៣ នាទី)', true);
          st.timer = setInterval(function () { tgPoll(ctx); }, 2000);
        };
        async function tgPoll(ctx) {
          const st = tgState[ctx]; if (!st || st.stage === 'done' || st.busy) return;
          const btn = $('tg-btn-' + ctx);
          if (Date.now() > st.until) { clearInterval(st.timer); tgStatus(ctx, 'ផុតពេលរង់ចាំ សូមចុចប៊ូតុងម្ដងទៀត', false); if (btn) btn.textContent = TG_LABEL; return; }
          st.busy = true;
          try {
            const res = await tgApi('getUpdates', { limit: 100, allowed_updates: ['message'] });
            if (!res.ok) throw new Error(res.description || 'tg');
            const ups = res.result || [];
            if (st.stage === 'start') {
              const u = ups.find(function (u) { const m = u.message; return m && m.chat && m.chat.type === 'private' && typeof m.text === 'string' && m.text.trim() === '/start ' + st.code; });
              if (u && tgState[ctx] === st) {
                st.chatId = u.message.chat.id; st.fromId = u.message.from && u.message.from.id; st.afterId = u.update_id;
                st.name = u.message.from ? (u.message.from.username ? '@' + u.message.from.username : (u.message.from.first_name || '')) : '';
                st.stage = 'contact';
                await tgApi('sendMessage', { chat_id: st.chatId, text: 'ជំហានបន្ទាប់៖ សូមចុចប៊ូតុងខាងក្រោម ដើម្បីបញ្ជាក់លេខទូរស័ព្ទរបស់អ្នក 👇',
                  reply_markup: { keyboard: [[{ text: '📱 ចែករំលែកលេខទូរស័ព្ទ', request_contact: true }]], resize_keyboard: true, one_time_keyboard: true } });
                tgStatus(ctx, 'ជំហាន ២៖ ក្នុង Telegram សូមចុច «📱 ចែករំលែកលេខទូរស័ព្ទ»', true);
              }
            } else if (st.stage === 'contact') {
              const u = ups.find(function (u) { const m = u.message; return u.update_id > st.afterId && m && m.chat && m.chat.id === st.chatId && m.contact; });
              if (u && tgState[ctx] === st) {
                const c = u.message.contact;
                const own = c.user_id === st.fromId && (!u.message.forward_date);
                const got = normPhone(c.phone_number);
                if (!own) {
                  tgStatus(ctx, 'សូមចែករំលែកលេខទូរស័ព្ទរបស់អ្នកផ្ទាល់ (មិនមែនលេខអ្នកផ្សេង)', false);
                  st.afterId = u.update_id;
                } else if (!samePhone(got, st.phone)) {
                  clearInterval(st.timer);
                  tgStatus(ctx, 'លេខទូរស័ព្ទក្នុង Telegram មិនត្រូវនឹងលេខដែលបានបញ្ចូលទេ សូមពិនិត្យលេខ រួចចុចប៊ូតុងម្ដងទៀត', false);
                  try { await tgApi('sendMessage', { chat_id: st.chatId, text: '❌ លេខទូរស័ព្ទមិនត្រូវគ្នា', reply_markup: { remove_keyboard: true } }); } catch (e) {}
                  tgState[ctx] = null; if (btn) btn.textContent = TG_LABEL;
                  return;
                } else {
                  clearInterval(st.timer); st.stage = 'done';
                  try { await tgApi('sendMessage', { chat_id: st.chatId, text: '✅ ភ្ជាប់ Telegram ជោគជ័យ! កូដ OTP នឹងត្រូវផ្ញើមកទីនេះ។', reply_markup: { remove_keyboard: true } }); } catch (e) {}
                  if (ctx === 'forgot') {
                    const facc = accounts.find(a => samePhone(a.phone, st.phone));
                    if (facc) {
                      facc.tgChatId = st.chatId; facc.tgName = st.name; saveAccounts();
                      tgStatus(ctx, '✅ បញ្ជាក់ជោគជ័យ — កំពុងផ្ញើកូដ OTP ទៅ Telegram...', true);
                      deliverOtp(facc, $('forgot-msg'), $('forgot-btn'));
                    }
                  }
                  if (ctx === 'link' && currentUser) {
                    currentUser.phone = st.phone; currentUser.tgChatId = st.chatId; currentUser.tgName = st.name;
                    saveAccounts(); updateNav();
                  }
                  if (ctx !== 'forgot') tgStatus(ctx, '✅ បញ្ជាក់លេខទូរស័ព្ទ និងភ្ជាប់ Telegram ជោគជ័យ ' + (st.name || ''), true);
                  if (btn) btn.textContent = '✅ បានភ្ជាប់ — ចុចដើម្បីភ្ជាប់ម្ដងទៀត';
                  const lnk = $('tg-open-' + ctx); if (lnk) lnk.classList.remove('show');
                }
              }
            }
          } catch (err) {
            clearInterval(st.timer);
            tgStatus(ctx, 'មិនអាចទាក់ទង Telegram bot បានទេ៖ ' + (err && err.message ? err.message : ''), false);
            if (btn) btn.textContent = TG_LABEL;
          } finally { st.busy = false; }
        }
        window.tgOpenLinkScreen = function () {
          if (!currentUser) return window.showAuth('login');
          tgReset('link');
          const lp = $('tglink-phone'); if (lp) lp.value = currentUser.phone || '';
          $('tglink-hint').textContent = currentUser.tgChatId
            ? 'គណនីនេះបានភ្ជាប់ Telegram ' + (currentUser.tgName || '') + ' រួចហើយ។ អ្នកអាចភ្ជាប់គណនី Telegram ផ្សេងបាន។'
            : 'បញ្ចូលលេខទូរស័ព្ទដែលមាន Telegram ហើយភ្ជាប់ ដើម្បីទទួលកូដ OTP នៅពេលភ្លេចពាក្យសម្ងាត់។';
          window.switchScreen('tglink');
        };
        function startResendCooldown() {
          const b = $('otp-resend'); clearInterval(resendTimer);
          const tick = () => {
            const left = Math.ceil((otpState ? otpState.sentAt + RESEND_MS - Date.now() : 0) / 1000);
            if (left > 0) { b.disabled = true; b.textContent = 'ផ្ញើកូដម្ដងទៀត (' + left + ')'; }
            else { b.disabled = false; b.textContent = 'ផ្ញើកូដម្ដងទៀត'; clearInterval(resendTimer); }
          };
          tick(); resendTimer = setInterval(tick, 1000);
        }
        async function deliverOtp(acc, msgEl, btn) {
          if (tgOn() && !acc.tgChatId) {
            // First time: prove the phone belongs to this Telegram (START + share contact), then the OTP is sent automatically.
            const bx = $('tg-box-forgot'); if (bx) bx.classList.remove('hidden');
            setMsg(msgEl, '');
            return window.tgStartLink('forgot');
          }
          busy(btn, true);
          try {
            const code = await issueOtp(acc);
            const res = await sendOtpTelegram(acc, code);
            const demo = $('otp-demo');
            if (res.demo) {
              // DEMO MODE: TELEGRAM_CONFIG is empty, so the code is shown on screen instead of being sent.
              if (demo) { demo.textContent = '⚠️ ដំណើរការសាកល្បង (មិនទាន់តភ្ជាប់ Telegram bot)៖ កូដរបស់អ្នកគឺ ' + code; demo.classList.remove('hidden'); }
              $('otp-hint').textContent = 'សូមបញ្ចូលកូដ OTP ៤ ខ្ទង់ (មានសុពលភាព ១០ នាទី)';
            } else {
              if (demo) { demo.classList.add('hidden'); demo.textContent = ''; }
              $('otp-hint').textContent = 'យើងបានផ្ញើកូដ OTP ៤ ខ្ទង់ទៅ Telegram ' + (acc.tgName || 'របស់អ្នក') + ' (មានសុពលភាព ១០ នាទី)';
            }
            document.querySelectorAll('#otp-row input').forEach(i => i.value = '');
            const bxf = $('tg-box-forgot'); if (bxf) bxf.classList.add('hidden');
            window.showAuth('otp'); startResendCooldown();
            const first = document.querySelector('#otp-row input'); if (first) first.focus();
          } catch (err) {
            otpState = null;
            setMsg(msgEl, 'ផ្ញើកូដទៅ Telegram មិនបាន៖ ' + (err && err.message ? err.message : '') + ' (សូមពិនិត្យថាអ្នកបានចុច START ក្នុង bot)');
          }
          finally { busy(btn, false); }
        }
        window.authSendOtp = async function (e) {
          e.preventDefault();
          const msg = $('forgot-msg'); setMsg(msg, '');
          const phone = normPhone($('forgot-phone').value);
          if (!validPhone(phone)) return setMsg(msg, 'លេខទូរស័ព្ទមិនត្រឹមត្រូវ');
          const acc = accounts.find(a => samePhone(a.phone, phone));
          if (!acc) return setMsg(msg, 'រកមិនឃើញលេខទូរស័ព្ទនេះក្នុងប្រព័ន្ធ');
          await deliverOtp(acc, msg, $('forgot-btn'));
        };
        window.authResendOtp = async function () {
          if (!otpState) return window.showAuth('forgot');
          const acc = accounts.find(a => a.id === otpState.accId);
          if (!acc) return window.showAuth('forgot');
          await deliverOtp(acc, $('otp-msg'), $('otp-resend'));
        };
        window.authVerifyOtp = async function (e) {
          e.preventDefault();
          const msg = $('otp-msg'); setMsg(msg, '');
          const code = Array.from(document.querySelectorAll('#otp-row input')).map(i => i.value).join('');
          if (!otpState) return setMsg(msg, 'សូមស្នើកូដថ្មី');
          if (code.length !== 4) return setMsg(msg, 'សូមបញ្ចូលកូដឱ្យគ្រប់ ៤ ខ្ទង់');
          if (Date.now() > otpState.exp) { otpState = null; return setMsg(msg, 'កូដផុតកំណត់ សូមស្នើកូដថ្មី'); }
          if (otpState.tries >= OTP_MAX_TRIES) { otpState = null; return setMsg(msg, 'ព្យាយាមច្រើនដងពេក សូមស្នើកូដថ្មី'); }
          otpState.tries++;
          if ((await quickHash(code + otpState.salt)) !== otpState.hash) {
            return setMsg(msg, 'កូដមិនត្រឹមត្រូវ (នៅសល់ ' + (OTP_MAX_TRIES - otpState.tries) + ' ដង)');
          }
          resetAccId = otpState.accId; otpState = null; clearInterval(resendTimer);
          window.showAuth('reset');
        };
        window.authResetPw = async function (e) {
          e.preventDefault();
          const msg = $('reset-msg'), btn = $('reset-btn'); setMsg(msg, '');
          const pw = $('reset-pw').value, pw2 = $('reset-pw2').value;
          if (!resetAccId) return window.showAuth('forgot');
          if (pw.length < 6) return setMsg(msg, 'ពាក្យសម្ងាត់ត្រូវមានយ៉ាងតិច ៦ តួអក្សរ');
          if (pw !== pw2) return setMsg(msg, 'ពាក្យសម្ងាត់មិនត្រូវគ្នា');
          const acc = accounts.find(a => a.id === resetAccId);
          if (!acc) return window.showAuth('forgot');
          busy(btn, true);
          try {
            const cred = await makeCred(pw);
            const old = { salt: acc.salt, alg: acc.alg, hash: acc.hash };
            acc.salt = cred.salt; acc.alg = cred.alg; acc.hash = cred.hash;
            if (!saveAccounts()) { Object.assign(acc, old); return setMsg(msg, 'រក្សាទុកមិនបាន'); }
            resetAccId = null; $('reset-pw').value = ''; $('reset-pw2').value = '';
            window.showAuth('login');
            setMsg($('login-notice'), '✅ ប្តូរពាក្យសម្ងាត់ជោគជ័យ សូមចូលគណនីដោយពាក្យសម្ងាត់ថ្មី', true);
          } catch (err) { setMsg(msg, 'មានបញ្ហា សូមព្យាយាមម្ដងទៀត'); }
          finally { busy(btn, false); }
        };

        /* ---------- OTP boxes: auto-advance, backspace, paste ---------- */
        (function () {
          const boxes = () => Array.from(document.querySelectorAll('#otp-row input'));
          const row = $('otp-row');
          row.addEventListener('input', ev => {
            const i = boxes().indexOf(ev.target); if (i < 0) return;
            ev.target.value = ev.target.value.replace(/[^0-9]/g, '').slice(-1);
            if (ev.target.value && boxes()[i + 1]) boxes()[i + 1].focus();
          });
          row.addEventListener('keydown', ev => {
            const b = boxes(), i = b.indexOf(ev.target);
            if (ev.key === 'Backspace' && !ev.target.value && b[i - 1]) { b[i - 1].focus(); b[i - 1].value = ''; ev.preventDefault(); }
            if (ev.key === 'ArrowLeft' && b[i - 1]) b[i - 1].focus();
            if (ev.key === 'ArrowRight' && b[i + 1]) b[i + 1].focus();
          });
          row.addEventListener('paste', ev => {
            const d = ((ev.clipboardData || window.clipboardData).getData('text') || '').replace(/[^0-9]/g, '').slice(0, 4);
            if (!d) return; ev.preventDefault();
            boxes().forEach((el, i) => { el.value = d[i] || ''; });
            (boxes()[Math.min(d.length, 3)]).focus();
          });
        })();

        /* ---------- start-up ---------- */
        loadAccounts();
        window.addEventListener('load', function () {
          fillLists();
          let id = null;
          try { id = sessionStorage.getItem(SESSION_KEY) || localStorage.getItem(SESSION_KEY); } catch (e) {}
          const acc = accounts.find(a => a.id === id);
          if (acc) { let rem = false; try { rem = !!localStorage.getItem(SESSION_KEY); } catch (e) {} completeLogin(acc, rem); }
          else updateNav();
        });
      })();
    </script>

    <script id="ios27-theme-controller">
      (function () {
        const saved = localStorage.getItem('khmer-teacher-theme');
        const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        applyTheme(saved || (prefersDark ? 'dark' : 'light'));
      })();
      function applyTheme(theme) {
        const dark = theme === 'dark';
        document.body.classList.toggle('dark-mode', dark);
        const icon = document.getElementById('theme-icon');
        const label = document.getElementById('theme-label');
        const button = document.getElementById('theme-toggle');
        if (icon) icon.textContent = dark ? '☀️' : '🌙';
        if (label) label.textContent = dark ? 'Light' : 'Dark';
        if (button) button.setAttribute('aria-pressed', String(dark));
        try { localStorage.setItem('khmer-teacher-theme', dark ? 'dark' : 'light'); } catch (e) {}
      }
      function toggleTheme() {
        applyTheme(document.body.classList.contains('dark-mode') ? 'light' : 'dark');
      }
    </script>

