/* Khmer lunar calendar (Chhankitek-style mean-motion model) */
const KhmerCalendar = (function () {
  const KH_DIGITS = '០១២៣៤៥៦៧៨៩';
  const WEEKDAYS = ['អាទិត្យ', 'ច័ន្ទ', 'អង្គារ', 'ពុធ', 'ព្រហស្បតិ៍', 'សុក្រ', 'សៅរ៍'];
