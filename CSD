        function sfDigits(t) { return String(t || '').replace(/[០-៩]/g, d => '០១២៣៤៥៦៧៨៩'.indexOf(d)); }
        const SF_MONTHS = [['មករា',1],['កុម្ភៈ',2],['មីនា',3],['មេសា',4],['ឧសភា',5],['មិថុនា',6],['កក្កដា',7],['សីហា',8],['កញ្ញា',9],['តុលា',10],['វិច្ឆិកា',11],['ធ្នូ',12]];
        function sfNormDob(t) {
            let x = sfDigits(t);
            SF_MONTHS.forEach(([n, i]) => { x = x.replace(new RegExp(n.split('').join('\\s*'), 'g'), ' ' + i + ' '); });
            const p = x.match(/\d+/g);
