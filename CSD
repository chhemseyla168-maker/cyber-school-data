        // ---- Voice parsing: subject keywords -> input fields ----
        const VOICE_SUBJECTS = [
            { key: 'khmer_listen', input: 'inp-kl',     label: 'ខ្មែរ-ស្តាប់',  words: ['ភាសាខ្មែរស្តាប់', 'ស្តាប់', 'listen'] },
