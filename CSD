-- ==============================================================================
-- CSD CYBER SCHOOL DATA - SUPABASE DATABASE SCHEMA
-- ប្រព័ន្ធមូលដ្ឋានទិន្នន័យ SUPABASE សម្រាប់ CSD SMART TEACHER (HYBRID OFFLINE-FIRST)
-- ==============================================================================
-- ការណែនាំ៖
-- ១. បង្កើតគម្រោងថ្មី (New Project) ដោយឥតគិតថ្លៃនៅ https://supabase.com
-- ២. ចូលទៅកាន់ម៉ឺនុយ "SQL Editor" នៅខាងឆ្វេងដៃ
-- ៣. ចម្លង (Copy) កូដ SQL ខាងក្រោមនេះទាំងអស់ រួចចុច "Run"
-- ==============================================================================

-- ១. បង្កើតតារាងគណនីគ្រូបង្រៀន (csd_accounts)
CREATE TABLE IF NOT EXISTS public.csd_accounts (
    id TEXT PRIMARY KEY,
    username TEXT NOT NULL,
    phone TEXT,
    salt TEXT,
    alg TEXT DEFAULT 'pbkdf2',
    hash TEXT,
    teacher_id TEXT,
    is_new_account BOOLEAN DEFAULT false,
    has_seen_welcome_ad BOOLEAN DEFAULT false,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- ២. បង្កើតតារាងព័ត៌មានគ្រូ (csd_teachers)
CREATE TABLE IF NOT EXISTS public.csd_teachers (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    sex TEXT DEFAULT 'M',
    school TEXT,
    class_name TEXT,
    place TEXT,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- ៣. បង្កើតតារាងទិន្នន័យសិស្ស និងពិន្ទុ (csd_teacher_data)
-- រក្សាទុកបញ្ជីឈ្មោះសិស្ស (students), ពិន្ទុប្រចាំខែ (gradesData), និងពិន្ទុឆមាស (semesterExamData)
CREATE TABLE IF NOT EXISTS public.csd_teacher_data (
    teacher_id TEXT PRIMARY KEY,
    students JSONB DEFAULT '[]'::jsonb,
    grades_data JSONB DEFAULT '{}'::jsonb,
    semester_data JSONB DEFAULT '{"1":{},"2":{}}'::jsonb,
    version INT DEFAULT 1,
    saved_at BIGINT,
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- ៤. បង្កើតតារាងអាជ្ញាប័ណ្ណ Pro License (csd_licenses)
CREATE TABLE IF NOT EXISTS public.csd_licenses (
    key TEXT PRIMARY KEY,
    user_name TEXT,
    school TEXT,
    plan TEXT DEFAULT 'yearly',
    is_trial BOOLEAN DEFAULT false,
    disabled BOOLEAN DEFAULT false,
    activated_at TIMESTAMPTZ DEFAULT NOW(),
    last_verified BIGINT DEFAULT 0,
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- ==============================================================================
-- បើកសិទ្ធិ ROW LEVEL SECURITY (RLS) & HARDENED DEFENSIVE ACCESS POLICIES
-- ==============================================================================

ALTER TABLE public.csd_accounts ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.csd_teachers ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.csd_teacher_data ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.csd_licenses ENABLE ROW LEVEL SECURITY;

-- ១. សុវត្ថិភាព csd_accounts (ការពារការលុប ឬជ្រៀតជ្រែកដោយគ្មាន ID ត្រឹមត្រូវ)
DROP POLICY IF EXISTS "Anon public access to csd_accounts" ON public.csd_accounts;
DROP POLICY IF EXISTS "Accounts read/write by id" ON public.csd_accounts;
CREATE POLICY "Accounts read/write by id" ON public.csd_accounts
    FOR ALL USING (id IS NOT NULL AND length(id) > 0)
    WITH CHECK (id IS NOT NULL AND length(id) > 0);

-- ២. សុវត្ថិភាព csd_teachers
DROP POLICY IF EXISTS "Anon public access to csd_teachers" ON public.csd_teachers;
DROP POLICY IF EXISTS "Teachers read/write by id" ON public.csd_teachers;
CREATE POLICY "Teachers read/write by id" ON public.csd_teachers
    FOR ALL USING (id IS NOT NULL AND length(id) > 0)
    WITH CHECK (id IS NOT NULL AND length(id) > 0);

-- ៣. សុវត្ថិភាព csd_teacher_data (ទិន្នន័យពិន្ទុសិស្សការពារការលុបទូទៅ)
DROP POLICY IF EXISTS "Anon public access to csd_teacher_data" ON public.csd_teacher_data;
DROP POLICY IF EXISTS "Teacher data read/write by teacher_id" ON public.csd_teacher_data;
CREATE POLICY "Teacher data read/write by teacher_id" ON public.csd_teacher_data
    FOR ALL USING (teacher_id IS NOT NULL AND length(teacher_id) > 0)
    WITH CHECK (teacher_id IS NOT NULL AND length(teacher_id) > 0);

-- ៤. សុវត្ថិភាព csd_licenses (ការពារ Attacker បង្កើត Pro Key ដោយឥតគិតថ្លៃ ឬលុប Key)
-- Anon User មានសិទ្ធិត្រឹមតែ SELECT (អានផ្ទៀងផ្ទាត់ Key) ប៉ុណ្ណោះ គ្មានសិទ្ធិ INSERT/UPDATE/DELETE ឡើយ!
DROP POLICY IF EXISTS "Anon public access to csd_licenses" ON public.csd_licenses;
DROP POLICY IF EXISTS "Anon can only read licenses" ON public.csd_licenses;
CREATE POLICY "Anon can only read licenses" ON public.csd_licenses
    FOR SELECT USING (true);

-- ជូនដំណឹងជោគជ័យ
COMMENT ON TABLE public.csd_teacher_data IS 'CSD Teacher Students and Score Cloud Database (Hardened Security)';

