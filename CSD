        function sfNew(noFocus) { sfCurrentId = null; renderStudentForm(); if (!noFocus) sfEl('lastname').focus(); }

        function sfSave() {
            const v = {};
            SF_FIELDS.forEach(k => v[k] = sfEl(k).value.trim());
            if (!v.lastname || !v.firstname) { alert('សូមបញ្ចូលគោត្តនាម និងនាមសិស្ស'); return false; }
            if (v.dob) {
                const n = sfNormDob(v.dob);
                if (!n) { alert('ថ្ងៃ-ខែ-ឆ្នាំកំណើតមិនត្រឹមត្រូវ (ឧទាហរណ៍ 19.09.2016)'); return false; }
                v.dob = n;
            }
            v.status = v.status || 'ថ្មី';
            let s = students.find(x => x.id === sfCurrentId);
            if (s) {
                Object.assign(s, v);
            } else {
                const newId = students.length ? Math.max(...students.map(x => x.id)) + 1 : 1;
                s = Object.assign({ id: newId }, v);
                students.push(s);
                monthsList.forEach(m => {
                    gradesData[m.id] = gradesData[m.id] || {};
                    gradesData[m.id][newId] = { khmer_listen: 7, khmer_write: 7, khmer_read: 7, khmer_speak: 7, math: 8, science: 7, social: 7, hygiene: 8, health: 8, home_art: 8, pe: 8 };
                });
                [1, 2].forEach(n => {
                    semesterExamData[n] = semesterExamData[n] || {};
                    semesterExamData[n][newId] = { khmer_listen: 7, khmer_write: 7, khmer_read: 7, khmer_speak: 7, math: 8, science: 7, social: 7 };
                });
                sfCurrentId = newId;
            }
            if (typeof persistAll === 'function') persistAll();
            renderRosterTable();
