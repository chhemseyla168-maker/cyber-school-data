        async function createUserAccount(e) {
            e.preventDefault();
            try {
                const username = (document.getElementById('add-username').value || '').trim();
                const role = document.getElementById('add-role').value;
                const rawPhone = (document.getElementById('add-phone').value || '').trim();
                const normalizedPhone = normPhone(rawPhone);
                const password = (document.getElementById('add-password').value || '').trim();
                const teacherName = (document.getElementById('add-teacher-name').value || '').trim();
                const teacherSex = document.getElementById('add-teacher-sex').value;
                const schoolName = (document.getElementById('add-school').value || '').trim();
                const className = (document.getElementById('add-class').value || '').trim() || 'ថ្នាក់ទី ៤ "ក"';

                if (!username) throw new Error('សូមបញ្ចូល Username');
                if (!normalizedPhone) throw new Error('សូមបញ្ចូលលេខទូរស័ព្ទ');
                if (!password || password.length < 6) throw new Error('លេខសម្ងាត់ត្រូវមានយ៉ាងតិច ៦ ខ្ទង់');

                // Duplicate Check
                if (accounts.some(a => (a.username || '').toLowerCase() === username.toLowerCase())) {
                    throw new Error(`ឈ្មោះ @${username} ត្រូវបានប្រើរួចហើយ`);
                }
                if (accounts.some(a => normPhone(a.phone) === normalizedPhone)) {
                    throw new Error(`លេខទូរស័ព្ទ ${rawPhone} ត្រូវបានប្រើរួចហើយ`);
                }

                const cred = await makeCred(password);
                const newTeacherId = 't' + Date.now();
                const newAccId = 'a' + Date.now();

                // Create teacher profile
                const newTeacher = {
                    id: newTeacherId,
                    name: teacherName || username,
                    sex: teacherSex,
                    school: schoolName,
                    className: className
                };
                teachers.push(newTeacher);

                // Create account
                const newAcc = {
                    id: newAccId,
                    username: username,
                    phone: normalizedPhone,
                    salt: cred.salt,
                    alg: cred.alg,
                    hash: cred.hash,
                    teacherId: newTeacherId,
                    role: role,
                    isAdmin: (role === 'admin'),
                    isNewAccount: true,
                    hasSeenWelcomeAd: false
                };
                accounts.push(newAcc);

                if (className && !extraClasses.includes(className)) {
                    extraClasses.push(className);
                }

                saveData();

                // Sync to Cloud
                if (typeof window.csdSyncAccountToCloud === 'function') {
                    await window.csdSyncAccountToCloud(newAcc);
                }

                closeAddModal();
                loadData();
                showToast(`🎉 បានបង្កើតគណនី @${username} (${role === 'admin' ? '🛡️ Admin' : '👤 User'}) ជោគជ័យ!`, 'success');

            } catch (err) {
                showToast(err.message, 'error');
            }
        }

        // -------------------------------------------------------------------------
        // DELETE USER ACCOUNT
        // -------------------------------------------------------------------------
        async function deleteUserAccount(accId) {
            const acc = accounts.find(a => a.id === accId);
            if (!acc) return;

            const conf = confirm(`តើអ្នកពិតជាចង់លុបគណនី @${acc.username} (${displayPhone(acc.phone)}) មែនឬទេ?\n\nការលុបនេះនឹងមិនអាចយកវិញបានឡើយ!`);
            if (!conf) return;

            accounts = accounts.filter(a => a.id !== accId);

            if (typeof window.getSupabaseClient === 'function') {
                const client = window.getSupabaseClient();
                if (client) {
                    try {
                        await client.from('csd_accounts').delete().eq('id', accId);
                    } catch (e) {
                        console.error('Supabase delete error:', e);
                    }
                }
            }

            saveData();
            loadData();
            showToast(`🗑️ បានលុបគណនី @${acc.username} រួចរាល់`, 'info');
        }

        // -------------------------------------------------------------------------
        // CLOUD SYNC & EXPORT
        // -------------------------------------------------------------------------
        async function syncWithCloud() {
            showToast('⏳ កំពុង Sync ទិន្នន័យជាមួយ Supabase Cloud...', 'info');
            try {
                if (typeof window.getSupabaseClient === 'function') {
                    const client = window.getSupabaseClient();
                    if (!client) {
                        throw new Error('Supabase មិនទាន់បានកំណត់ (Config)');
                    }

                    const { data: cloudAccounts, error: accErr } = await client.from('csd_accounts').select('*');
                    if (accErr) throw accErr;

                    const { data: cloudTeachers, error: tErr } = await client.from('csd_teachers').select('*');
                    if (tErr) throw tErr;

                    if (cloudAccounts && Array.isArray(cloudAccounts)) {
                        cloudAccounts.forEach(ca => {
                            const idx = accounts.findIndex(a => a.id === ca.id);
                            const formatted = {
                                id: ca.id,
                                username: ca.username,
                                phone: ca.phone,
                                salt: ca.salt,
                                alg: ca.alg || 'pbkdf2',
                                hash: ca.hash,
                                teacherId: ca.teacher_id,
                                role: ca.role || 'user',
                                isAdmin: (ca.role === 'admin' || !!ca.is_admin),
                                isNewAccount: !!ca.is_new_account,
                                hasSeenWelcomeAd: !!ca.has_seen_welcome_ad
                            };
                            if (idx >= 0) accounts[idx] = { ...accounts[idx], ...formatted };
                            else accounts.push(formatted);
                        });
                    }

                    if (cloudTeachers && Array.isArray(cloudTeachers)) {
                        cloudTeachers.forEach(ct => {
                            const idx = teachers.findIndex(t => t.id === ct.id);
                            const formatted = {
                                id: ct.id,
                                name: ct.name,
                                sex: ct.sex || 'M',
                                school: ct.school || '',
                                className: ct.class_name || '',
                                place: ct.place || ''
                            };
                            if (idx >= 0) teachers[idx] = formatted;
                            else teachers.push(formatted);
                        });
                    }

                    saveData();
                    loadData();
                    showToast('✅ Sync ជាមួយ Supabase Cloud ជោគជ័យ!', 'success');
                    return;
                }
                throw new Error('Supabase client មិនទាន់ស្រេចបាច់');
            } catch (e) {
                showToast(e.message || 'Sync មិនបានជោគជ័យ', 'error');
            }
        }

        function exportDataBackup() {
            const data = {
                exportedAt: new Date().toISOString(),
                accounts: accounts,
                teachers: teachers,
                classes: extraClasses
            };
            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `user_accounts_backup_${Date.now()}.json`;
            a.click();
            URL.revokeObjectURL(url);
            showToast('💾 បានទាញយកឯកសារ Backup ដោយជោគជ័យ', 'success');
        }

        // -------------------------------------------------------------------------
        // THEME & UTILITIES
        // -------------------------------------------------------------------------
        function toggleTheme() {
            const isDark = document.body.classList.contains('dark-mode');
            if (isDark) {
                document.body.classList.remove('dark-mode');
                document.documentElement.classList.remove('dark');
                localStorage.setItem(THEME_KEY, 'light');
                document.getElementById('theme-icon').innerText = '☀️';
            } else {
                document.body.classList.add('dark-mode');
                document.documentElement.classList.add('dark');
                localStorage.setItem(THEME_KEY, 'dark');
                document.getElementById('theme-icon').innerText = '🌙';
            }
        }

        function initTheme() {
            const saved = localStorage.getItem(THEME_KEY);
            if (saved === 'light') {
                document.body.classList.remove('dark-mode');
                document.documentElement.classList.remove('dark');
                document.getElementById('theme-icon').innerText = '☀️';
            } else {
                document.body.classList.add('dark-mode');
                document.documentElement.classList.add('dark');
                document.getElementById('theme-icon').innerText = '🌙';
            }
        }

        function togglePasswordVisibility(inputId, btn) {
            const inp = document.getElementById(inputId);
            if (!inp) return;
            if (inp.type === 'password') {
                inp.type = 'text';
                btn.innerText = '🙈';
            } else {
                inp.type = 'password';
                btn.innerText = '👁️';
            }
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            let bg = 'bg-slate-900/90 text-white border-slate-700';
            let icon = 'ℹ️';
            if (type === 'success') {
                bg = 'bg-emerald-950/90 text-emerald-200 border-emerald-500/40';
                icon = '✅';
            } else if (type === 'error') {
                bg = 'bg-rose-950/90 text-rose-200 border-rose-500/40';
                icon = '⚠️';
            }

            toast.className = `toast pointer-events-auto p-3.5 rounded-2xl border backdrop-blur-xl shadow-xl flex items-center gap-2.5 text-xs sm:text-sm font-medium ${bg} khmer-font`;
            toast.innerHTML = `<span>${icon}</span><span class="flex-grow">${message}</span>`;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(1rem)';
                toast.style.transition = 'all 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        // Initialize on load
        window.addEventListener('DOMContentLoaded', async () => {
            initTheme();
            loadData();
            await getOrInitAdminAuth();
            checkAdminSession();
        });
    </script>
</body>
</html>

