                }
                const sfMain = document.getElementById('sf-main-mic');
                if (sfMain) {
                    sfMain.title = isPro ? 'ចុចដើម្បីនិយាយបញ្ចូលស្វ័យប្រវត្តិ' : '🔒 មុខងារ AI Voice សម្រាប់កញ្ចប់ Pro VIP (ចុចដើម្បីដំឡើង)';
                }

