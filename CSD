                        <td class="p-2 border-r font-bold bg-slate-100 text-indigo-900">${it.total.toFixed(2)}</td>
                        <td class="p-2 border-r font-bold bg-slate-100 text-emerald-700">${it.avg.toFixed(2)}</td>
                        <td class="p-2 border-r font-bold bg-indigo-50 text-indigo-800">${it.rank}</td>
                    </tr>`;
                }).join('');
            });
        }

        function updateExamScore(sem, studentId, key, val) {
            if (!semesterExamData[sem]) semesterExamData[sem] = {};
            const cur = Object.assign({}, getExam(sem, studentId), semesterExamData[sem][studentId] || {});
