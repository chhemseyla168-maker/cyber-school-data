        // Semantic Prompt Parser
        function analyzeTeacherPrompt(prompt, selectedSubject, selectedGrade) {
            const p = (prompt || '').toLowerCase();
            
            // Extract custom quoted words «...» or “...” or "..."
            const quotedMatches = [];
            const rx = /[«“"]([^»”"]+)[»”"]/g;
            let m;
            while ((m = rx.exec(prompt)) !== null) {
                const word = m[1].trim();
                if (word && !quotedMatches.includes(word)) {
                    quotedMatches.push(word);
                }
            }

            // Question Count (safely avoids colliding with grade numbers like ថ្នាក់ទី៥)
            const countSelect = document.getElementById('cfg-count');
            let qCount = countSelect ? parseInt(countSelect.value, 10) : 8;
            
            const qCountMatch = p.match(/(?:ចំនួន|មាន)?\s*([១-៩1-9]|១០|10)\s*(?:សំណួរ|លំហាត់|items?|questions?)/i) || p.match(/ចំនួន\s*([១-៩1-9]|១០|10)/i);
            if (qCountMatch) {
                const rawNum = qCountMatch[1];
                if (rawNum === '១០' || rawNum === '10' || rawNum === 'ដប់') qCount = 10;
                else if (rawNum === '៥' || rawNum === '5' || rawNum === 'ប្រាំ') qCount = 5;
            } else if (p.includes('10 សំណួរ') || p.includes('១០ សំណួរ') || p.includes('10 questions')) {
                qCount = 10;
            } else if (p.includes('5 សំណួរ') || p.includes('៥ សំណួរ') || p.includes('5 questions')) {
                qCount = 5;
            }

            // Grade
            let grade = selectedGrade;
            const gradeMatch = prompt.match(/ថ្នាក់ទី\s*([១-៩1-9]+)|grade\s*([1-9]+)/i);
            if (gradeMatch) {
                const gNum = gradeMatch[1] || gradeMatch[2];
                grade = `ថ្នាក់ទី ${gNum}`;
            }

            let topicKey = null;
            let detectedSubject = selectedSubject;

            if (p.includes('ប្រភាគ') || p.includes('ភាគយក') || p.includes('ភាគបែង') || p.includes('fraction')) {
                topicKey = 'math_fractions';
                detectedSubject = 'គណិតវិទ្យា';
            } else if (p.includes('ធរណីមាត្រ') || p.includes('ក្រឡាផ្ទៃ') || p.includes('បរិមាត្រ') || p.includes('ការ៉េ') || p.includes('ចតុកោណ') || p.includes('មុំ') || p.includes('ត្រីកោណ') || p.includes('geometry') || p.includes('area') || p.includes('perimeter')) {
                topicKey = 'math_geometry';
                detectedSubject = 'គណិតវិទ្យា';
            } else if (p.includes('គុណ') || p.includes('ចែក') || p.includes('មេលេខ') || p.includes('multiply') || p.includes('division')) {
                topicKey = 'math_mul_div';
                detectedSubject = 'គណិតវិទ្យា';
            } else if (p.includes('រង្វាស់') || p.includes('ប្រវែង') || p.includes('គីឡូ') || p.includes('ម៉ែត្រ') || p.includes('លីត្រ') || p.includes('measurement')) {
                topicKey = 'math_measurement';
                detectedSubject = 'គណិតវិទ្យា';
            } else if (p.includes('បូក') || p.includes('ដក') || p.includes('ផលបូក') || p.includes('ផលដក') || p.includes('addition') || p.includes('subtraction')) {
                topicKey = 'math_add_sub';
                detectedSubject = 'គណិតវិទ្យា';
            } else if (p.includes('ពាក្យផ្ទុយ') || p.includes('ផ្ទុយ') || p.includes('antonym') || p.includes('opposite')) {
                topicKey = 'khmer_antonyms';
                detectedSubject = 'ភាសាខ្មែរ';
            } else if (p.includes('ន័យដូច') || p.includes('ពាក្យដូច') || p.includes('synonym')) {
                topicKey = 'khmer_synonyms';
                detectedSubject = 'ភាសាខ្មែរ';
            } else if (p.includes('តែងល្បះ') || p.includes('បង្កើតល្បះ') || p.includes('រៀបល្បះ') || p.includes('កថាខណ្ឌ') || quotedMatches.length > 0) {
                topicKey = 'khmer_sentence';
                detectedSubject = 'ភាសាខ្មែរ';
            } else if (p.includes('វេយ្យាករណ៍') || p.includes('នាម') || p.includes('កិរិយា') || p.includes('គុណនាម') || p.includes('grammar')) {
                topicKey = 'khmer_grammar';
                detectedSubject = 'ភាសាខ្មែរ';
            } else if (p.includes('រុក្ខជាតិ') || p.includes('ស្លឹក') || p.includes('ឫស') || p.includes('ផ្កា') || p.includes('plant')) {
                topicKey = 'sci_plants';
                detectedSubject = 'វិទ្យាសាស្ត្រ';
            } else if (p.includes('បរិស្ថាន') || p.includes('សំរាម') || p.includes('កាកសំណល់') || p.includes('ទឹកស្អាត') || p.includes('environment')) {
                topicKey = 'sci_environment';
                detectedSubject = 'វិទ្យាសាស្ត្រ';
            } else if (p.includes('ចរាចរណ៍') || p.includes('មួកសុវត្ថិភាព') || p.includes('ផ្លូវគោក') || p.includes('traffic')) {
                topicKey = 'soc_traffic';
                detectedSubject = 'សិក្សាសង្គម';
            } else if (p.includes('past') || p.includes('yesterday') || p.includes('ago') || p.includes('irregular')) {
                topicKey = 'eng_past';
                detectedSubject = 'ភាសាអង់គ្លេស';
            } else if (p.includes('គណិត') || p.includes('math')) {
                detectedSubject = 'គណិតវិទ្យា';
            } else if (p.includes('ខ្មែរ') || p.includes('khmer')) {
                detectedSubject = 'ភាសាខ្មែរ';
            } else if (p.includes('វិទ្យាសាស្ត្រ') || p.includes('science')) {
                detectedSubject = 'វិទ្យាសាស្ត្រ';
            } else if (p.includes('សង្គម') || p.includes('social')) {
                detectedSubject = 'សិក្សាសង្គម';
            } else if (p.includes('english') || p.includes('verb')) {
                detectedSubject = 'ភាសាអង់គ្លេស';
            }

            return {
                topicKey,
                detectedSubject,
                quotedMatches,
                qCount,
                grade
            };
        }

