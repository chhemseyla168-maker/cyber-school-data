        // KHQR 5-minute countdown timer
        function startKHQRCountdown(seconds) {
            let remain = seconds;
            const timerEl = document.getElementById('khqr-countdown');
            const interval = setInterval(() => {
                remain--;
                if (remain <= 0) {
                    clearInterval(interval);
                    timerEl.textContent = '00:00';
                    showToast('QR Code ផុតកំណត់។ សូម refresh ដើម្បីទទួល QR ថ្មី', 'warning');
                    return;
                }
                const m = Math.floor(remain / 60).toString().padStart(2, '0');
                const s = (remain % 60).toString().padStart(2, '0');
                timerEl.textContent = `${m}:${s}`;
            }, 1000);
        }

