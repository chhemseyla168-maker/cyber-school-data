<!DOCTYPE html>
<html lang="km">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>កិច្ចតែងការបង្រៀន</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Battambang:wght@400;700&family=Kantumruy+Pro:ital,wght@0,300..700;1,300..700&family=Moul&family=Noto+Sans+Khmer:wght@400;600;700&family=Noto+Serif+Khmer:wght@400;700&display=swap" rel="stylesheet">
<style>
:root {
  --ink: #1e1b4b;
  --paper: #ffffff;
  --bg: #f4f6fb;
  --card: #ffffff;
  --line: rgba(148, 163, 184, 0.28);
  --mark: #f59e0b;
  --text: #1e293b;
  --muted: #64748b;
  --accent: #4f46e5;
  --accent-light: #e0e7ff;
  --sheet-bg: #ffffff;
  --sheet-text: #000000;
  --sheet-border: #cbd5e1;
  --sheet-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
}

body.dark-mode {
  --ink: #818cf8;
  --paper: #161e31;
  --bg: #0b1020;
  --card: #151d30;
  --line: rgba(148, 163, 184, 0.16);
  --mark: #fbbf24;
  --text: #f1f5f9;
  --muted: #94a3b8;
  --accent: #6366f1;
  --accent-light: rgba(99, 102, 241, 0.2);
  --sheet-bg: #ffffff;
  --sheet-text: #000000;
  --sheet-border: #475569;
  --sheet-shadow: 0 14px 45px rgba(0, 0, 0, 0.55);
  background: radial-gradient(ellipse at 10% 0%, rgba(79, 70, 229, 0.18), transparent 38%),
              radial-gradient(ellipse at 100% 10%, rgba(14, 165, 233, 0.12), transparent 32%),
              #0b1020 !important;
  color: #f1f5f9 !important;
}

* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font: 14.5px/1.7 "Kantumruy Pro", "Inter", "Noto Sans Khmer", system-ui, sans-serif;
  transition: background 0.25s ease, color 0.25s ease;
  min-height: 100vh;
}

/* Glassmorphic Top Bar */
.top {
  display: flex;
  gap: 12px;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  padding: 12px 22px;
  background: rgba(30, 27, 75, 0.94) !important;
  backdrop-filter: blur(20px) saturate(160%);
  -webkit-backdrop-filter: blur(20px) saturate(160%);
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  color: #fff;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
}
.top h1 { font-size: 17px; margin: 0; font-weight: 700; }
.top button, .btn {
  font: inherit;
  border: 0;
  border-radius: 9999px;
  padding: 7px 15px;
  cursor: pointer;
  background: var(--mark);
  color: #1b2433;
  font-weight: 600;
  transition: all 0.2s;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12.5px;
}
.top button:hover, .btn:hover {
  filter: brightness(1.08);
  transform: translateY(-1px);
}
.btn.alt {
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.25);
  color: #fff;
}
body.dark-mode .btn.alt {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.18);
  color: #f1f5f9;
}

/* Main Layout Grid */
.wrap {
  display: grid;
  grid-template-columns: minmax(340px, 490px) 1fr;
  gap: 22px;
  padding: 22px;
  max-width: 1700px;
  margin: 0 auto;
  align-items: start;
}
@media (max-width: 960px) {
  .wrap { grid-template-columns: 1fr; padding: 14px; gap: 16px; }
}

/* Control Panel */
.panel {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 18px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
}
body.dark-mode .panel {
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
  background: #131a2b;
}

.panel h2 {
  font-size: 15px;
  margin: 18px 0 10px;
  color: var(--ink);
  font-weight: 700;
  border-bottom: 2px solid var(--accent);
  padding-bottom: 5px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.panel h2:first-child { margin-top: 0; }

label {
  display: block;
  font-size: 12.5px;
  color: var(--muted);
  margin: 9px 0 4px;
  font-weight: 600;
}
input, textarea, select {
  width: 100%;
  font: inherit;
  color: var(--text);
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 9px;
  padding: 7px 11px;
  font-size: 13.5px;
  transition: all 0.2s;
}
body.dark-mode input, body.dark-mode textarea, body.dark-mode select {
  background: #0f1626;
  border-color: #29354d;
  color: #f1f5f9;
}
textarea { resize: vertical; min-height: 64px; }
input:focus, textarea:focus, select:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.18);
}
.row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.hint { font-size: 11.5px; color: var(--muted); line-height: 1.45; }

/* Login Box */
#login {
  background: var(--paper);
  border: 1px dashed var(--line);
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 14px;
}
body.dark-mode #login { background: #162035; }

/* Teaching Step Cards */
.step {
  border: 1px solid var(--line);
  border-radius: 11px;
  padding: 12px;
  margin: 10px 0;
  background: var(--paper);
  transition: all 0.2s;
}
body.dark-mode .step { background: #101728; border-color: #243047; }
.step:hover { border-color: var(--accent); }
.step header {
  display: flex;
  gap: 8px;
  align-items: center;
  font-size: 13px;
  margin-bottom: 8px;
}
.step header b {
  color: var(--ink);
  font-weight: 700;
}

/* ==============================================================================
   AI PROMPT ASSISTANT & GRADE CURRICULUM WIDGET
   ============================================================================== */
.ai-prompt-card {
  background: linear-gradient(135deg, rgba(79, 70, 229, 0.08) 0%, rgba(14, 165, 233, 0.08) 100%);
  border: 1.5px solid rgba(79, 70, 229, 0.25);
  border-radius: 14px;
  padding: 14px;
  margin-bottom: 18px;
  position: relative;
}
body.dark-mode .ai-prompt-card {
  background: linear-gradient(135deg, rgba(79, 70, 229, 0.15) 0%, rgba(30, 27, 75, 0.45) 100%);
  border-color: rgba(99, 102, 241, 0.35);
}

.ai-prompt-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}
.ai-prompt-title {
  font-size: 13.5px;
  font-weight: 700;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 6px;
}
body.dark-mode .ai-prompt-title { color: #c7d2fe; }

.ai-engine-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 11.5px;
  background: var(--paper);
  border: 1px solid var(--line);
  padding: 3px 10px;
  border-radius: 9999px;
  cursor: pointer;
  font-weight: 600;
  color: var(--text);
  transition: all 0.2s;
}
.ai-engine-badge:hover {
  border-color: var(--accent);
  transform: translateY(-1px);
}
body.dark-mode .ai-engine-badge {
  background: #1e293b;
  border-color: #334155;
  color: #e2e8f0;
}

.ai-prompt-input-wrap {
  position: relative;
  margin-bottom: 10px;
}
.ai-prompt-textarea {
  width: 100%;
  min-height: 65px;
  padding: 9px 38px 9px 11px;
  border-radius: 10px;
  font-size: 13px;
  line-height: 1.55;
  resize: vertical;
  background: var(--paper);
  color: var(--text);
  border: 1px solid var(--line);
}
body.dark-mode .ai-prompt-textarea {
  background: #0b1020;
  border-color: #313e59;
  color: #f1f5f9;
}
.ai-mic-btn {
  position: absolute;
  right: 7px;
  top: 7px;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 6px;
  font-size: 16px;
  cursor: pointer;
  padding: 4px;
  color: var(--muted);
  transition: all 0.2s;
}
.ai-mic-btn:hover { background: rgba(0, 0, 0, 0.05); color: #ef4444; }
.ai-mic-btn.recording {
  background: #ef4444;
  color: #fff;
  animation: pulseMic 1.2s infinite;
}
@keyframes pulseMic {
  0% { transform: scale(1); }
  50% { transform: scale(1.15); }
  100% { transform: scale(1); }
}

/* Curriculum Units Widget */
.ai-grade-units-box {
  margin-bottom: 12px;
  padding: 12px;
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 13px;
}
body.dark-mode .ai-grade-units-box {
  background: #111728;
  border-color: #26334d;
}
.ai-units-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 8px;
}
.ai-units-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-weight: 700;
  font-size: 12px;
  color: var(--ink);
}
body.dark-mode .ai-units-badge { color: #a5b4fc; }
.pulse-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #10b981;
  display: inline-block;
  box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.3);
}
.ai-units-hint {
  font-size: 10.5px;
  color: var(--muted);
}
.ai-subject-tabs {
  display: flex;
  gap: 5px;
  overflow-x: auto;
  padding-bottom: 4px;
  margin-bottom: 8px;
}
.ai-sub-tab {
  padding: 4px 10px;
  font-size: 11.5px;
  font-weight: 600;
  border-radius: 8px;
  background: var(--card);
  border: 1px solid var(--line);
  color: var(--muted);
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.15s;
}
.ai-sub-tab.active, .ai-sub-tab:hover {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}
body.dark-mode .ai-sub-tab {
  background: #162035;
  border-color: #2b3a56;
  color: #94a3b8;
}
body.dark-mode .ai-sub-tab.active {
  background: #4f46e5;
  color: #fff;
  border-color: #4f46e5;
}

.ai-units-list {
  display: flex;
  flex-direction: column;
  gap: 5px;
  max-height: 220px;
  overflow-y: auto;
  padding-right: 3px;
}
.ai-unit-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 10px;
  border-radius: 9px;
  border: 1px solid var(--line);
  background: var(--card);
  cursor: pointer;
  transition: all 0.18s;
  text-align: left;
}
body.dark-mode .ai-unit-item {
  background: #141b2e;
  border-color: #232e44;
}
.ai-unit-item:hover {
  border-color: var(--mark);
  background: rgba(245, 158, 11, 0.08);
  transform: translateX(3px);
}
.ai-unit-item.active {
  border-color: var(--accent);
  background: var(--accent-light);
}
.ai-unit-no {
  font-size: 11px;
  font-weight: 700;
  padding: 2px 7px;
  border-radius: 6px;
  background: var(--accent-light);
  color: var(--accent);
  white-space: nowrap;
}
body.dark-mode .ai-unit-no {
  background: rgba(99, 102, 241, 0.25);
  color: #c7d2fe;
}
.ai-unit-details {
  flex: 1;
  min-width: 0;
}
.ai-unit-title {
  font-size: 12.5px;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ai-unit-sub {
  font-size: 11px;
  color: var(--muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ai-unit-action {
  font-size: 11px;
  color: var(--accent);
  font-weight: 700;
  white-space: nowrap;
  opacity: 0.85;
}
.ai-unit-item:hover .ai-unit-action {
  opacity: 1;
  color: var(--mark);
}

.ai-generate-btn {
  width: 100%;
  padding: 10px 14px;
  border-radius: 10px;
  background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
  color: #fff;
  font-weight: 700;
  font-size: 13.5px;
  border: 0;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: all 0.2s;
  box-shadow: 0 4px 14px rgba(30, 27, 75, 0.25);
}
.ai-generate-btn:hover {
  filter: brightness(1.12);
  transform: translateY(-1px);
  box-shadow: 0 6px 18px rgba(30, 27, 75, 0.35);
}
body.dark-mode .ai-generate-btn {
  background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
  box-shadow: 0 4px 16px rgba(79, 70, 229, 0.35);
}

.ai-tools-bar {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 5px;
  margin-top: 9px;
}
.ai-tool-btn {
  font-size: 11px;
  padding: 6px 4px;
  border-radius: 7px;
  background: var(--paper);
  border: 1px solid var(--line);
  color: var(--muted);
  cursor: pointer;
  text-align: center;
  transition: all 0.15s;
  white-space: nowrap;
}
body.dark-mode .ai-tool-btn {
  background: #141c2e;
  border-color: #27344d;
  color: #94a3b8;
}
.ai-tool-btn:hover {
  color: var(--ink);
  border-color: var(--ink);
  background: rgba(79, 70, 229, 0.08);
}
body.dark-mode .ai-tool-btn:hover {
  color: #c7d2fe;
  border-color: #6366f1;
}

/* AI Engine Modal */
.ai-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.65);
  backdrop-filter: blur(6px);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
}
.ai-modal-box {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 16px;
  max-width: 480px;
  width: 100%;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
  overflow: hidden;
  animation: modalIn 0.2s ease-out;
}
@keyframes modalIn {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}
.ai-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 18px;
  background: var(--paper);
  border-bottom: 1px solid var(--line);
}
body.dark-mode .ai-modal-header { background: #151d30; }
.ai-modal-header h3 { margin: 0; font-size: 15px; color: var(--ink); }
body.dark-mode .ai-modal-header h3 { color: #c7d2fe; }
.ai-modal-close {
  background: transparent;
  border: 0;
  font-size: 18px;
  cursor: pointer;
  color: var(--muted);
}
.ai-modal-body { padding: 18px; }
.ai-modal-footer {
  padding: 10px 18px;
  background: var(--paper);
  border-top: 1px solid var(--line);
  display: flex;
  justify-content: flex-end;
}
body.dark-mode .ai-modal-footer { background: #151d30; }
.ai-radio-card {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  padding: 11px;
  border-radius: 9px;
  border: 1px solid var(--line);
  background: var(--paper);
  cursor: pointer;
  transition: all 0.15s;
}
body.dark-mode .ai-radio-card { background: #111827; border-color: #2c394f; }
.ai-radio-card:hover { border-color: var(--mark); }

/* ==============================================================================
   DOCUMENT PREVIEW (A4 SHEET) - ALWAYS CRISP WHITE PAPER IN LIGHT & DARK MODE
   ============================================================================== */
.sheet {
  background: var(--sheet-bg) !important;
  color: var(--sheet-text) !important;
  padding: 38px 46px;
  border: 1px solid var(--sheet-border);
  border-radius: 6px;
  font-family: "Noto Serif Khmer", "Noto Sans Khmer", serif;
  font-size: 14.5px;
  line-height: 1.85;
  min-height: 980px;
  box-shadow: var(--sheet-shadow);
  transition: box-shadow 0.25s ease;
}
.sheet * { color: #000000; }
.sheet h3 {
  text-align: center;
  text-decoration: underline;
  font-size: 20px;
  margin: 0 0 10px;
  font-family: "Moul", serif;
  font-weight: 400;
}
.meta { display: grid; grid-template-columns: 150px 1fr; margin-left: 40px; }
.meta b::before { content: "➢ "; font-weight: 400; }
.meta span::before { content: "៖ "; }
.sheet h4 { text-decoration: underline; font-size: 15px; margin: 16px 0 6px; }
.sheet ul { margin: 0; padding-left: 44px; list-style: none; }
.sheet li { display: grid; grid-template-columns: 120px 1fr; }
.sheet li b::before { content: "• "; }
.pre { white-space: pre-wrap; font-family: inherit; }

table { width: 100%; border-collapse: collapse; margin-top: 8px; }
th, td { border: 1px solid #000 !important; padding: 5px 8px; vertical-align: top; text-align: left; }
th { text-align: center; font-weight: 700; background: #fafafa; }
td.c { text-align: center; }

/* Cambodian Official Header (Image 1) */
.lp-header-wrap { margin-bottom: 22px; }
.lp-header-top-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; font-size: 13.5px; line-height: 1.6; }
.lp-header-left { text-align: left; flex: 1; color: #000; font-size: 13.5px; }
.lp-header-right { text-align: right; flex: 1; color: #000; font-size: 13.5px; }
.lp-kingdom-block { text-align: center; margin: 12px 0 16px 0; }
.lp-kingdom-title { font-size: 15.5px; line-height: 1.7; color: #000; letter-spacing: 0.5px; }
.lp-kingdom-motto { font-size: 14.5px; line-height: 1.7; color: #000; letter-spacing: 0.5px; }
.lp-kingdom-ornament { display: flex; align-items: center; justify-content: center; margin-top: 4px; color: #000; }
.sheet-title { text-align: center; text-decoration: underline; font-size: 18px; margin: 18px 0 12px; color: #000; font-family: "Moul", serif; }

/* Cambodian Official Footer (Image 2) */
.lp-footer-wrap {
  margin-top: 36px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  font-size: 13.5px;
  line-height: 1.75;
  page-break-inside: avoid;
  break-inside: avoid;
}
.lp-footer-left { text-align: center; padding-right: 10px; }
.lp-footer-left .lp-sign-check { font-size: 14px; margin: 0; color: #000; }
.lp-footer-left .lp-sign-role { font-size: 14px; margin: 0; color: #000; }
.lp-footer-right { text-align: center; padding-left: 10px; }
.lp-footer-right .lp-lunar-date { font-size: 13px; margin: 0; white-space: nowrap; }
.lp-footer-right .lp-solar-date { font-size: 13px; margin: 0; white-space: nowrap; }
.lp-footer-right .lp-sign-teacher { font-size: 13.5px; margin: 3px 0 0 0; font-weight: 700; }
.lp-sign-space { height: 65px; }
.lp-teacher-name { font-size: 15px; margin: 0; color: #000; }
.empty { color: #999; }

@media print {
  body, body.dark-mode { background: #fff !important; color: #000 !important; }
  .top, .panel, .noprint, #ai-engine-modal { display: none !important; }
  .wrap { display: block; padding: 0; max-width: none; }
  .sheet { border: 0 !important; padding: 0 !important; box-shadow: none !important; min-height: 0 !important; }
  @page { size: A4; margin: 14mm 15mm; }
}

.ai-sem-tab.active {
  background: var(--accent) !important;
  color: #fff !important;
  border-color: var(--accent) !important;
  font-weight: 700;
}
.ai-unit-sem-badge {
  font-size: 9.5px;
  padding: 1px 5px;
  border-radius: 4px;
  background: rgba(148, 163, 184, 0.2);
  color: var(--muted);
  margin-left: 4px;
}


/* AI PRO & TRIAL BADGES */
.pro-badge-pill {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 12px;
  border-radius: 999px;
  font-size: 11.5px;
  font-weight: 700;
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
  color: #1e1b4b;
  box-shadow: 0 2px 10px rgba(245, 158, 11, 0.35);
  letter-spacing: 0.3px;
}
.trial-badge-pill {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 12px;
  border-radius: 999px;
  font-size: 11.5px;
  font-weight: 700;
  background: linear-gradient(135deg, #10b981, #06b6d4);
  color: #ffffff;
  box-shadow: 0 2px 10px rgba(16, 185, 129, 0.35);
}
.locked-badge-pill {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 12px;
  border-radius: 999px;
  font-size: 11.5px;
  font-weight: 700;
  background: rgba(239, 68, 68, 0.15);
  color: #ef4444;
  border: 1px solid rgba(239, 68, 68, 0.3);
  cursor: pointer;
}
